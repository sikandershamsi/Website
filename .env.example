# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas connection string (mongodb+srv://<user>:<password>@<cluster>/<db>?...)
MONGODB_URI=

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Seeds a single admin user on first `npm run seed` run
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
