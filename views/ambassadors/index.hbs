<section class="panel-grey">
  <div class="section">
    {{> section-head heading="Meet Our Animalife Ambassadors" lede="We are honored to partner with an exceptional group of riders, trainers, veterinarians, and equine professionals who share our passion for helping horses live healthier, happier, and more successful lives."}}
    <p class="section-head__lede mx-auto max-w-5xl">Our ambassadors are more than accomplished professionals&mdash;they are trusted educators, practitioners, advocates, and competitors who believe in treating the whole horse through science-backed nutrition and natural wellness. Their experience, dedication, and commitment to excellence help shape the future of Animalife while inspiring horse owners around the world.</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/ambassadors/jenni-mcallister" class="card group overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden bg-al-panel">
          <img src="/images/ambassadors/jenni-mcallister.jpg" alt="Jenni McAllister competing in show jumping" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
        </div>
        <div class="p-5 text-center">
          <p class="font-display text-lg font-medium text-al-navy">Jenni McAllister</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/55">Click to Profile</p>
        </div>
      </a>
      <div class="amb-slot" aria-hidden="true">
        <div class="amb-slot__media">
          <span class="amb-slot__icon">{{{icon "user" "w-8 h-8"}}}</span>
        </div>
        <div class="p-5 text-center">
          <p class="amb-slot__label">New Ambassador</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/40">Coming Soon</p>
        </div>
      </div>
      <div class="amb-slot" aria-hidden="true">
        <div class="amb-slot__media">
          <span class="amb-slot__icon">{{{icon "user" "w-8 h-8"}}}</span>
        </div>
        <div class="p-5 text-center">
          <p class="amb-slot__label">New Ambassador</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/40">Coming Soon</p>
        </div>
      </div>
    </div>
  </div>
</section>

