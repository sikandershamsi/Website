<section class="panel-white">
  <div class="section grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <div class="eyebrow">Animalife Ambassadors</div>
      <h1 class="font-display mt-4 text-4xl font-medium text-al-navy sm:text-5xl">Elite Riders. Extraordinary Partnerships.</h1>
      <p class="mt-5 text-sm leading-relaxed text-al-ink/75">United by passion. Driven by excellence. Our ambassadors represent the best in every discipline.</p>
    </div>
    <div class="overflow-hidden rounded-2xl bg-al-panel">
      <img src="/images/ambassadors/hero-horse.jpg" alt="Animalife ambassador horse behind a paddock fence" class="aspect-[4/3] w-full object-cover object-[center_35%]" />
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="overflow-hidden rounded-2xl">
      <img src="/images/ambassadors/disciplines-grid.jpg" alt="feel the difference — ambassadors across equestrian disciplines" class="w-full object-contain" />
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-7">
      {{#each disciplines}}
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-al-orange/10 text-al-orange">{{{icon "horse" "w-6 h-6"}}}</div>
        <p class="mt-2 text-[11px] font-semibold uppercase tracking-wide text-al-orange">{{this.name}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-white" id="become-ambassador">
  <div class="section grid gap-12 lg:grid-cols-2">
    <div>
      <div class="eyebrow">Become an Ambassador</div>
      <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Ride with purpose. Partner with Animalife.</h2>
      <p class="mt-5 text-sm leading-relaxed text-al-ink/70">If you're a competitive rider, trainer, or equine professional who believes in root-cause, science-backed nutrition, we'd love to hear your story.</p>
      <ul class="mt-8 space-y-3 text-sm text-al-ink/80">
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}Complimentary product &amp; personalized feeding plans</li>
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}Co-marketing &amp; social features across Animalife channels</li>
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}Direct access to our science &amp; nutrition team</li>
      </ul>
    </div>

    <div class="rounded-2xl border border-al-line bg-al-panel p-7 sm:p-8">
      {{#if submitted}}
      <div class="flex h-full flex-col items-center justify-center py-10 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-al-orange/10 text-al-orange">{{{icon "check" "w-7 h-7"}}}</div>
        <p class="font-display mt-5 text-xl font-medium text-al-navy">Thank you, {{submittedName}}!</p>
        <p class="mt-2 text-sm text-al-ink/65">Your ambassador application has been received. Our team will be in touch within 5–10 business days.</p>
      </div>
      {{else}}
      <p class="font-display text-lg font-medium text-al-navy">Ambassador Application</p>
      <form action="/ambassadors/apply" method="post" class="mt-6 space-y-5">
        <div>
          <label class="field-label" for="fullName">Full Name</label>
          <input id="fullName" name="fullName" type="text" required class="input-field" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="field-label" for="email">Email Address</label>
            <input id="email" name="email" type="email" required class="input-field" />
          </div>
          <div>
            <label class="field-label" for="phone">Mobile Phone</label>
            <input id="phone" name="phone" type="tel" class="input-field" />
          </div>
        </div>
        <div>
          <label class="field-label" for="discipline">Primary Discipline</label>
          <select id="discipline" name="discipline" required class="input-field">
            {{#each disciplines}}
            <option value="{{this.slug}}">{{this.name}}</option>
            {{/each}}
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="socialHandle">Instagram / Social Handle</label>
          <input id="socialHandle" name="socialHandle" type="text" class="input-field" placeholder="@yourhandle" />
        </div>
        <div>
          <label class="field-label" for="message">Tell us about you &amp; your horses</label>
          <textarea id="message" name="message" rows="4" required class="input-field"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Submit Application</button>
      </form>
      {{/if}}
    </div>
  </div>
</section>
