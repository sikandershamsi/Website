<section class="inspired-blend amb-hero">
  <div class="inspired-blend__media-wrap">
    <img
      src="/images/ambassadors/hero-horse.jpg"
      alt="Bay horse behind a paddock fence"
      class="inspired-blend__media amb-hero__media"
    />
    <div class="inspired-blend__veil" aria-hidden="true"></div>
  </div>
  <div class="inspired-blend__copy amb-hero__copy">
    <p class="amb-hero__eyebrow">Animalife Ambassadors</p>
    <div class="amb-hero__rule" aria-hidden="true"></div>
    <h1 class="font-display mt-5 text-4xl font-medium leading-tight text-al-navy sm:text-5xl lg:text-[3.25rem]">Elite Riders. Extraordinary Partnerships.</h1>
    <div class="amb-hero__rule" aria-hidden="true"></div>
    <p class="mt-5 max-w-md text-sm leading-relaxed text-al-ink/75 sm:text-base">United by passion. Driven by excellence. Our ambassadors represent the best in every discipline.</p>
  </div>
</section>

<section class="amb-disciplines">
  <div class="amb-disciplines__grid">
    {{#each disciplines}}
    <div class="amb-disciplines__item">
      <div class="amb-disciplines__media">
        <img src="{{this.image}}" alt="{{this.name}}" class="amb-disciplines__img" />
      </div>
      <div class="amb-disciplines__meta">
        <div class="amb-disciplines__icon">{{{icon this.icon "w-7 h-7"}}}</div>
        <p class="amb-disciplines__label">{{this.name}}</p>
      </div>
    </div>
    {{/each}}
  </div>
</section>

<section class="panel-white">
  <div class="section max-w-3xl">
    <div class="eyebrow">Meet Our Animalife Ambassadors</div>
    <p class="mt-5 text-sm leading-relaxed text-al-ink/75">We are honored to partner with an exceptional group of riders, trainers, veterinarians, and equine professionals who share our passion for helping horses live healthier, happier, and more successful lives.</p>
    <p class="mt-5 text-sm leading-relaxed text-al-ink/75">Our ambassadors are more than accomplished professionals&mdash;they are trusted educators, practitioners, advocates, and competitors who believe in treating the whole horse through science-backed nutrition and natural wellness. Their experience, dedication, and commitment to excellence help shape the future of Animalife while inspiring horse owners around the world.</p>
  </div>

  <div class="section !pt-0">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/ambassadors/jenni-mcallister" class="card group overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden bg-al-panel">
          <img src="/images/ambassadors/jenni-mcallister.jpg" alt="Jenni McAllister competing in show jumping" class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
        </div>
        <div class="p-5">
          <p class="font-display text-lg font-medium text-al-navy">Jenni McAllister</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/55">Click to Profile</p>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="panel-white" id="become-ambassador">
  <div class="section grid gap-12 lg:grid-cols-2">
    <div>
      <div class="eyebrow">Become an Ambassador</div>
      <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Ride with purpose. Partner with Animalife.</h2>
      <p class="mt-5 text-sm leading-relaxed text-al-ink/70">If you're a competitive rider, trainer, or equine professional who believes in root-cause, science-backed nutrition, we'd love to hear your story.</p>
      <ul class="mt-8 space-y-3 text-sm text-al-ink/80">
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}Complimentary product &amp; personalized feeding plans</li>
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}Co-marketing &amp; social features across Animalife channels</li>
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}Direct access to our science &amp; nutrition team</li>
      </ul>
    </div>

    <div class="rounded-none border border-al-line bg-al-panel p-7 sm:p-8">
      {{#if submitted}}
      <div class="flex h-full flex-col items-center justify-center py-10 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-none bg-al-navy/10 text-al-navy/55">{{{icon "check" "w-7 h-7"}}}</div>
        <p class="font-display mt-5 text-xl font-medium text-al-navy">Thank you, {{submittedName}}!</p>
        <p class="mt-2 text-sm text-al-ink/65">Your ambassador application has been received. Our team will be in touch within 5–10 business days.</p>
      </div>
      {{else}}
      <p class="font-display text-lg font-medium text-al-navy">Ambassador Application</p>
      <form action="/ambassadors/apply" method="post" class="mt-6 space-y-5">
        <div>
          <label class="field-label" for="fullName">Full Name</label>
          <input id="fullName" name="fullName" type="text" required class="input-field" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="field-label" for="email">Email Address</label>
            <input id="email" name="email" type="email" required class="input-field" />
          </div>
          <div>
            <label class="field-label" for="phone">Mobile Phone</label>
            <input id="phone" name="phone" type="tel" class="input-field" />
          </div>
        </div>
        <div>
          <label class="field-label" for="discipline">Primary Discipline</label>
          <select id="discipline" name="discipline" required class="input-field">
            {{#each disciplines}}
            <option value="{{this.slug}}">{{this.name}}</option>
            {{/each}}
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="socialHandle">Instagram / Social Handle</label>
          <input id="socialHandle" name="socialHandle" type="text" class="input-field" placeholder="@yourhandle" />
        </div>
        <div>
          <label class="field-label" for="message">Tell us about you &amp; your horses</label>
          <textarea id="message" name="message" rows="4" required class="input-field"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Submit Application</button>
      </form>
      {{/if}}
    </div>
  </div>
</section>
