<div class="jenni-profile">
  <section class="bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-12 sm:px-8 lg:grid-cols-2 lg:items-center lg:gap-14 lg:px-10 lg:py-16">
      <div>
        {{> brand-logo class="h-9 w-auto"}}
        <div class="mt-6 h-0.5 w-28 bg-al-orange"></div>
        <h1 class="font-display mt-5 text-[clamp(2.75rem,6vw,4.75rem)] font-bold leading-[0.92] text-al-navy">Jenni<br />McAllister</h1>
        <p class="mt-4 text-sm font-extrabold uppercase tracking-[0.16em] text-al-orange sm:text-base">Animalife USA Ambassador</p>
        <div class="mt-4 h-0.5 w-16 bg-al-orange"></div>
        <p class="mt-6 flex items-center gap-2 text-sm font-bold uppercase tracking-[0.08em] text-al-navy">
          <span aria-hidden="true" class="text-lg">🇺🇸</span> United States
        </p>
        <p class="mt-3 text-sm font-bold uppercase tracking-[0.1em] text-al-navy/70">
          Show Jumping <span class="mx-2 text-al-ink/30">|</span> Training <span class="mx-2 text-al-ink/30">|</span> Coaching
        </p>
      </div>
      <div class="relative">
        <div class="relative aspect-[5/4] overflow-hidden">
          <img
            src="/images/ambassadors/jenni/hero.jpg?v=20260822c"
            srcset="/images/ambassadors/jenni/hero.jpg?v=20260822c 1269w, /images/ambassadors/jenni/hero@2x.jpg?v=20260822c 2538w"
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt="Jenni McAllister competing in show jumping"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="jenni-script pointer-events-none absolute right-4 top-4 text-right text-lg italic leading-[1.15] text-al-navy sm:right-6 sm:top-6 sm:text-xl">
          Horses<br />Perform<br />Better<br />Together
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-al-line bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-al-line sm:grid-cols-4">
      {{#each stats}}
      <div class="flex items-center justify-center gap-3 px-4 py-6 sm:px-6">
        {{{icon this.icon "w-8 h-8 shrink-0 text-al-orange"}}}
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.1em] text-al-ink/50">{{this.label}}</p>
          <p class="font-display mt-0.5 text-lg font-semibold text-al-navy">{{this.value}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-10">
      <h2 class="inline-block border-b-2 border-al-orange pb-3 text-xs font-extrabold uppercase tracking-[0.14em] text-al-navy">Products Jenni Uses</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {{#each featuredProducts}}
        <a href="/shop/product/{{this.slug}}" class="flex items-center gap-4 border border-al-line bg-al-panel/50 p-5 transition-colors hover:border-al-navy/30 hover:bg-al-panel">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center">
            <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-full object-contain" />
          </div>
          <div>
            <p class="font-display text-base font-semibold text-al-navy">{{this.trademark}}</p>
            <p class="mt-0.5 text-xs leading-snug text-al-ink/65">{{this.category}}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wide text-al-orange">Learn More &rarr;</span>
          </div>
        </a>
        {{/each}}
      </div>
    </div>
  </section>

  <section class="border-t border-al-line bg-al-panel/40">
    <div class="mx-auto grid max-w-7xl sm:grid-cols-2">
      <div class="relative overflow-hidden p-8 sm:p-10">
        <img
          src="/images/ambassadors/hero-horse.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 h-full w-1/2 object-cover opacity-80 grayscale [mask-image:linear-gradient(to_left,black_35%,transparent)] sm:w-3/5"
        />
        <div class="relative max-w-xs">
          <h2 class="font-display text-2xl font-bold leading-snug text-al-navy sm:text-[1.7rem]">Jenni&rsquo;s<br />Training Philosophy</h2>
          <div class="mt-3 h-0.5 w-12 bg-al-orange"></div>
          <p class="mt-4 text-sm leading-relaxed text-al-ink/75">
            Every horse is an individual. I believe in thoughtful training, a strong foundation, and a long-term approach to health and performance. When we support the whole horse&mdash;physically and mentally&mdash;they can reach their highest potential.
          </p>
        </div>
      </div>
      <div class="relative overflow-hidden border-t border-al-line p-8 sm:border-l sm:border-t-0 sm:p-10">
        <img
          src="/images/ambassadors/disciplines/eventing.jpg"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 right-0 h-full w-1/2 object-cover opacity-80 [mask-image:linear-gradient(to_left,black_35%,transparent)] sm:w-3/5"
        />
        <div class="relative max-w-xs">
          <h2 class="font-display text-2xl font-bold leading-snug text-al-navy sm:text-[1.7rem]">Jenni&rsquo;s<br />Favorite Horse Movie</h2>
          <div class="mt-3 h-0.5 w-12 bg-al-orange"></div>
          <p class="mt-4 text-sm leading-relaxed text-al-ink/75">
            There&rsquo;s something special about the bond between a horse and a rider. My favorite horse movie is a reminder of the power, heart, and partnership that make our sport so extraordinary.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-10">
      <h2 class="inline-block border-b-2 border-al-orange pb-3 text-xs font-extrabold uppercase tracking-[0.14em] text-al-navy">How Jenni Uses Animalife Products</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
        {{#each usageCards}}
        <div class="relative aspect-[3/4] overflow-hidden">
          <img src="{{this.image}}" alt="" class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent"></div>
          <div class="absolute inset-x-0 top-0 flex justify-center pt-4 text-white">{{{icon this.icon "w-7 h-7"}}}</div>
          <p class="absolute inset-x-0 bottom-9 px-2 text-center text-[11px] font-bold uppercase leading-tight tracking-wide text-white">{{this.label}}</p>
          <div class="absolute inset-x-0 bottom-0 flex justify-center bg-al-orange py-1.5">{{{icon "check" "w-4 h-4 text-white"}}}</div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <section class="border-t border-al-line bg-al-panel/40">
    <div class="mx-auto max-w-7xl px-6 py-8 sm:px-8 lg:px-10">
      <h2 class="inline-block border-b-2 border-al-orange pb-3 text-xs font-extrabold uppercase tracking-[0.14em] text-al-navy">Connect With Jenni</h2>
      <div class="mt-5 flex flex-wrap gap-x-8 gap-y-3 text-sm text-al-navy">
        <a href="mailto:jenni@teammcallister.com" class="flex items-center gap-2 transition-colors hover:text-al-orange">{{{icon "mail" "w-4 h-4 text-al-orange"}}} jenni@teammcallister.com</a>
        <a href="https://jennimcallister.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition-colors hover:text-al-orange">{{{icon "globe" "w-4 h-4 text-al-orange"}}} jennimcallister.com</a>
        <a href="https://www.instagram.com/jennimcallister" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition-colors hover:text-al-orange">{{{icon "instagram" "w-4 h-4 text-al-orange"}}} @jennimcallister</a>
        <a href="https://www.facebook.com/JenniMcAllisterShowJumping" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 transition-colors hover:text-al-orange">{{{icon "facebook" "w-4 h-4 text-al-orange"}}} @JenniMcAllisterShowJumping</a>
      </div>
    </div>
  </section>
</div>
