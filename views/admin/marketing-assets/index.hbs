<div class="wp-heading-inline">
  <h1>Marketing Assets</h1>
</div>
<p class="mb-5 max-w-2xl text-sm" style="color:var(--wp-text-muted);">Manage the images and sample copy shown on the affiliate Marketing Resources page. Images reference an existing path under <code>/public</code> (e.g. <code>/images/products/vetroflex-tub.png</code>); copy can include <code>\{{shopLink}}</code> which is replaced with each affiliate's own link.</p>

<div class="wp-columns">
  <div class="wp-list-table-wrap">
    {{#if assets.length}}
    <table class="wp-list-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Title</th>
          <th>Content</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each assets}}
        <tr>
          <td>{{this.type}}</td>
          <td class="wp-row-title">{{this.title}}</td>
          <td class="max-w-xs truncate">{{this.content}}</td>
          <td>
            <form action="/admin/marketing-assets/{{this._id}}/delete" method="post">
              <button type="submit" class="wp-btn wp-btn-danger wp-btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="wp-list-table-empty">No custom assets yet &mdash; affiliates are seeing the built-in defaults (3 product images + 2 sample copy blocks).</p>
    {{/if}}
  </div>

  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>New Asset</h2></div>
    <div class="wp-postbox__body">
      <form action="/admin/marketing-assets" method="post" class="space-y-3">
        <div>
          <label class="field-label" for="type">Type</label>
          <select id="type" name="type" class="input-field">
            <option value="image">Image</option>
            <option value="copy">Copy</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="title">Title</label>
          <input id="title" name="title" required class="input-field" />
        </div>
        <div>
          <label class="field-label" for="content">Content (image path or copy text)</label>
          <textarea id="content" name="content" rows="4" required class="input-field"></textarea>
        </div>
        <div>
          <label class="field-label" for="order">Display Order</label>
          <input id="order" name="order" type="number" value="0" class="input-field" />
        </div>
        <button type="submit" class="wp-btn wp-btn-primary w-full justify-center">Add Asset</button>
      </form>
    </div>
  </div>
</div>
