<p class="text-xs text-al-ink/50">One row per ingredient. Leave a row's Name blank to remove it.</p>
<div class="mt-4 space-y-4">
  {{#each section.data.items}}
  <div class="grid gap-2 border-b border-al-line pb-4 sm:grid-cols-3">
    <input name="name" value="{{this.name}}" placeholder="Name" class="input-field" />
    <input name="origin" value="{{this.origin}}" placeholder="Origin" class="input-field" />
    <input name="image" value="{{this.image}}" placeholder="Image path" class="input-field" />
  </div>
  {{/each}}
  {{#each (array 1 2)}}
  <div class="grid gap-2 border-b border-al-line pb-4 sm:grid-cols-3">
    <input name="name" placeholder="Name" class="input-field" />
    <input name="origin" placeholder="Origin" class="input-field" />
    <input name="image" placeholder="Image path" class="input-field" />
  </div>
  {{/each}}
</div>
