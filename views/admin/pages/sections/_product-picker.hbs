<p class="text-xs text-al-ink/50">Curated products shown on the homepage. Leave a row's Slug blank to remove it.</p>
<div class="mt-4 space-y-4">
  {{#each section.data.items}}
  <div class="grid gap-2 border-b border-al-line pb-4 sm:grid-cols-6">
    <input name="slug" value="{{this.slug}}" placeholder="Product slug" class="input-field" />
    <input name="trademark" value="{{this.trademark}}" placeholder="Trademark" class="input-field" />
    <input name="category" value="{{this.category}}" placeholder="Category" class="input-field" />
    <input name="tagline" value="{{this.tagline}}" placeholder="Tagline" class="input-field" />
    <input name="price" value="{{this.price}}" type="number" step="0.01" placeholder="Price" class="input-field" />
    <input name="image" value="{{this.image}}" placeholder="Image path" class="input-field" />
  </div>
  {{/each}}
  {{#each (array 1 2)}}
  <div class="grid gap-2 border-b border-al-line pb-4 sm:grid-cols-6">
    <input name="slug" placeholder="Product slug" class="input-field" />
    <input name="trademark" placeholder="Trademark" class="input-field" />
    <input name="category" placeholder="Category" class="input-field" />
    <input name="tagline" placeholder="Tagline" class="input-field" />
    <input name="price" type="number" step="0.01" placeholder="Price" class="input-field" />
    <input name="image" placeholder="Image path" class="input-field" />
  </div>
  {{/each}}
</div>
