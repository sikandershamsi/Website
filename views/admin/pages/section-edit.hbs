<a href="/admin/pages/home" class="wp-btn wp-btn-sm mb-3">&larr; Home Page Sections</a>
<div class="wp-heading-inline">
  <h1>{{title}}</h1>
</div>

<div class="wp-postbox" style="max-width:720px;">
  <div class="wp-postbox__body">
    <form action="/admin/pages/home/sections/{{section.key}}" method="post">
      {{> (lookup . 'partial')}}
      <div class="mt-6 flex items-center gap-2">
        <button type="submit" class="wp-btn wp-btn-primary">Save Section</button>
        <a href="/admin/pages/home" class="wp-btn">Cancel</a>
      </div>
    </form>
  </div>
</div>
