<div class="wp-heading-inline">
  <h1>Home Page</h1>
</div>
<p class="mb-4 text-sm" style="color:var(--wp-text-muted);">Edit the content-driven sections of the homepage below.</p>

<div class="wp-list-table-wrap">
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Section</th>
        <th>Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each sections}}
      <tr>
        <td>
          <a href="/admin/pages/home/sections/{{this.key}}" class="wp-row-title">{{this.key}}</a>
          <div class="wp-row-actions">
            <a href="/admin/pages/home/sections/{{this.key}}">Edit</a>
          </div>
        </td>
        <td>{{this.type}}</td>
        <td></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
