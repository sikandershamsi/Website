<div class="w-full max-w-sm rounded p-8" style="background:#fff;border:1px solid var(--wp-border);">
  <p class="text-center text-lg font-semibold" style="color:var(--wp-text);">Animalife Admin</p>
  {{#if alreadyIn}}
  <p class="mt-6 text-center text-sm" style="color:var(--wp-text-muted);">You're already signed in.</p>
  <a href="/admin" class="wp-btn wp-btn-primary mt-6 w-full justify-center">Go to Dashboard</a>
  {{else}}
  {{#if notice}}
  <div class="wp-notice wp-notice--error mt-6"><p>{{notice}}</p></div>
  {{/if}}
  <form action="/admin/login" method="post" class="mt-6 space-y-4">
    <div>
      <label class="field-label" for="email">Email</label>
      <input id="email" name="email" type="email" required class="input-field" />
    </div>
    <div>
      <label class="field-label" for="password">Password</label>
      <input id="password" name="password" type="password" required class="input-field" />
    </div>
    <button type="submit" class="wp-btn wp-btn-primary w-full justify-center">Sign In</button>
  </form>
  {{/if}}
</div>
