<div class="flex items-center justify-between">
  <h1 class="font-display text-2xl font-medium text-al-navy">Commissions Paid</h1>
  <a href="/admin/affiliates/commissions" class="text-xs font-semibold uppercase tracking-wide text-al-ink/50 hover:text-al-navy">&larr; Back to Commissions</a>
</div>

<div class="mt-6 rounded-none border border-green-300 bg-green-50 p-6 text-sm text-green-900">
  <p class="font-semibold">Payout batch recorded.</p>
  <dl class="mt-3 grid gap-1">
    <p>Orders paid: <span class="font-semibold">{{batch.orderIds.length}}</span></p>
    <p>Affiliates covered: <span class="font-semibold">{{batch.affiliateIds.length}}</span></p>
    <p>Total amount: <span class="font-semibold">{{currency batch.totalAmount}}</span></p>
  </dl>
</div>

<a href="/admin/affiliates/payouts" class="btn-outline mt-6 inline-block !px-4 !py-2 text-xs">View Payout History</a>
