<div class="wp-heading-inline">
  <h1>Commissions Paid</h1>
  <a href="/admin/affiliates/commissions" class="wp-btn wp-btn-sm">&larr; Back to Commissions</a>
</div>

<div class="wp-notice wp-notice--success">
  <div>
    <p style="font-weight:600;">Payout batch recorded.</p>
    <dl class="mt-2 grid gap-1">
      <p>Orders paid: <span style="font-weight:600;">{{batch.orderIds.length}}</span></p>
      <p>Affiliates covered: <span style="font-weight:600;">{{batch.affiliateIds.length}}</span></p>
      <p>Total amount: <span style="font-weight:600;">{{currency batch.totalAmount}}</span></p>
    </dl>
  </div>
</div>

<a href="/admin/affiliates/payouts" class="wp-btn mt-4 inline-flex">View Payout History</a>
