<div class="wp-heading-inline">
  <h1>Bulk Approve</h1>
  <a href="/admin/affiliates?status=pending" class="wp-btn wp-btn-sm">&larr; Back to Affiliates</a>
</div>

{{#if results.length}}
<div class="wp-notice wp-notice--success">
  <p style="font-weight:600;">{{results.length}} affiliate(s) approved &mdash; share these login details now. They won't be shown again.</p>
</div>
<div class="wp-list-table-wrap">
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Temporary Password</th>
        <th>Referral Link</th>
      </tr>
    </thead>
    <tbody>
      {{#each results}}
      <tr>
        <td class="wp-row-title">{{this.fullName}}</td>
        <td>{{this.email}}</td>
        <td class="font-mono">{{this.password}}</td>
        <td class="font-mono text-xs">{{this.referralLink}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<p class="wp-list-table-empty">No affiliates were approved.</p>
{{/if}}
