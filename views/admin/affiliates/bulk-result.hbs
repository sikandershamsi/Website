<div class="flex items-center justify-between">
  <h1 class="font-display text-2xl font-medium text-al-navy">Bulk Approve</h1>
  <a href="/admin/affiliates?status=pending" class="text-xs font-semibold uppercase tracking-wide text-al-ink/50 hover:text-al-navy">&larr; Back to Affiliates</a>
</div>

{{#if results.length}}
<div class="mt-6 rounded-none border border-green-300 bg-green-50 p-5 text-sm text-green-900">
  <p class="font-semibold">{{results.length}} affiliate(s) approved &mdash; share these login details now. They won't be shown again.</p>
</div>
<div class="mt-4 overflow-hidden rounded-none border border-al-line bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-al-panel text-xs font-semibold uppercase tracking-wide text-al-ink/60">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Temporary Password</th>
        <th class="px-4 py-3">Referral Link</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-al-line">
      {{#each results}}
      <tr>
        <td class="px-4 py-3 font-semibold text-al-navy">{{this.fullName}}</td>
        <td class="px-4 py-3 text-al-ink/60">{{this.email}}</td>
        <td class="px-4 py-3 font-mono">{{this.password}}</td>
        <td class="px-4 py-3 font-mono text-xs">{{this.referralLink}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<p class="mt-6 text-sm text-al-ink/60">No affiliates were approved.</p>
{{/if}}
