<div class="wp-heading-inline">
  <h1>Payout History</h1>
  <a href="/admin/affiliates" class="wp-btn wp-btn-sm">&larr; All Affiliates</a>
</div>

<div class="wp-list-table-wrap">
  {{#if batches.length}}
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Method</th>
        <th>Orders</th>
        <th>Affiliates</th>
        <th>Total</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each batches}}
      <tr>
        <td>{{dateShort this.createdAt}}</td>
        <td>{{#if (eq this.method "stripe_connect")}}Stripe Connect{{else}}Manual{{/if}}</td>
        <td>{{this.orderIds.length}}</td>
        <td>{{this.affiliateIds.length}}</td>
        <td class="wp-row-title">{{currency this.totalAmount}}</td>
        <td>
          {{#if (eq this.status "completed")}}<span class="wp-badge wp-badge--success">Completed</span>{{/if}}
          {{#if (eq this.status "partial")}}<span class="wp-badge wp-badge--warning">Partial</span>{{/if}}
          {{#if (eq this.status "failed")}}<span class="wp-badge wp-badge--error">Failed</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="wp-list-table-empty">No payouts have been processed yet.</p>
  {{/if}}
</div>
