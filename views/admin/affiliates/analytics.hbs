<div class="wp-heading-inline">
  <h1>Affiliate Analytics</h1>
  <form method="get" class="flex items-center gap-2">
    <label class="text-[13px]" for="days" style="color:var(--wp-text-muted);">Window</label>
    <select id="days" name="days" onchange="this.form.submit()" class="input-field !w-auto text-sm">
      <option value="30" {{#if (eq days 30)}}selected{{/if}}>Last 30 days</option>
      <option value="90" {{#if (eq days 90)}}selected{{/if}}>Last 90 days</option>
      <option value="180" {{#if (eq days 180)}}selected{{/if}}>Last 180 days</option>
      <option value="365" {{#if (eq days 365)}}selected{{/if}}>Last 12 months</option>
    </select>
  </form>
  <a href="/admin/affiliates" class="wp-btn wp-btn-sm">&larr; All Affiliates</a>
</div>

<div class="wp-widgets mb-8">
  <div class="wp-postbox">
    <div class="wp-postbox__body">
      <p class="wp-widget-number">{{currency summary.paid}}</p>
      <p class="wp-widget-label">Paid Commission</p>
    </div>
  </div>
  <div class="wp-postbox">
    <div class="wp-postbox__body">
      <p class="wp-widget-number">{{currency summary.pending}}</p>
      <p class="wp-widget-label">Pending Commission</p>
    </div>
  </div>
  <div class="wp-postbox">
    <div class="wp-postbox__body">
      <p class="wp-widget-number">{{summary.orderCount}}</p>
      <p class="wp-widget-label">Referred Orders</p>
    </div>
  </div>
  <div class="wp-postbox">
    <div class="wp-postbox__body">
      <p class="wp-widget-number">{{currency summary.reversed}}</p>
      <p class="wp-widget-label">Reversed / Rejected</p>
    </div>
  </div>
</div>

<div class="mb-6 grid gap-5 lg:grid-cols-[1.6fr_1fr]">
  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Commission — Pending vs. Paid</h2></div>
    <div class="wp-postbox__body">
      <div style="height:260px;"><canvas id="commissionChart"></canvas></div>
    </div>
  </div>
  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Commission Split</h2></div>
    <div class="wp-postbox__body">
      <div style="height:260px;"><canvas id="splitChart"></canvas></div>
    </div>
  </div>
</div>

<div class="grid gap-5 lg:grid-cols-[1fr_1.2fr]">
  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Link Clicks</h2></div>
    <div class="wp-postbox__body">
      <div style="height:220px;"><canvas id="clicksChart"></canvas></div>
    </div>
  </div>
  <div class="wp-postbox">
    <div class="wp-postbox__header">
      <h2>Top Affiliates</h2>
      <a href="/admin/affiliates/export.csv" class="wp-btn wp-btn-sm">Export CSV &darr;</a>
    </div>
    <div class="wp-postbox__body--flush">
      {{#if leaderboard.length}}
      <table class="wp-list-table">
        <thead>
          <tr>
            <th>Affiliate</th>
            <th>Orders</th>
            <th>Lifetime</th>
          </tr>
        </thead>
        <tbody>
          {{#each leaderboard}}
          <tr>
            <td>
              <a href="/admin/affiliates/{{this.affiliateId}}" class="wp-row-title">{{this.fullName}}</a>
              <span class="block text-xs" style="color:var(--wp-text-muted);">{{this.email}}</span>
            </td>
            <td>{{this.orders}}</td>
            <td class="wp-row-title">{{currency this.lifetime}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="wp-list-table-empty">No commission activity yet.</p>
      {{/if}}
    </div>
  </div>
</div>

<script src="/js/vendor/chart.umd.min.js"></script> <!-- Chart.js 4.5.1, vendored from npm -->
<script>
  (function () {
    var trend = {{{json trend}}};
    var clicks = {{{json clicks}}};

    // Read the WP-admin theme tokens set on body.wp-admin so the charts always match
    // the shell's live palette instead of a separately hardcoded set of hex values.
    var style = getComputedStyle(document.body);
    var link = style.getPropertyValue('--wp-link').trim() || '#2271b1';
    var warning = style.getPropertyValue('--wp-warning').trim() || '#9a6700';
    var muted = style.getPropertyValue('--wp-text-muted').trim() || '#646970';
    function alpha(hex, a) {
      var n = parseInt(hex.replace('#', ''), 16);
      var r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
      return 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')';
    }

    new Chart(document.getElementById('commissionChart'), {
      type: 'line',
      data: {
        labels: trend.map(function (r) { return r.date; }),
        datasets: [
          { label: 'Paid', data: trend.map(function (r) { return r.paid; }), borderColor: link, backgroundColor: alpha(link, .13), fill: true, tension: .3, pointRadius: 0 },
          { label: 'Pending', data: trend.map(function (r) { return r.pending; }), borderColor: warning, backgroundColor: alpha(warning, .13), fill: true, tension: .3, pointRadius: 0 }
        ]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } },
        scales: { y: { ticks: { callback: function (v) { return '$' + v; } } } } }
    });

    var totalPaid = {{summary.paid}};
    var totalPending = {{summary.pending}};
    var totalReversed = {{summary.reversed}};
    new Chart(document.getElementById('splitChart'), {
      type: 'doughnut',
      data: {
        labels: ['Paid', 'Pending', 'Reversed'],
        datasets: [{ data: [totalPaid, totalPending, totalReversed], backgroundColor: [link, warning, muted] }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, cutout: '65%' }
    });

    new Chart(document.getElementById('clicksChart'), {
      type: 'bar',
      data: {
        labels: clicks.map(function (r) { return r.date; }),
        datasets: [{ label: 'Clicks', data: clicks.map(function (r) { return r.clicks; }), backgroundColor: link }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
  })();
</script>
