<div class="wp-heading-inline">
  <h1>Affiliates</h1>
  <a href="/admin/affiliates/groups" class="wp-btn wp-btn-sm">Groups</a>
  <a href="/admin/affiliates/commissions" class="wp-btn wp-btn-sm">Commissions</a>
  <a href="/admin/affiliates/payouts" class="wp-btn wp-btn-sm">Payouts</a>
  <a href="/admin/affiliates/analytics" class="wp-btn wp-btn-sm">Analytics</a>
</div>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div class="wp-tabs">
    <a href="/admin/affiliates{{#if q}}?q={{q}}{{/if}}" class="{{#unless statusFilter}}is-active{{/unless}}">All</a>
    <a href="/admin/affiliates?status=pending{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "pending")}}is-active{{/if}}">Pending</a>
    <a href="/admin/affiliates?status=approved{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "approved")}}is-active{{/if}}">Approved</a>
    <a href="/admin/affiliates?status=suspended{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "suspended")}}is-active{{/if}}">Suspended</a>
    <a href="/admin/affiliates?status=rejected{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "rejected")}}is-active{{/if}}">Rejected</a>
  </div>
  <form method="get" class="wp-search-box">
    {{#if statusFilter}}<input type="hidden" name="status" value="{{statusFilter}}" />{{/if}}
    <input type="search" name="q" value="{{q}}" placeholder="Search name or email…" />
    <button type="submit" class="wp-btn">Search</button>
  </form>
</div>

<form action="/admin/affiliates/bulk/approve" method="post" data-bulk-affiliates>
{{#if (eq statusFilter "pending")}}
<div class="wp-bulk-bar">
  <label class="flex items-center gap-2 text-[13px]">
    <input type="checkbox" data-select-all /> Select All
  </label>
  <button type="submit" formaction="/admin/affiliates/bulk/reject" data-bulk-btn disabled class="wp-btn wp-btn-danger disabled:cursor-not-allowed disabled:opacity-40">Reject Selected</button>
  <button type="submit" formaction="/admin/affiliates/bulk/approve" data-bulk-btn disabled class="wp-btn wp-btn-primary disabled:cursor-not-allowed disabled:opacity-40">Approve Selected</button>
</div>
{{/if}}

<div class="wp-list-table-wrap">
  {{#if affiliates.length}}
  <table class="wp-list-table">
    <thead>
      <tr>
        {{#if (eq statusFilter "pending")}}<th class="wp-col-check"></th>{{/if}}
        <th>Name</th>
        <th>Email</th>
        <th>Profession</th>
        <th>Status</th>
        <th>Commission</th>
      </tr>
    </thead>
    <tbody>
      {{#each affiliates}}
      <tr>
        {{#if (eq ../statusFilter "pending")}}<td><input type="checkbox" name="ids" value="{{this._id}}" data-row-check /></td>{{/if}}
        <td>
          <a href="/admin/affiliates/{{this._id}}" class="wp-row-title">{{this.fullName}}</a>
          <div class="wp-row-actions">
            <a href="/admin/affiliates/{{this._id}}">View</a>
          </div>
        </td>
        <td>{{this.email}}</td>
        <td>{{this.profession}}</td>
        <td>
          {{#if (eq this.status "approved")}}<span class="wp-badge wp-badge--success">Approved</span>{{/if}}
          {{#if (eq this.status "pending")}}<span class="wp-badge wp-badge--warning">Pending</span>{{/if}}
          {{#if (eq this.status "rejected")}}<span class="wp-badge wp-badge--error">Rejected</span>{{/if}}
          {{#if (eq this.status "suspended")}}<span class="wp-badge wp-badge--neutral">Suspended</span>{{/if}}
        </td>
        <td>{{pct this.commissionRate}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{#if (gt pages 1)}}
  <div class="flex items-center justify-between border-t px-3 py-2.5" style="border-color:var(--wp-border);">
    <span class="text-[13px]" style="color:var(--wp-text-muted);">Page {{page}} of {{pages}} &middot; {{total}} affiliates</span>
    <div class="wp-pagination">
      {{#if (gt page 1)}}<a href="/admin/affiliates?page={{dec page}}{{#if statusFilter}}&status={{statusFilter}}{{/if}}{{#if q}}&q={{q}}{{/if}}">&larr; Prev</a>{{/if}}
      {{#if (gt pages page)}}<a href="/admin/affiliates?page={{inc page}}{{#if statusFilter}}&status={{statusFilter}}{{/if}}{{#if q}}&q={{q}}{{/if}}">Next &rarr;</a>{{/if}}
    </div>
  </div>
  {{/if}}
  {{else}}
  <p class="wp-list-table-empty">No affiliates found.</p>
  {{/if}}
</div>
</form>

<script>
  (function () {
    var form = document.querySelector('[data-bulk-affiliates]');
    if (!form) return;
    var selectAll = form.querySelector('[data-select-all]');
    var rowChecks = form.querySelectorAll('[data-row-check]');
    var btns = form.querySelectorAll('[data-bulk-btn]');
    if (!selectAll || !rowChecks.length) return;
    function update() {
      var anyChecked = Array.prototype.some.call(rowChecks, function (c) { return c.checked; });
      btns.forEach(function (b) { b.disabled = !anyChecked; });
    }
    selectAll.addEventListener('change', function () {
      rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
      update();
    });
    rowChecks.forEach(function (c) { c.addEventListener('change', update); });
  })();
</script>
