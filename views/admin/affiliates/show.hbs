<div class="wp-heading-inline">
  <h1>{{affiliate.fullName}}</h1>
  <a href="/admin/affiliates" class="wp-btn wp-btn-sm">&larr; All Affiliates</a>
</div>

{{#if justApprovedPassword}}
<div class="wp-notice wp-notice--success">
  <div>
    <p style="font-weight:600;">Affiliate approved &mdash; share these login details now. They won't be shown again.</p>
    <div class="mt-2 grid gap-1">
      <p>Portal: <span class="font-mono">/professionals/login</span></p>
      <p>Email: <span class="font-mono">{{affiliate.email}}</span></p>
      <p>Temporary Password: <span class="font-mono" style="font-weight:600;">{{justApprovedPassword}}</span></p>
      <p>Referral Link: <span class="font-mono">{{justApprovedReferralLink}}</span></p>
    </div>
  </div>
</div>
{{/if}}

<div class="wp-columns">
  <div>
    <div class="wp-postbox">
      <div class="wp-postbox__header">
        <h2>Application</h2>
        {{#if affiliate.emailVerified}}
        <span class="wp-badge wp-badge--success">Email Verified</span>
        {{else}}
        <span class="wp-badge wp-badge--warning">Email Not Verified</span>
        {{/if}}
      </div>
      <div class="wp-postbox__body">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div><dt style="color:var(--wp-text-muted);">Business</dt><dd>{{or affiliate.businessName "—"}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Title</dt><dd>{{or affiliate.title "—"}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Email</dt><dd>{{affiliate.email}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Phone</dt><dd>{{or affiliate.phone "—"}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Website</dt><dd>{{or affiliate.website "—"}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Location</dt><dd>{{affiliate.city}}{{#if affiliate.state}}, {{affiliate.state}}{{/if}} {{affiliate.country}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Profession</dt><dd>{{affiliate.profession}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Experience</dt><dd>{{affiliate.experience}} yrs</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Reach</dt><dd>{{affiliate.reach}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Sales Goal</dt><dd>{{affiliate.salesGoal}} / mo</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Currently Recommends</dt><dd>{{affiliate.currentlyRecommends}}</dd></div>
          <div><dt style="color:var(--wp-text-muted);">Current Brands</dt><dd>{{or affiliate.currentBrands "—"}}</dd></div>
        </dl>
        <div class="mt-4">
          <dt class="text-sm" style="color:var(--wp-text-muted);">Personal Statement</dt>
          <dd class="mt-1 text-sm">{{affiliate.personalStatement}}</dd>
        </div>
      </div>
    </div>

    <div class="wp-postbox">
      <div class="wp-postbox__header">
        <h2>Referred Orders</h2>
        <a href="/admin/affiliates/{{affiliate._id}}/export.csv" class="wp-btn wp-btn-sm">Export CSV &darr;</a>
      </div>
      <div class="wp-postbox__body--flush">
        {{#if orders.length}}
        <table class="wp-list-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Total</th>
              <th>Commission</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {{#each orders}}
            <tr>
              <td class="wp-row-title">{{this.orderNumber}}</td>
              <td>{{currency this.subtotal}}</td>
              <td>{{currency this.commissionAmount}}</td>
              <td>
                {{#if (eq this.commissionStatus "paid")}}<span class="wp-badge wp-badge--success">Paid{{#if this.refundFlaggedForClawback}} &middot; Refunded{{/if}}</span>{{/if}}
                {{#if (eq this.commissionStatus "pending")}}<span class="wp-badge wp-badge--neutral">Pending</span>{{/if}}
                {{#if (eq this.commissionStatus "rejected")}}<span class="wp-badge wp-badge--error" title="{{this.commissionNote}}">Rejected</span>{{/if}}
                {{#if (eq this.commissionStatus "reversed")}}<span class="wp-badge wp-badge--error" title="{{this.commissionNote}}">Reversed</span>{{/if}}
              </td>
              <td>
                {{#if (eq this.commissionStatus "pending")}}
                <form action="/admin/affiliates/{{../affiliate._id}}/orders/{{this._id}}/mark-paid" method="post">
                  <button type="submit" class="wp-btn wp-btn-sm">Mark Paid</button>
                </form>
                {{/if}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <p class="wp-list-table-empty">No referred orders yet.</p>
        {{/if}}
      </div>
    </div>
  </div>

  <div>
    <div class="wp-postbox">
      <div class="wp-postbox__header"><h2>Status</h2></div>
      <div class="wp-postbox__body">
        <p>
          {{#if (eq affiliate.status "approved")}}<span class="wp-badge wp-badge--success">Approved</span>{{/if}}
          {{#if (eq affiliate.status "pending")}}<span class="wp-badge wp-badge--neutral">Pending</span>{{/if}}
          {{#if (eq affiliate.status "rejected")}}<span class="wp-badge wp-badge--error">Rejected</span>{{/if}}
          {{#if (eq affiliate.status "suspended")}}<span class="wp-badge wp-badge--warning">Suspended</span>{{/if}}
        </p>

        {{#if (eq affiliate.status "pending")}}
        <div class="mt-4 flex gap-2">
          <form action="/admin/affiliates/{{affiliate._id}}/approve" method="post">
            <button type="submit" class="wp-btn wp-btn-primary">Approve</button>
          </form>
          <form action="/admin/affiliates/{{affiliate._id}}/reject" method="post">
            <button type="submit" class="wp-btn">Reject</button>
          </form>
        </div>
        {{/if}}

        {{#if (eq affiliate.status "rejected")}}
        <form action="/admin/affiliates/{{affiliate._id}}/approve" method="post" class="mt-4">
          <button type="submit" class="wp-btn wp-btn-primary">Approve Anyway</button>
        </form>
        {{/if}}
      </div>
    </div>

    {{#if (eq affiliate.status "approved")}}
    <div class="wp-postbox">
      <div class="wp-postbox__header"><h2>Referral Code</h2></div>
      <div class="wp-postbox__body">
        <p class="font-mono text-sm">{{affiliate.referralCode}}</p>

        <form action="/admin/affiliates/{{affiliate._id}}/commission-rate" method="post" class="mt-5 space-y-2">
          <label class="field-label" for="commissionRate">Commission Rate (%)</label>
          <div class="flex gap-2">
            <input id="commissionRate" name="commissionRate" type="number" min="0" max="100" step="1" value="{{mul affiliate.commissionRate 100}}" class="input-field" />
            <button type="submit" class="wp-btn">Save</button>
          </div>
        </form>

        <div class="mt-5 border-t pt-4 text-sm" style="border-color:var(--wp-border);">
          <p class="flex justify-between"><span style="color:var(--wp-text-muted);">Lifetime</span><span class="wp-row-title">{{currency totals.lifetime}}</span></p>
          <p class="mt-1 flex justify-between"><span style="color:var(--wp-text-muted);">Pending</span><span class="wp-row-title">{{currency totals.pending}}</span></p>
          <p class="mt-1 flex justify-between"><span style="color:var(--wp-text-muted);">Paid</span><span class="wp-row-title">{{currency totals.paid}}</span></p>
          <p class="mt-1 flex justify-between"><span style="color:var(--wp-text-muted);">Link Clicks</span><span class="wp-row-title">{{affiliate.clickCount}}</span></p>
          <p class="mt-1 flex justify-between"><span style="color:var(--wp-text-muted);">Payout Email</span><span class="wp-row-title">{{or affiliate.payoutEmail "not set"}}</span></p>
        </div>

        <form action="/admin/affiliates/{{affiliate._id}}/group" method="post" class="mt-5 space-y-2 border-t pt-4" style="border-color:var(--wp-border);">
          <label class="field-label" for="groupId">Group</label>
          <div class="flex gap-2">
            <select id="groupId" name="groupId" class="input-field">
              <option value="">&mdash; No group &mdash;</option>
              {{#each groups}}
              <option value="{{this._id}}" {{#if (eqId ../affiliate.groupId this._id)}}selected{{/if}}>{{this.name}} ({{pct this.defaultCommissionRate}})</option>
              {{/each}}
            </select>
            <button type="submit" class="wp-btn">Save</button>
          </div>
        </form>

        <div class="mt-5 border-t pt-4" style="border-color:var(--wp-border);">
          <p class="text-[12.5px] font-semibold uppercase tracking-wide" style="color:var(--wp-text-muted);">Performance Tier</p>
          <p class="mt-1 text-sm">{{currentTier.label}} &middot; {{pct currentTier.rate}}{{#if upcomingTier}} <span style="color:var(--wp-text-muted);">&middot; {{currency upcomingTier.minLifetimeSales}} for {{upcomingTier.label}}</span>{{/if}}</p>
          <p class="mt-1 text-xs" style="color:var(--wp-text-muted);">Lifetime sales driven: {{currency lifetimeSales}}</p>
          <form action="/admin/affiliates/{{affiliate._id}}/tiering" method="post" class="mt-2">
            <input type="hidden" name="tieringEnabled" value="{{#if affiliate.tieringEnabled}}false{{else}}true{{/if}}" />
            <button type="submit" class="wp-btn wp-btn-sm">
              {{#if affiliate.tieringEnabled}}Disable tiering (use flat rate){{else}}Enable performance tiering{{/if}}
            </button>
          </form>
        </div>

        <form action="/admin/affiliates/{{affiliate._id}}/min-payout-threshold" method="post" class="mt-5 space-y-2 border-t pt-4" style="border-color:var(--wp-border);">
          <label class="field-label" for="minPayoutThreshold">Payout Threshold Override</label>
          <div class="flex gap-2">
            <input id="minPayoutThreshold" name="minPayoutThreshold" type="number" min="0" step="1" value="{{affiliate.minPayoutThreshold}}" placeholder="{{currency minPayoutThreshold}} (default)" class="input-field" />
            <button type="submit" class="wp-btn">Save</button>
          </div>
        </form>

        <div class="mt-5 border-t pt-4" style="border-color:var(--wp-border);">
          <p class="text-[12.5px] font-semibold uppercase tracking-wide" style="color:var(--wp-text-muted);">Stripe Connect Payouts</p>
          {{#unless stripeConfigured}}
          <p class="mt-1 text-xs" style="color:var(--wp-text-muted);">Stripe isn't configured on this environment yet.</p>
          {{else}}
          {{#unless affiliate.stripeConnectAccountId}}
          <p class="mt-1 text-xs" style="color:var(--wp-text-muted);">Affiliate hasn't connected a Stripe account yet.</p>
          {{else}}
          {{#if connectStatus.payoutsEnabled}}
          <p class="mt-1 text-xs" style="color:var(--wp-success);">Connected &middot; ready to receive payouts.</p>
          {{#if (gt totals.pending 0)}}
          <form action="/admin/affiliates/{{affiliate._id}}/stripe-payout" method="post" class="mt-2" onsubmit="return confirm('Transfer {{currency totals.pending}} to this affiliate via Stripe now? This moves real money.');">
            <button type="submit" class="wp-btn wp-btn-primary w-full justify-center">Pay {{currency totals.pending}} via Stripe</button>
          </form>
          {{/if}}
          {{else}}
          <p class="mt-1 text-xs" style="color:var(--wp-warning);">Onboarding started but not finished &mdash; payouts aren't enabled yet.</p>
          {{/if}}
          {{/unless}}
          {{/unless}}
        </div>

        <form action="/admin/affiliates/{{affiliate._id}}/suspend" method="post" class="mt-4 border-t pt-4" style="border-color:var(--wp-border);" onsubmit="return confirm('Suspend this affiliate? They will not be able to log in or earn new commissions until reactivated.');">
          <button type="submit" class="wp-btn wp-btn-sm w-full justify-center" style="color:var(--wp-warning);">Suspend Affiliate</button>
        </form>
      </div>
    </div>
    {{/if}}

    {{#if (eq affiliate.status "suspended")}}
    <div class="wp-notice wp-notice--warning">
      <div>
        <p>This affiliate is suspended &mdash; they can't log in or earn new commissions. Past orders and commissions are unaffected.</p>
        <form action="/admin/affiliates/{{affiliate._id}}/reactivate" method="post" class="mt-3">
          <button type="submit" class="wp-btn wp-btn-primary">Reactivate</button>
        </form>
      </div>
    </div>
    {{/if}}

    {{#if anomalies.length}}
    <div class="wp-notice wp-notice--error">
      <div>
        <p style="font-weight:600;">Click Anomaly Flags</p>
        <p class="mt-1 text-xs">Unusually many clicks from the same visitor in the last 7 days &mdash; a signal to review, not an automatic block.</p>
        <ul class="mt-2 space-y-1 text-xs">
          {{#each anomalies}}
          <li class="flex justify-between"><span class="font-mono">{{this.ipHash}}</span><span>{{this.clicks}} clicks</span></li>
          {{/each}}
        </ul>
      </div>
    </div>
    {{/if}}
  </div>
</div>
