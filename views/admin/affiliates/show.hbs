<div class="flex items-center justify-between">
  <h1 class="font-display text-2xl font-medium text-al-navy">{{affiliate.fullName}}</h1>
  <a href="/admin/affiliates" class="text-xs font-semibold uppercase tracking-wide text-al-ink/50 hover:text-al-navy">&larr; All Affiliates</a>
</div>

{{#if justApprovedPassword}}
<div class="mt-6 rounded-none border border-green-300 bg-green-50 p-5 text-sm text-green-900">
  <p class="font-semibold">Affiliate approved &mdash; share these login details now. They won't be shown again.</p>
  <div class="mt-3 grid gap-1">
    <p>Portal: <span class="font-mono">/professionals/login</span></p>
    <p>Email: <span class="font-mono">{{affiliate.email}}</span></p>
    <p>Temporary Password: <span class="font-mono font-semibold">{{justApprovedPassword}}</span></p>
    <p>Referral Link: <span class="font-mono">{{justApprovedReferralLink}}</span></p>
  </div>
</div>
{{/if}}

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
  <div class="space-y-6">
    <div class="rounded-none border border-al-line bg-white p-6">
      <h2 class="font-display text-lg font-medium text-al-navy">Application</h2>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
        <div><dt class="text-al-ink/50">Business</dt><dd class="text-al-navy">{{or affiliate.businessName "—"}}</dd></div>
        <div><dt class="text-al-ink/50">Title</dt><dd class="text-al-navy">{{or affiliate.title "—"}}</dd></div>
        <div><dt class="text-al-ink/50">Email</dt><dd class="text-al-navy">{{affiliate.email}}</dd></div>
        <div><dt class="text-al-ink/50">Phone</dt><dd class="text-al-navy">{{or affiliate.phone "—"}}</dd></div>
        <div><dt class="text-al-ink/50">Website</dt><dd class="text-al-navy">{{or affiliate.website "—"}}</dd></div>
        <div><dt class="text-al-ink/50">Location</dt><dd class="text-al-navy">{{affiliate.city}}{{#if affiliate.state}}, {{affiliate.state}}{{/if}} {{affiliate.country}}</dd></div>
        <div><dt class="text-al-ink/50">Profession</dt><dd class="text-al-navy">{{affiliate.profession}}</dd></div>
        <div><dt class="text-al-ink/50">Experience</dt><dd class="text-al-navy">{{affiliate.experience}} yrs</dd></div>
        <div><dt class="text-al-ink/50">Reach</dt><dd class="text-al-navy">{{affiliate.reach}}</dd></div>
        <div><dt class="text-al-ink/50">Sales Goal</dt><dd class="text-al-navy">{{affiliate.salesGoal}} / mo</dd></div>
        <div><dt class="text-al-ink/50">Currently Recommends</dt><dd class="text-al-navy">{{affiliate.currentlyRecommends}}</dd></div>
        <div><dt class="text-al-ink/50">Current Brands</dt><dd class="text-al-navy">{{or affiliate.currentBrands "—"}}</dd></div>
      </dl>
      <div class="mt-4">
        <dt class="text-sm text-al-ink/50">Personal Statement</dt>
        <dd class="mt-1 text-sm text-al-navy">{{affiliate.personalStatement}}</dd>
      </div>
    </div>

    <div class="rounded-none border border-al-line bg-white p-6">
      <h2 class="font-display text-lg font-medium text-al-navy">Referred Orders</h2>
      <div class="mt-4 overflow-hidden rounded-none border border-al-line">
        {{#if orders.length}}
        <table class="w-full text-left text-sm">
          <thead class="bg-al-panel text-xs font-semibold uppercase tracking-wide text-al-ink/60">
            <tr>
              <th class="px-4 py-3">Order</th>
              <th class="px-4 py-3">Total</th>
              <th class="px-4 py-3">Commission</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-al-line">
            {{#each orders}}
            <tr>
              <td class="px-4 py-3 font-semibold text-al-navy">{{this.orderNumber}}</td>
              <td class="px-4 py-3">{{currency this.subtotal}}</td>
              <td class="px-4 py-3">{{currency this.commissionAmount}}</td>
              <td class="px-4 py-3">
                {{#if (eq this.commissionStatus "paid")}}<span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-green-100 text-green-700">Paid</span>{{else}}<span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-al-panel text-al-ink/60">Pending</span>{{/if}}
              </td>
              <td class="px-4 py-3 text-right">
                {{#unless (eq this.commissionStatus "paid")}}
                <form action="/admin/affiliates/{{../affiliate._id}}/orders/{{this._id}}/mark-paid" method="post">
                  <button type="submit" class="text-xs font-semibold uppercase tracking-wide text-al-navy hover:underline">Mark Paid</button>
                </form>
                {{/unless}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{else}}
        <p class="p-6 text-sm text-al-ink/60">No referred orders yet.</p>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="rounded-none border border-al-line bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Status</p>
      <p class="mt-2">
        {{#if (eq affiliate.status "approved")}}<span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-green-100 text-green-700">Approved</span>{{/if}}
        {{#if (eq affiliate.status "pending")}}<span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-al-panel text-al-ink/60">Pending</span>{{/if}}
        {{#if (eq affiliate.status "rejected")}}<span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-700">Rejected</span>{{/if}}
      </p>

      {{#if (eq affiliate.status "pending")}}
      <div class="mt-4 flex gap-2">
        <form action="/admin/affiliates/{{affiliate._id}}/approve" method="post">
          <button type="submit" class="btn-primary !px-4 !py-2 text-sm">Approve</button>
        </form>
        <form action="/admin/affiliates/{{affiliate._id}}/reject" method="post">
          <button type="submit" class="btn-outline !px-4 !py-2 text-sm">Reject</button>
        </form>
      </div>
      {{/if}}

      {{#if (eq affiliate.status "rejected")}}
      <form action="/admin/affiliates/{{affiliate._id}}/approve" method="post" class="mt-4">
        <button type="submit" class="btn-primary !px-4 !py-2 text-sm">Approve Anyway</button>
      </form>
      {{/if}}
    </div>

    {{#if (eq affiliate.status "approved")}}
    <div class="rounded-none border border-al-line bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Referral Code</p>
      <p class="mt-2 font-mono text-sm text-al-navy">{{affiliate.referralCode}}</p>

      <form action="/admin/affiliates/{{affiliate._id}}/commission-rate" method="post" class="mt-5 space-y-2">
        <label class="field-label" for="commissionRate">Commission Rate (%)</label>
        <div class="flex gap-2">
          <input id="commissionRate" name="commissionRate" type="number" min="0" max="100" step="1" value="{{mul affiliate.commissionRate 100}}" class="input-field" />
          <button type="submit" class="btn-outline !px-4 text-sm">Save</button>
        </div>
      </form>

      <div class="mt-5 border-t border-al-line pt-4 text-sm">
        <p class="flex justify-between"><span class="text-al-ink/50">Lifetime</span><span class="font-semibold text-al-navy">{{currency totals.lifetime}}</span></p>
        <p class="mt-1 flex justify-between"><span class="text-al-ink/50">Pending</span><span class="font-semibold text-al-navy">{{currency totals.pending}}</span></p>
        <p class="mt-1 flex justify-between"><span class="text-al-ink/50">Paid</span><span class="font-semibold text-al-navy">{{currency totals.paid}}</span></p>
        <p class="mt-1 flex justify-between"><span class="text-al-ink/50">Link Clicks</span><span class="font-semibold text-al-navy">{{affiliate.clickCount}}</span></p>
        <p class="mt-1 flex justify-between"><span class="text-al-ink/50">Payout Email</span><span class="font-semibold text-al-navy">{{or affiliate.payoutEmail "not set"}}</span></p>
      </div>
    </div>
    {{/if}}
  </div>
</div>
