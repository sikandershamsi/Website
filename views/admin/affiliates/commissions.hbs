<div class="wp-heading-inline">
  <h1>Pending Commissions</h1>
  <a href="/admin/affiliates/payouts" class="wp-btn wp-btn-sm">Payout History</a>
  <a href="/admin/affiliates" class="wp-btn wp-btn-sm">&larr; All Affiliates</a>
</div>
<p class="mb-4 text-xs" style="color:var(--wp-text-muted);">Only affiliates whose pending balance has crossed their payout threshold (default {{currency defaultThreshold}}) are listed below and payable in bulk.</p>

{{#if belowThreshold.length}}
<div class="wp-notice wp-notice--warning">
  <div>
    <p style="font-weight:600;">Below Payout Threshold</p>
    <ul class="mt-1 space-y-0.5">
      {{#each belowThreshold}}
      <li>{{this.fullName}} &mdash; {{currency this.pending}} pending (needs {{currency this.threshold}})</li>
      {{/each}}
    </ul>
  </div>
</div>
{{/if}}

{{#if rows.length}}
<form action="/admin/affiliates/commissions/bulk-mark-paid" method="post" data-bulk-commissions>
  <div class="wp-bulk-bar">
    <label class="flex items-center gap-2 text-[13px]">
      <input type="checkbox" data-select-all /> Select All
    </label>
    <button type="submit" data-bulk-pay-btn disabled class="wp-btn wp-btn-primary disabled:cursor-not-allowed disabled:opacity-40">Mark Selected Paid</button>
  </div>

  <div class="wp-list-table-wrap">
    <table class="wp-list-table">
      <thead>
        <tr>
          <th class="wp-col-check"></th>
          <th>Order</th>
          <th>Date</th>
          <th>Affiliate</th>
          <th>Commission</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><input type="checkbox" name="ids" value="{{this._id}}" data-row-check /></td>
          <td class="wp-row-title">{{this.orderNumber}}</td>
          <td>{{dateShort this.createdAt}}</td>
          <td>
            {{#if this.affiliateId.fullName}}
            <a href="/admin/affiliates/{{this.affiliateId._id}}">{{this.affiliateId.fullName}}</a>
            {{/if}}
          </td>
          <td class="wp-row-title">{{currency this.commissionAmount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</form>

<script>
  (function () {
    var form = document.querySelector('[data-bulk-commissions]');
    if (!form) return;
    var selectAll = form.querySelector('[data-select-all]');
    var rowChecks = form.querySelectorAll('[data-row-check]');
    var payBtn = form.querySelector('[data-bulk-pay-btn]');
    function update() {
      var anyChecked = Array.prototype.some.call(rowChecks, function (c) { return c.checked; });
      payBtn.disabled = !anyChecked;
    }
    selectAll.addEventListener('change', function () {
      rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
      update();
    });
    rowChecks.forEach(function (c) { c.addEventListener('change', update); });
    form.addEventListener('submit', function (e) {
      if (!confirm('Mark the selected commissions as paid? This cannot be undone from here.')) e.preventDefault();
    });
  })();
</script>
{{else}}
<p class="wp-list-table-empty">No pending commissions.</p>
{{/if}}
