<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="font-display text-2xl font-medium text-al-navy">Pending Commissions</h1>
  <div class="flex gap-3 text-xs font-semibold uppercase tracking-wide">
    <a href="/admin/affiliates/payouts" class="text-al-ink/50 hover:text-al-navy">Payout History</a>
    <a href="/admin/affiliates" class="text-al-ink/50 hover:text-al-navy">&larr; All Affiliates</a>
  </div>
</div>

{{#if rows.length}}
<form action="/admin/affiliates/commissions/bulk-mark-paid" method="post" data-bulk-commissions>
  <div class="mt-6 flex items-center justify-between">
    <label class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-al-ink/60">
      <input type="checkbox" data-select-all class="accent-al-navy" /> Select All
    </label>
    <button type="submit" data-bulk-pay-btn disabled class="btn-primary !px-4 !py-2 text-xs disabled:cursor-not-allowed disabled:opacity-40">Mark Selected Paid</button>
  </div>

  <div class="mt-3 overflow-hidden rounded-none border border-al-line bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-al-panel text-xs font-semibold uppercase tracking-wide text-al-ink/60">
        <tr>
          <th class="w-10 px-4 py-3"></th>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Affiliate</th>
          <th class="px-4 py-3">Commission</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-al-line">
        {{#each rows}}
        <tr>
          <td class="px-4 py-3"><input type="checkbox" name="ids" value="{{this._id}}" data-row-check class="accent-al-navy" /></td>
          <td class="px-4 py-3 font-semibold text-al-navy">{{this.orderNumber}}</td>
          <td class="px-4 py-3 text-al-ink/60">{{dateShort this.createdAt}}</td>
          <td class="px-4 py-3">
            {{#if this.affiliateId.fullName}}
            <a href="/admin/affiliates/{{this.affiliateId._id}}" class="text-al-navy hover:underline">{{this.affiliateId.fullName}}</a>
            {{/if}}
          </td>
          <td class="px-4 py-3 font-semibold text-al-navy">{{currency this.commissionAmount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</form>

<script>
  (function () {
    var form = document.querySelector('[data-bulk-commissions]');
    if (!form) return;
    var selectAll = form.querySelector('[data-select-all]');
    var rowChecks = form.querySelectorAll('[data-row-check]');
    var payBtn = form.querySelector('[data-bulk-pay-btn]');
    function update() {
      var anyChecked = Array.prototype.some.call(rowChecks, function (c) { return c.checked; });
      payBtn.disabled = !anyChecked;
    }
    selectAll.addEventListener('change', function () {
      rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
      update();
    });
    rowChecks.forEach(function (c) { c.addEventListener('change', update); });
    form.addEventListener('submit', function (e) {
      if (!confirm('Mark the selected commissions as paid? This cannot be undone from here.')) e.preventDefault();
    });
  })();
</script>
{{else}}
<p class="mt-6 text-sm text-al-ink/60">No pending commissions.</p>
{{/if}}
