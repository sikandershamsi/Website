<div class="wp-heading-inline">
  <h1>Affiliate Groups</h1>
  <a href="/admin/affiliates" class="wp-btn wp-btn-sm">&larr; All Affiliates</a>
</div>
<p class="mb-5 max-w-xl text-sm" style="color:var(--wp-text-muted);">Group affiliates &mdash; Ambassadors, Veterinary Partners, Influencers &mdash; and set a default commission rate for the whole group. Assigning a group to an affiliate applies its rate to them.</p>

<div class="wp-columns">
  <div class="wp-list-table-wrap">
    {{#if groups.length}}
    <table class="wp-list-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Default Rate</th>
          <th>Members</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each groups}}
        <tr style="animation-delay:{{mul @index 30}}ms">
          <td>
            <span class="wp-row-title">{{this.name}}</span>
            {{#if this.description}}<div class="text-xs" style="color:var(--wp-text-muted);">{{this.description}}</div>{{/if}}
          </td>
          <td>{{pct this.defaultCommissionRate}}</td>
          <td>{{this.memberCount}}</td>
          <td>
            <form action="/admin/affiliates/groups/{{this._id}}/delete" method="post" onsubmit="return confirm('Delete this group? Members keep their current rate but lose the group assignment.');">
              <button type="submit" class="wp-btn wp-btn-danger wp-btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="wp-list-table-empty">No groups yet.</p>
    {{/if}}
  </div>

  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>New Group</h2></div>
    <div class="wp-postbox__body">
      <form action="/admin/affiliates/groups" method="post" class="space-y-3">
        <div>
          <label class="field-label" for="name">Name</label>
          <input id="name" name="name" required class="input-field" />
        </div>
        <div>
          <label class="field-label" for="description">Description</label>
          <input id="description" name="description" class="input-field" />
        </div>
        <div>
          <label class="field-label" for="defaultCommissionRate">Default Commission Rate (%)</label>
          <input id="defaultCommissionRate" name="defaultCommissionRate" type="number" min="0" max="100" step="1" value="20" class="input-field" />
        </div>
        <button type="submit" class="wp-btn wp-btn-primary w-full justify-center">Create Group</button>
      </form>
    </div>
  </div>
</div>
