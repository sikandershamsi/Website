<a href="/admin/orders" class="wp-btn wp-btn-sm mb-3">&larr; All Orders</a>
<div class="wp-heading-inline">
  <h1>Order {{order.orderNumber}}</h1>
</div>

<div class="wp-columns">
  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Line Items</h2></div>
    <div class="wp-postbox__body">
      <div class="space-y-3">
        {{#each order.lines}}
        <div class="flex justify-between border-b pb-3 text-sm" style="border-color:var(--wp-border);">
          <span>{{this.name}} &times; {{this.qty}}{{#if this.isSubscription}} (subscription &mdash; {{subscriptionFrequencyLabel this.subscriptionFrequency}}){{/if}}</span>
          <span class="wp-row-title">{{currency this.price}}</span>
        </div>
        {{/each}}
      </div>
      <div class="mt-4 flex justify-between text-sm" style="font-weight:600;">
        <span>Subtotal</span>
        <span>{{currency order.subtotal}}</span>
      </div>

      {{#if order.shipping}}
      <p class="mt-6 mb-1 text-[12.5px] font-semibold uppercase tracking-wide" style="color:var(--wp-text-muted);">Shipping</p>
      <p class="text-sm">
        {{order.shipping.fullName}}<br />
        {{order.shipping.address}}<br />
        {{order.shipping.city}}, {{order.shipping.state}} {{order.shipping.zip}}<br />
        {{order.shipping.country}}
      </p>
      {{/if}}
    </div>
  </div>

  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Status</h2></div>
    <div class="wp-postbox__body">
      <form action="/admin/orders/{{order._id}}/status" method="post" class="flex items-center gap-2">
        <select name="status" class="input-field">
          {{#each (array "pending" "paid" "fulfilled" "cancelled" "refunded")}}
          <option value="{{this}}" {{#ifCond this ../order.status}}selected{{/ifCond}}>{{this}}</option>
          {{/each}}
        </select>
        <button type="submit" class="wp-btn wp-btn-sm">Update</button>
      </form>

      <p class="mt-6 mb-1 text-[12.5px] font-semibold uppercase tracking-wide" style="color:var(--wp-text-muted);">Stripe</p>
      <p class="break-all text-xs" style="color:var(--wp-text-muted);">{{order.stripe.checkoutSessionId}}</p>
    </div>
  </div>
</div>
