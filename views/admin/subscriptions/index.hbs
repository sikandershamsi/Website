<div class="wp-heading-inline">
  <h1>Subscriptions</h1>
</div>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div class="wp-tabs">
    <a href="/admin/subscriptions{{#if q}}?q={{q}}{{/if}}" class="{{#unless statusFilter}}is-active{{/unless}}">All</a>
    <a href="/admin/subscriptions?status=active{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "active")}}is-active{{/if}}">Active</a>
    <a href="/admin/subscriptions?status=trialing{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "trialing")}}is-active{{/if}}">Trialing</a>
    <a href="/admin/subscriptions?status=past_due{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "past_due")}}is-active{{/if}}">Past Due</a>
    <a href="/admin/subscriptions?status=canceled{{#if q}}&q={{q}}{{/if}}" class="{{#if (eq statusFilter "canceled")}}is-active{{/if}}">Canceled</a>
  </div>
  <form method="get" class="wp-search-box">
    {{#if statusFilter}}<input type="hidden" name="status" value="{{statusFilter}}" />{{/if}}
    <input type="search" name="q" value="{{q}}" placeholder="Search product…" />
    <button type="submit" class="wp-btn">Search</button>
  </form>
</div>

<div class="wp-list-table-wrap">
  {{#if subscriptions.length}}
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Status</th>
        <th>Renews</th>
      </tr>
    </thead>
    <tbody>
      {{#each subscriptions}}
      <tr style="animation-delay:{{mul @index 30}}ms">
        <td>
          <a href="/admin/subscriptions/{{this._id}}" class="wp-row-title">{{this.productName}}</a>
          <div class="wp-row-actions">
            <a href="/admin/subscriptions/{{this._id}}">View</a>
          </div>
        </td>
        <td>
          <span class="wp-badge {{#if (eq this.status "active")}}wp-badge--success{{else if (eq this.status "past_due")}}wp-badge--warning{{else if (eq this.status "canceled")}}wp-badge--error{{else}}wp-badge--info{{/if}}">{{this.status}}</span>
          {{#if this.cancelAtPeriodEnd}}<span class="wp-badge wp-badge--neutral">cancelling</span>{{/if}}
        </td>
        <td>{{dateShort this.currentPeriodEnd}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="wp-list-table-empty">No subscriptions found.</p>
  {{/if}}
</div>

{{#if (gt pages 1)}}
<div class="mt-4 flex items-center justify-between">
  <span class="wp-pagination__count text-sm" style="color:var(--wp-text-muted);">Page {{page}} of {{pages}} &middot; {{total}} subscriptions</span>
  <div class="wp-pagination">
    {{#if (gt page 1)}}<a href="/admin/subscriptions?page={{dec page}}{{#if statusFilter}}&status={{statusFilter}}{{/if}}{{#if q}}&q={{q}}{{/if}}">&larr; Prev</a>{{/if}}
    {{#if (gt pages page)}}<a href="/admin/subscriptions?page={{inc page}}{{#if statusFilter}}&status={{statusFilter}}{{/if}}{{#if q}}&q={{q}}{{/if}}">Next &rarr;</a>{{/if}}
  </div>
</div>
{{/if}}
