<a href="/admin/subscriptions" class="wp-btn wp-btn-sm mb-3">&larr; All Subscriptions</a>
<div class="wp-heading-inline">
  <h1>{{subscription.productName}}</h1>
</div>

<div style="max-width:420px;">
  <div class="wp-postbox">
    <div class="wp-postbox__header"><h2>Details</h2></div>
    <div class="wp-postbox__body">
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between"><dt style="color:var(--wp-text-muted);">Status</dt><dd class="wp-row-title">{{subscription.status}}</dd></div>
        <div class="flex justify-between"><dt style="color:var(--wp-text-muted);">Interval</dt><dd>{{subscription.interval}}</dd></div>
        <div class="flex justify-between"><dt style="color:var(--wp-text-muted);">Current period ends</dt><dd>{{dateShort subscription.currentPeriodEnd}}</dd></div>
        <div class="flex justify-between"><dt style="color:var(--wp-text-muted);">Cancels at period end</dt><dd>{{#if subscription.cancelAtPeriodEnd}}Yes{{else}}No{{/if}}</dd></div>
      </dl>

      {{#unless subscription.cancelAtPeriodEnd}}
      <form action="/admin/subscriptions/{{subscription._id}}/cancel" method="post" class="mt-6">
        <button type="submit" class="wp-btn wp-btn-danger wp-btn-sm">Cancel at period end</button>
      </form>
      {{/unless}}
    </div>
  </div>
</div>
