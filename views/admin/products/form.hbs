<div class="wp-heading-inline">
  <h1>{{title}}</h1>
</div>

<div class="wp-columns">
  <form id="product-form" action="{{#if isNew}}/admin/products/new{{else}}/admin/products/{{product._id}}{{/if}}" method="post">
    <div class="wp-postbox">
      <div class="wp-postbox__header"><h2>Product Details</h2></div>
      <div class="wp-postbox__body space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="field-label" for="slug">Slug (URL-safe, unique)</label>
            <input id="slug" name="slug" value="{{product.slug}}" {{#unless isNew}}readonly{{/unless}} required class="input-field" />
          </div>
          <div>
            <label class="field-label" for="name">Name</label>
            <input id="name" name="name" value="{{product.name}}" required class="input-field" />
          </div>
          <div>
            <label class="field-label" for="trademark">Trademark (display name)</label>
            <input id="trademark" name="trademark" value="{{product.trademark}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="price">Price (USD)</label>
            <input id="price" name="price" type="number" step="0.01" value="{{product.price}}" required class="input-field" />
          </div>
          <div>
            <label class="field-label" for="categorySlug">Category</label>
            <select id="categorySlug" name="categorySlug" class="input-field">
              <option value="">&mdash;</option>
              {{#each categories}}
              <option value="{{this.slug}}" {{#ifCond ../product.categorySlug this.slug}}selected{{/ifCond}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="field-label" for="category">Category (display label)</label>
            <input id="category" name="category" value="{{product.category}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="size">Size</label>
            <input id="size" name="size" value="{{product.size}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="heroStat">Hero Stat</label>
            <input id="heroStat" name="heroStat" value="{{product.heroStat}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="image">Image path</label>
            <input id="image" name="image" value="{{product.image}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="accent">Accent color key</label>
            <input id="accent" name="accent" value="{{product.accent}}" class="input-field" />
          </div>
          <div>
            <label class="field-label" for="affiliateCommissionRate">Affiliate Commission Override (%)</label>
            <input id="affiliateCommissionRate" name="affiliateCommissionRate" type="number" min="0" max="100" step="1" value="{{#if product.affiliateCommissionRate}}{{mul product.affiliateCommissionRate 100}}{{/if}}" placeholder="Use affiliate's own rate" class="input-field" />
          </div>
        </div>

        <div>
          <label class="field-label" for="tagline">Tagline</label>
          <input id="tagline" name="tagline" value="{{product.tagline}}" class="input-field" />
        </div>

        <div>
          <label class="field-label" for="description">Description</label>
          <textarea id="description" name="description" rows="3" class="input-field">{{product.description}}</textarea>
        </div>

        <div>
          <label class="field-label" for="variants">Size Options (one per line, "Size Label | Price")</label>
          <textarea id="variants" name="variants" rows="4" placeholder="600g (30 Days) | 74" class="input-field">{{#each product.variants}}{{this.size}} | {{this.price}}
{{/each}}</textarea>
          <p class="mt-1 text-xs" style="color:var(--wp-text-muted);">Leave blank to keep a single fixed price/size (above). When set, shoppers get a size dropdown on the product page and the price updates per selection.</p>
        </div>

        <div>
          <label class="field-label" for="keyIngredients">Key Ingredients (one per line)</label>
          <textarea id="keyIngredients" name="keyIngredients" rows="4" class="input-field">{{#each product.keyIngredients}}{{this}}
{{/each}}</textarea>
        </div>

        <div>
          <label class="field-label" for="supports">Supports (one per line)</label>
          <textarea id="supports" name="supports" rows="4" class="input-field">{{#each product.supports}}{{this}}
{{/each}}</textarea>
        </div>
      </div>
    </div>
  </form>

  <div>
    <div class="wp-postbox">
      <div class="wp-postbox__header"><h2>Publish</h2></div>
      <div class="wp-postbox__body space-y-4">
        <label class="flex items-center gap-2 text-[13px]">
          <input type="checkbox" form="product-form" name="active" value="true" {{#unless isNew}}{{#if product.active}}checked{{/if}}{{else}}checked{{/unless}} />
          Active (visible in shop)
        </label>
        <div class="flex items-center gap-2">
          <button type="submit" form="product-form" class="wp-btn wp-btn-primary">Save Product</button>
          <a href="/admin/products" class="wp-btn">Cancel</a>
        </div>
      </div>
    </div>

    {{#unless isNew}}
    <div class="wp-postbox">
      <div class="wp-postbox__body">
        <form action="/admin/products/{{product._id}}/delete" method="post">
          <button type="submit" class="wp-btn wp-btn-danger wp-btn-sm">Deactivate this product</button>
        </form>
      </div>
    </div>
    {{/unless}}
  </div>
</div>
