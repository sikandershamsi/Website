<div class="wp-heading-inline">
  <h1>Products</h1>
  <a href="/admin/products/new" class="wp-btn wp-btn-primary">Add New</a>
</div>

<form method="get" class="wp-search-box mb-4">
  <input type="search" name="q" value="{{q}}" placeholder="Search products…" />
  <button type="submit" class="wp-btn">Search</button>
</form>

<div class="wp-list-table-wrap">
  {{#if products.length}}
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Slug</th>
        <th>Price</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each products}}
      <tr style="animation-delay:{{mul @index 30}}ms">
        <td>
          <a href="/admin/products/{{this._id}}/edit" class="wp-row-title">{{this.name}}</a>
          <div class="wp-row-actions">
            <a href="/admin/products/{{this._id}}/edit">Edit</a>
          </div>
        </td>
        <td>{{this.slug}}</td>
        <td>{{currency this.price}}</td>
        <td>
          {{#if this.active}}<span class="wp-badge wp-badge--success">Active</span>{{else}}<span class="wp-badge wp-badge--neutral">Inactive</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="wp-list-table-empty">No products found.</p>
  {{/if}}
</div>
