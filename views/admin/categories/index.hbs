<div class="flex items-center justify-between">
  <h1 class="font-display text-2xl font-medium text-al-navy">Categories</h1>
  <a href="/admin/categories/new" class="btn-primary !px-4 !py-2 text-sm">New Category</a>
</div>

<div class="mt-6 overflow-hidden rounded-none border border-al-line bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-al-panel text-xs font-semibold uppercase tracking-wide text-al-ink/60">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Slug</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-al-line">
      {{#each categories}}
      <tr>
        <td class="px-4 py-3 font-semibold text-al-navy">{{this.name}}</td>
        <td class="px-4 py-3 text-al-ink/60">{{this.slug}}</td>
        <td class="px-4 py-3 text-right">
          <a href="/admin/categories/{{this.slug}}/edit" class="text-xs font-semibold uppercase tracking-wide text-al-navy hover:underline">Edit</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
