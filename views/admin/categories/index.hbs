<div class="wp-heading-inline">
  <h1>Categories</h1>
  <a href="/admin/categories/new" class="wp-btn wp-btn-primary">Add New</a>
</div>

<div class="wp-list-table-wrap">
  {{#if categories.length}}
  <table class="wp-list-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Slug</th>
      </tr>
    </thead>
    <tbody>
      {{#each categories}}
      <tr style="animation-delay:{{mul @index 30}}ms">
        <td>
          <a href="/admin/categories/{{this.slug}}/edit" class="wp-row-title">{{this.name}}</a>
          <div class="wp-row-actions">
            <a href="/admin/categories/{{this.slug}}/edit">Edit</a>
          </div>
        </td>
        <td>{{this.slug}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="wp-list-table-empty">No categories found.</p>
  {{/if}}
</div>
