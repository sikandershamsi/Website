<section class="category-hero category-hero--{{category.accent}}">
  <figure class="category-hero__panel">
    <img
      src="{{category.panel}}?v=20260821a"
      srcset="{{category.panel}}?v=20260821a 1672w, {{category.image2x}}?v=20260821a 3344w"
      sizes="100vw"
      alt="{{category.name}} — {{category.summary}}"
      width="1672"
      height="941"
    />
  </figure>

  <div class="category-hero__compact">
    <div class="category-hero__copy">
      <div class="category-hero__rule" aria-hidden="true"></div>
      <h1 class="category-hero__title">{{category.name}}</h1>
      {{#if category.accentLabel}}
      <p class="category-hero__accent">{{category.accentLabel}}</p>
      {{/if}}
      {{#unless (eq category.accentLabel category.strapline)}}
      <p class="category-hero__pillars">{{category.strapline}}</p>
      {{/unless}}
      <p class="category-hero__body">{{category.summary}}</p>
    </div>
    <div class="category-hero__benefits">
      {{#each category.benefits}}
      <div class="category-hero__benefit">
        <div class="category-hero__icon">{{{icon this.icon "w-5 h-5"}}}</div>
        <div>
          <p class="category-hero__benefit-title">{{this.title}}</p>
          <p class="category-hero__benefit-body">{{this.body}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <div class="eyebrow">Products in this category</div>
    <h2 class="font-display mt-3 text-3xl font-medium text-al-navy sm:text-4xl">{{category.short}}</h2>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card product-card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="product-card__media-link border-b border-al-line bg-white p-8">
          {{> product-media image=this.image alt=this.trademark tagline=this.tagline}}
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <a href="/shop/product/{{this.slug}}" class="font-display text-base font-semibold text-al-navy hover:text-al-navy/70">{{this.trademark}}</a>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/50">{{this.category}}</p>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{truncate this.description 140}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <a href="/shop/product/{{this.slug}}" class="btn-outline !px-5 !py-2 text-xs">View Product</a>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    {{#if (eq products.length 0)}}
    <p class="text-sm text-al-ink/60">No products in this category yet.</p>
    {{/if}}

    <a href="/shop" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-al-navy hover:text-al-navy">Back to Shop All</a>
  </div>
</section>
