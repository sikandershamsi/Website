{{> page-header eyebrow=category.strapline heading=category.short subheading=category.summary image=category.image}}

<section class="panel-white">
  <div class="section">
    <div class="mb-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
      {{#each category.icons}}
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-al-panel text-al-navy">{{{icon "check" "w-5 h-5"}}}</div>
        <p class="mt-3 text-xs font-semibold text-al-navy">{{this}}</p>
      </div>
      {{/each}}
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="flex aspect-[4/5] items-center justify-center bg-al-panel p-8">
          <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-auto object-contain" />
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-base font-semibold text-al-navy">{{this.trademark}}</p>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <a href="/shop/product/{{this.slug}}" class="font-display mt-1 text-lg font-medium text-al-navy hover:text-al-orange">{{this.tagline}}</a>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{this.description}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <a href="/shop/product/{{this.slug}}" class="btn-outline !px-5 !py-2 text-xs">View Product</a>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    {{#if (eq products.length 0)}}
    <p class="text-sm text-al-ink/60">No products in this category yet.</p>
    {{/if}}

    <a href="/shop" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-al-navy hover:text-al-orange">Back to Shop All</a>
  </div>
</section>
