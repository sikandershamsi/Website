{{> page-header eyebrow=category.strapline heading=category.name subheading=category.summary}}

<section class="section">
  <div class="mb-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
    {{#each category.icons}}
    <div class="text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-al-navy/5 text-al-navy">{{{icon "check" "w-5 h-5"}}}</div>
      <p class="mt-3 text-xs font-semibold text-al-navy">{{this}}</p>
    </div>
    {{/each}}
  </div>

  <div class="grid gap-8 md:grid-cols-3">
    {{#each products}}
    <div class="card flex flex-col overflow-hidden">
      <a href="/shop/product/{{this.slug}}" class="flex h-44 items-center justify-center bg-gradient-to-br from-al-orange to-al-orange-light p-6 text-white">
        <div class="text-center">
          <p class="font-display text-2xl font-semibold">{{this.trademark}}</p>
          <p class="mt-1 text-xs uppercase tracking-wider text-white/80">{{this.size}}</p>
        </div>
      </a>
      <div class="flex flex-1 flex-col p-6">
        <a href="/shop/product/{{this.slug}}" class="font-display text-lg font-medium text-al-navy hover:text-al-orange">{{this.tagline}}</a>
        <p class="mt-3 flex-1 text-sm text-al-ink/65">{{this.description}}</p>
        <div class="mt-5 flex items-center justify-between">
          <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
          <a href="/shop/product/{{this.slug}}" class="btn-outline !px-5 !py-2 text-xs">View Product</a>
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  {{#if (eq products.length 0)}}
  <p class="text-sm text-al-ink/60">No products in this category yet.</p>
  {{/if}}

  <a href="/shop" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-al-navy hover:text-al-orange">{{{icon "arrow-right" "w-4 h-4 rotate-180"}}} Back to Shop All</a>
</section>
