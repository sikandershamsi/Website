<section class="section grid gap-12 lg:grid-cols-2 lg:items-start">
  <div class="flex aspect-[4/5] items-center justify-center rounded-2xl border border-al-line bg-white p-10 lg:sticky lg:top-28">
    <img src="{{product.image}}" alt="{{product.trademark}}" class="max-h-full w-auto max-w-full object-contain" />
  </div>

  <div>
    {{#ifCond product.slug "vetrofit"}}
    <p class="text-xs font-semibold uppercase tracking-wide text-al-orange">2–4 Hours Before Competition</p>
    {{else}}
    <p class="text-xs font-semibold uppercase tracking-wide text-al-orange">{{product.category}}</p>
    {{/ifCond}}
    <h1 class="font-display mt-3 text-3xl font-medium text-al-navy sm:text-4xl">{{product.trademark}}</h1>
    <p class="mt-2 text-lg text-al-ink/70">{{product.tagline}}</p>
    <div class="mt-4 flex items-center gap-1 text-al-orange">
      {{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}
      <span class="ml-2 text-xs font-semibold text-al-ink/60">{{reviews.length}} reviews</span>
    </div>
    <p class="font-display mt-5 text-2xl font-medium text-al-navy">{{currency product.price}}</p>
    <p class="mt-5 text-sm leading-relaxed text-al-ink/75">{{product.description}}</p>

    <form action="/cart/add" method="post" class="mt-7 flex flex-wrap items-center gap-4">
      <input type="hidden" name="slug" value="{{product.slug}}" />
      <label class="field-label sr-only" for="qty">Quantity</label>
      <input id="qty" type="number" name="qty" value="1" min="1" class="input-field w-20 text-center" />
      <button type="submit" class="btn-primary">Add to Cart</button>
      <a href="/shop/product/{{product.slug}}#ingredients" class="btn-outline">Learn More</a>
    </form>

    <div class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Supports</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {{#each product.supports}}
        <span class="tag-pill">{{this}}</span>
        {{/each}}
      </div>
    </div>

    <div class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Key Ingredients</p>
      <ul class="mt-3 space-y-1.5 text-sm text-al-ink/70">
        {{#each product.keyIngredients}}
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}{{this}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="card p-7">
        <div class="eyebrow">Product</div>
        <p class="mt-3 text-sm font-medium leading-relaxed text-al-navy">{{product.whatItIs.summary}}</p>
        {{#if product.whatItIs.points.length}}
        <ul class="mt-4 space-y-2 text-sm text-al-ink/70">
          {{#each product.whatItIs.points}}
          <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}{{this}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      <div class="card p-7">
        <div class="eyebrow">Outcomes</div>
        <p class="mt-3 text-sm font-medium leading-relaxed text-al-navy">{{product.outcomes.summary}}</p>
        <ul class="mt-4 space-y-2 text-sm text-al-ink/70">
          {{#each product.outcomes.points}}
          <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}{{this}}</li>
          {{/each}}
        </ul>
      </div>
      <div class="card p-7">
        <div class="eyebrow">Impact</div>
        {{#if product.impact.summary}}
        <p class="mt-3 text-sm font-medium leading-relaxed text-al-navy">{{product.impact.summary}}</p>
        {{/if}}
        <ul class="mt-4 space-y-2 text-sm text-al-ink/70">
          {{#each product.impact.points}}
          <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>

    <div class="mt-8 rounded-2xl bg-al-navy p-8 text-white sm:p-10">
      <div class="eyebrow !text-al-orange-light">The Animalife Difference</div>
      <p class="font-display mt-4 text-xl font-medium leading-snug sm:text-2xl">{{product.animalifeDifference}}</p>
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section max-w-4xl">
    <h2 class="font-display text-2xl font-medium text-al-navy sm:text-3xl">{{product.physiologyPanel.heading}}</h2>
    <p class="mt-4 text-sm leading-relaxed text-al-ink/75">{{product.physiologyPanel.body}}</p>
    <a href="#ingredients" class="btn-outline mt-6">See the Ingredient Chart</a>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:items-start">
      <div>
        <h2 class="font-display text-2xl font-medium leading-snug text-al-navy sm:text-3xl">{{product.comparison.headline}}</h2>
        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-al-orange">{{product.comparison.subheadline}}</p>
        {{#each product.comparison.intro}}
        <p class="mt-4 text-sm leading-relaxed text-al-ink/75">{{this}}</p>
        {{/each}}
      </div>
      <div class="overflow-hidden rounded-2xl border border-al-line bg-white">
        <div class="grid grid-cols-2">
          <div class="bg-al-navy p-4 text-white">
            <p class="font-display text-sm font-semibold">{{product.comparison.ourLabel}}</p>
            <p class="mt-1 text-[11px] leading-snug text-white/70">{{product.comparison.ourSubLabel}}</p>
          </div>
          <div class="bg-al-ink p-4 text-white">
            <p class="font-display text-sm font-semibold">{{product.comparison.otherLabel}}</p>
            <p class="mt-1 text-[11px] leading-snug text-white/70">{{product.comparison.otherSubLabel}}</p>
          </div>
        </div>
        {{#each product.comparison.rows}}
        <div class="grid grid-cols-2 border-t border-al-line">
          <div class="p-4 sm:p-5">
            <p class="text-xs font-semibold text-al-navy">{{this.title}}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-al-ink/65">{{this.body}}</p>
          </div>
          <div class="border-l border-al-line bg-al-panel p-4 sm:p-5">
            <p class="text-xs font-semibold text-al-ink/70">{{this.otherTitle}}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-al-ink/55">{{this.otherBody}}</p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

{{#ifCond product.slug "vetrofit"}}
<section class="panel-grey">
  <div class="section">
    <div class="overflow-hidden rounded-2xl">
      <img src="/images/vetrofit/page-panel-a.jpg" alt="VetroFit banner and product story" class="w-full object-contain" />
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="eyebrow">Testimonials</div>
        <h2 class="font-display mt-4 text-3xl font-medium text-al-navy">What riders &amp; trainers are saying</h2>
      </div>
      <div class="flex gap-2">
        <button type="button" data-testimonial-prev class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
        <button type="button" data-testimonial-next class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
      </div>
    </div>
    <div class="mt-8 overflow-hidden" data-testimonial-slider>
      <div class="slider-track" data-testimonial-track>
        {{#each vetrofitTestimonials}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-testimonial-slide>
          <div class="card h-full bg-al-panel p-6">
            <p class="text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy">{{this.author}}</p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="overflow-hidden rounded-2xl bg-white">
      <img src="/images/vetrofit/page-panel-b.jpg" alt="VetroFit primary ingredients and science" class="w-full object-contain" />
    </div>
  </div>
</section>
{{/ifCond}}

<section class="panel-grey" id="ingredients">
  <div class="section">
    <div data-tabs>
      <div class="flex gap-8 overflow-x-auto border-b border-al-line">
        <button type="button" data-tab-btn="description" class="tab-btn is-active whitespace-nowrap">Description</button>
        <button type="button" data-tab-btn="ingredients" class="tab-btn whitespace-nowrap">Ingredients &amp; Benefits</button>
        <button type="button" data-tab-btn="feeding" class="tab-btn whitespace-nowrap">Feeding Instructions</button>
        <button type="button" data-tab-btn="faq" class="tab-btn whitespace-nowrap">FAQ&rsquo;s</button>
        <button type="button" data-tab-btn="horseiq" class="tab-btn whitespace-nowrap">Horse IQ</button>
      </div>

      <div data-tab-panel="description" class="max-w-3xl py-10">
        <p class="text-sm leading-relaxed text-al-ink/75">{{product.description}}</p>
      </div>

      <div data-tab-panel="ingredients" class="hidden py-10">
        {{#with (lookup product.ingredientBenefits 0) as |row|}}
        <div class="grid gap-6 md:grid-cols-3">
          <div class="card p-6"><p class="text-xs font-semibold uppercase tracking-wide text-al-orange">Ingredients</p><p class="mt-2 text-sm text-al-ink/75">{{row.ingredient}}</p></div>
          <div class="card p-6"><p class="text-xs font-semibold uppercase tracking-wide text-al-orange">Ingredient Benefits</p><p class="mt-2 text-sm text-al-ink/75">{{row.benefit}}</p></div>
          <div class="card p-6"><p class="text-xs font-semibold uppercase tracking-wide text-al-orange">Performance Benefits</p><p class="mt-2 text-sm text-al-ink/75">{{row.performance}}</p></div>
        </div>
        <div class="card mt-6 p-6"><p class="text-xs font-semibold uppercase tracking-wide text-al-orange">Long-Term Health &amp; Wellness</p><p class="mt-2 text-sm text-al-ink/75">{{row.wellness}}</p></div>
        {{/with}}

        {{#if product.primaryIngredients}}
        <div class="mt-10">
          <p class="font-display text-lg font-medium text-al-navy">{{product.trademark}} Primary Ingredients</p>
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {{#each product.primaryIngredients}}
            <div class="rounded-xl border border-al-line bg-white p-4 text-center">
              <p class="text-xs font-semibold text-al-navy">{{this.name}}</p>
              <p class="mt-1 text-[10px] uppercase tracking-wide text-al-ink/45">Origin: {{this.origin}}</p>
            </div>
            {{/each}}
          </div>
          <p class="mt-6 text-center text-xs font-semibold uppercase tracking-wide text-al-ink/50">{{product.primaryIngredientsFooter}}</p>
        </div>
        {{/if}}
      </div>

      <div data-tab-panel="feeding" class="hidden max-w-4xl py-10">
        {{#each product.feedingIntro}}
        <p class="mt-2 text-sm leading-relaxed text-al-ink/75 first:mt-0">{{this}}</p>
        {{/each}}

        <div class="mt-8 overflow-x-auto rounded-2xl border border-al-line">
          <table class="w-full min-w-[500px] border-collapse text-left text-sm">
            <thead>
              <tr class="bg-al-navy text-white">
                {{#each product.feedingColumns}}
                <th class="px-4 py-3 font-semibold">{{this}}</th>
                {{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each product.feedingRows}}
              <tr class="border-t border-al-line odd:bg-white even:bg-al-cream-dark/30">
                <td class="px-4 py-3 font-semibold text-al-navy">{{this.size}}</td>
                <td class="px-4 py-3 text-al-ink/70">{{this.weight}}</td>
                {{#each ../product.feedingValueKeys}}
                <td class="px-4 py-3 text-al-ink/70">{{pick ../this this}}</td>
                {{/each}}
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="mt-8">
          <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Additional Information</p>
          <ul class="mt-3 space-y-1.5 text-sm text-al-ink/70">
            {{#each product.feedingNotes}}
            <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-orange shrink-0"}}}{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div data-tab-panel="faq" class="hidden max-w-3xl py-10">
        <div class="space-y-3">
          {{#each product.faqs}}
          <div data-accordion-item class="card overflow-hidden">
            <button type="button" data-accordion-trigger class="flex w-full items-center justify-between gap-4 p-5 text-left">
              <span class="font-display text-base font-medium text-al-navy">{{this.question}}</span>
              {{{icon "chevron-down" "w-5 h-5 shrink-0 text-al-navy transition-transform" }}}
            </button>
            <div data-accordion-panel class="hidden px-5 pb-5 text-sm leading-relaxed text-al-ink/70">{{this.answer}}</div>
          </div>
          {{/each}}
        </div>
      </div>

      <div data-tab-panel="horseiq" class="hidden max-w-3xl py-10">
        <p class="text-sm leading-relaxed text-al-ink/75">Explore the podcasts, videos, white papers, and infographics behind {{product.trademark}}&mdash;straight from the Animalife science team.</p>
        <a href="/horse-iq" class="btn-outline mt-6">Browse Horse IQ</a>
      </div>
    </div>
  </div>
</section>

{{#if reviews.length}}
<section class="section">
  <div class="eyebrow">Testimonials</div>
  <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">What riders are saying.</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {{#each reviews}}
    <div class="card p-6">
      <div class="flex gap-0.5 text-al-orange">{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}</div>
      <p class="mt-4 text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
      <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy">{{this.author}}</p>
    </div>
    {{/each}}
  </div>
</section>
{{/if}}

<section class="bg-al-cream-dark/60">
  <div class="section">
    <div class="eyebrow">Complete the System</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Explore the other formulations.</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {{#each related}}
      <a href="/shop/product/{{this.slug}}" class="card group flex items-center gap-5 p-5 transition-shadow hover:shadow-lg">
        <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-al-cream-dark/50">
          <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-full object-contain p-1.5" />
        </div>
        <div>
          <p class="font-display text-base font-medium text-al-navy group-hover:text-al-orange">{{this.tagline}}</p>
          <p class="mt-1 text-xs uppercase tracking-wide text-al-ink/50">{{this.category}}</p>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>
