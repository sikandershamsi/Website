                  <th class="physio-chart__th physio-chart__th--physiology">{{lookup product.physiologyBenefits.columns 2}}</th>
                  <th class="physio-chart__th physio-chart__th--performance">{{lookup product.physiologyBenefits.columns 3}}</th>
                  <th class="physio-chart__th physio-chart__th--wellness">{{lookup product.physiologyBenefits.columns 4}}</th>
                </tr>
              </thead>
              <tbody>
                {{#each product.physiologyBenefits.rows}}
                <tr>
                  <td class="physio-chart__icon-cell">
                    <span class="physio-chart__icon">{{{icon this.icon "w-7 h-7"}}}</span>
                  </td>
                  <td class="physio-chart__system">{{this.system}}</td>
                  <td class="physio-chart__nutrition">{{this.nutrition}}</td>
                  <td class="physio-chart__list physio-chart__list--physiology">
                    <ul>
                      {{#each this.physiology}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                  <td class="physio-chart__list physio-chart__list--performance">
                    <ul>
                      {{#each this.performance}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                  <td class="physio-chart__list physio-chart__list--wellness">
                    <ul>
                      {{#each this.wellness}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{#if product.physiologyBenefits.callouts}}
          <div class="physio-chart__callouts">
            {{#each product.physiologyBenefits.callouts}}
            <div class="physio-chart__callout">
              <div class="physio-chart__callout-icon">{{{icon this.icon "w-6 h-6"}}}</div>
              <p class="physio-chart__callout-text">{{this.text}}</p>
            </div>
            {{/each}}
          </div>
          {{/if}}
          <p class="physio-chart__disclaimer">
            {{{icon "leaf" "w-3.5 h-3.5"}}}
            <span>{{product.physiologyBenefits.disclaimer}}</span>
          </p>
        </div>
        {{/if}}
        {{else}}
        {{#with (lookup product.ingredientBenefits 0) as |row|}}
        <div class="pi-benefit-table">
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Ingredients</p>
            <p class="pi-benefit-table__body">{{row.ingredient}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Ingredient Benefits</p>
            <p class="pi-benefit-table__body">{{row.benefit}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Performance Benefits</p>
            <p class="pi-benefit-table__body">{{row.performance}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Long-Term Benefits</p>
            <p class="pi-benefit-table__body">{{row.wellness}}</p>
          </div>
        </div>
        {{/with}}

        {{#if product.primaryIngredients}}
        <div class="pi-board">
          <p class="pi-board__brand">{{product.trademark}}</p>
          <h3 class="pi-board__title">Primary Ingredients</h3>
          <div class="pi-board__rule" aria-hidden="true"></div>
          <ul class="pi-board__grid">
            {{#each product.primaryIngredients}}
            <li class="pi-board__item">
              <div class="pi-board__media">
                <img src="{{this.image}}" alt="{{this.name}}" width="640" height="640" loading="lazy" />
              </div>
              <p class="pi-board__name">{{this.name}}</p>
              <div class="pi-board__item-rule" aria-hidden="true"></div>
              <p class="pi-board__origin">Origin: {{this.origin}}</p>
            </li>
            {{/each}}
          </ul>
          <p class="pi-board__footer">{{product.primaryIngredientsFooter}}</p>
        </div>
        {{/if}}
        {{/if}}
      </div>

      <div data-tab-panel="feeding" class="hidden max-w-4xl py-10" id="feeding">
        {{#each product.feedingIntro}}
        <p class="mt-2 text-sm leading-relaxed text-al-ink/75 first:mt-0">{{this}}</p>
        {{/each}}

        <div class="mt-8 overflow-x-auto rounded-none border border-al-line">
          <table class="w-full min-w-[500px] border-collapse text-left text-sm">
            <thead>
              <tr class="bg-al-navy text-white">
                {{#each product.feedingColumns}}
                <th class="px-4 py-3 font-semibold">{{this}}</th>
                {{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each product.feedingRows}}
              <tr class="border-t border-al-line odd:bg-white even:bg-al-panel">
                <td class="px-4 py-3 font-semibold text-al-navy">{{this.size}}</td>
                <td class="px-4 py-3 text-al-ink/70">{{this.weight}}</td>
                {{#each ../product.feedingValueKeys}}
                <td class="px-4 py-3 text-al-ink/70">{{pick ../this this}}</td>
                {{/each}}
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="mt-8">
          <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Additional Information</p>
          <ul class="mt-3 space-y-1.5 text-sm text-al-ink/70">
            {{#each product.feedingNotes}}
            <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div data-tab-panel="faq" class="hidden max-w-3xl py-10">
        <div class="space-y-3">
          {{#each product.faqs}}
          <div data-accordion-item class="card overflow-hidden">
            <button type="button" data-accordion-trigger class="flex w-full items-center justify-between gap-4 p-5 text-left">
              <span class="font-display text-base font-medium text-al-navy">{{this.question}}</span>
              {{{icon "chevron-down" "w-5 h-5 shrink-0 text-al-navy transition-transform" }}}
            </button>
            <div data-accordion-panel class="hidden px-5 pb-5 text-sm leading-relaxed text-al-ink/70">{{this.answer}}</div>
          </div>
          {{/each}}
        </div>
      </div>

      <div data-tab-panel="horseiq" class="hidden max-w-3xl py-10">
        <p class="text-sm leading-relaxed text-al-ink/75">Explore the podcasts, videos, white papers, and infographics behind {{product.trademark}}&mdash;straight from the Animalife science team.</p>
        <a href="/horse-iq" class="btn-outline mt-6">Browse Horse IQ</a>
      </div>
    </div>
  </div>
</section>



