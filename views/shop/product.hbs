<section class="section grid gap-12 lg:grid-cols-2 lg:items-start">
  <div class="flex aspect-[4/5] items-center justify-center rounded-none border border-al-line bg-white p-10 lg:sticky lg:top-28">
    <img src="{{product.image}}" alt="{{product.trademark}}" class="max-h-full w-auto max-w-full object-contain" />
  </div>

  <div>
    {{#ifCond product.slug "vetrofit"}}
    <p class="text-xs font-semibold uppercase tracking-wide text-al-navy/55">2–4 Hours Before Competition</p>
    {{else}}
    <p class="text-xs font-semibold uppercase tracking-wide text-al-navy/55">{{product.category}}</p>
    {{/ifCond}}
    <h1 class="font-display mt-3 text-3xl font-medium text-al-navy sm:text-4xl">{{product.trademark}}</h1>
    <p class="mt-2 text-lg text-al-ink/70">{{product.tagline}}</p>
    <div class="mt-4 flex items-center gap-1 text-al-navy/55">
      {{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}
      <span class="ml-2 text-xs font-semibold text-al-ink/60">{{reviews.length}} reviews</span>
    </div>
    <p class="font-display mt-5 text-2xl font-medium text-al-navy">{{currency product.price}}</p>
    <p class="mt-5 text-sm leading-relaxed text-al-ink/75">{{product.description}}</p>

    <form action="/cart/add" method="post" class="mt-7 flex flex-wrap items-center gap-4">
      <input type="hidden" name="slug" value="{{product.slug}}" />
      <label class="field-label sr-only" for="qty">Quantity</label>
      <input id="qty" type="number" name="qty" value="1" min="1" class="input-field w-20 text-center" />
      <button type="submit" class="btn-primary">Add to Cart</button>
      <a href="/shop/product/{{product.slug}}#ingredients" class="btn-outline">Learn More</a>
    </form>

    <div class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Supports</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {{#each product.supports}}
        <span class="tag-pill">{{this}}</span>
        {{/each}}
      </div>
    </div>

    <div class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Key Ingredients</p>
      <ul class="mt-3 space-y-1.5 text-sm text-al-ink/70">
        {{#each product.keyIngredients}}
        <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}{{this}}</li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>

{{#unless (eq product.slug "vetrofen")}}
<section class="panel-white">
  <div class="section max-w-4xl">
    <h2 class="font-display text-2xl font-medium text-al-navy sm:text-3xl">{{product.physiologyPanel.heading}}</h2>
    <p class="mt-4 text-sm leading-relaxed text-al-ink/75">{{product.physiologyPanel.body}}</p>
  </div>
</section>
{{/unless}}

<section class="panel-grey" id="ingredients">
  <div class="section">
    <div data-tabs>
      <div class="flex gap-8 overflow-x-auto border-b border-al-line">
        <button type="button" data-tab-btn="description" class="tab-btn is-active whitespace-nowrap">Description</button>
        <button type="button" data-tab-btn="ingredients" class="tab-btn whitespace-nowrap">Ingredients &amp; Benefits</button>
        <button type="button" data-tab-btn="feeding" class="tab-btn whitespace-nowrap">Feeding Instructions</button>
        <button type="button" data-tab-btn="faq" class="tab-btn whitespace-nowrap">FAQ&rsquo;s</button>
        <button type="button" data-tab-btn="horseiq" class="tab-btn whitespace-nowrap">Horse IQ</button>
      </div>

      <div data-tab-panel="description" class="py-10">
        <p class="max-w-3xl text-sm leading-relaxed text-al-ink/75">{{product.description}}</p>

        {{#if product.inflammationShowcase}}
        <article class="vfen-inflam mt-10">
          <div class="vfen-inflam__grid">
            <div class="vfen-inflam__visuals">
              <figure class="vfen-inflam__anatomy">
                <img
                  src="{{product.inflammationShowcase.anatomyImage}}"
                  alt="{{product.trademark}} equine anatomy highlighting joint inflammation points"
                  width="1200"
                  height="348"
                  loading="lazy"
                />
              </figure>
              <div class="vfen-inflam__tissues">
                <figure class="vfen-inflam__tissue">
                  <span class="vfen-inflam__bar vfen-inflam__bar--healthy">{{product.inflammationShowcase.tissueHealthy.barLabel}}</span>
                  <span class="vfen-inflam__tag vfen-inflam__tag--healthy">{{product.inflammationShowcase.tissueHealthy.tagLabel}}</span>
                  <img
                    src="{{product.inflammationShowcase.tissueHealthy.image}}"
                    alt="Healthy tissue"
                    width="700"
                    height="467"
                    loading="lazy"
                  />
                </figure>
                <figure class="vfen-inflam__tissue">
                  <span class="vfen-inflam__bar vfen-inflam__bar--inflamed">{{product.inflammationShowcase.tissueInflamed.barLabel}}</span>
                  <span class="vfen-inflam__tag vfen-inflam__tag--inflamed">{{product.inflammationShowcase.tissueInflamed.tagLabel}}</span>
                  <img
                    src="{{product.inflammationShowcase.tissueInflamed.image}}"
                    alt="Inflamed tissue"
                    width="700"
                    height="509"
                    loading="lazy"
                  />
                </figure>
              </div>
            </div>

            <div class="vfen-inflam__detail">
              <div class="vfen-inflam__block">
                <p class="vfen-inflam__eyebrow">Product <span>({{product.inflammationShowcase.productLabel}})</span></p>
                <p class="vfen-inflam__body">{{product.whatItIs.summary}}</p>
              </div>
              <div class="vfen-inflam__block">
                <p class="vfen-inflam__eyebrow">Outcomes <span>({{product.inflammationShowcase.outcomesLabel}})</span></p>
                <p class="vfen-inflam__body">{{product.outcomes.summary}}</p>
                <ul class="vfen-inflam__list">
                  {{#each product.outcomes.points}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </div>
              <div class="vfen-inflam__block">
                <p class="vfen-inflam__eyebrow">Impact <span>({{product.inflammationShowcase.impactLabel}})</span></p>
                <ul class="vfen-inflam__list">
                  {{#each product.impact.points}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </div>
              <ul class="vfen-inflam__callouts">
                {{#each product.inflammationShowcase.callouts}}
                <li class="vfen-inflam__callout">
                  <img class="vfen-inflam__callout-icon" src="{{this.icon}}" alt="" width="48" height="48" loading="lazy" />
                  <p class="vfen-inflam__callout-text">{{this.text}}</p>
                </li>
                {{/each}}
              </ul>
            </div>
          </div>

          <div class="vfen-inflam__difference">
            <p class="vfen-inflam__eyebrow">The Animalife Difference</p>
            <p class="vfen-inflam__difference-text">{{product.animalifeDifference}}</p>
          </div>
        </article>
        {{/if}}

        {{#if product.descriptionShowcase}}
        <article class="vf-desc mt-10">
          <div class="vf-desc__grid">
            <div class="vf-desc__copy">
              <p class="vf-desc__logo">{{product.name}}</p>
              <p class="vf-desc__brand">{{product.descriptionShowcase.brandLine}}</p>
              <h3 class="vf-desc__headline">
                {{#each product.descriptionShowcase.headline}}
                <span class="vf-desc__line{{#if this.accent}} vf-desc__line--accent{{/if}}">{{this.text}}</span>
                {{/each}}
              </h3>
              <p class="vf-desc__intro">{{product.descriptionShowcase.intro}}</p>
              <ul class="vf-desc__benefits">
                {{#each product.descriptionShowcase.benefits}}
                <li class="vf-desc__benefit">
                  <img class="vf-desc__benefit-icon" src="{{this.icon}}" alt="" width="48" height="48" loading="lazy" />
                  <p class="vf-desc__benefit-text">{{{this.html}}}</p>
                </li>
                {{/each}}
              </ul>
            </div>

            <div class="vf-desc__visuals">
              <figure class="vf-desc__anatomy">
                <img
                  src="{{product.descriptionShowcase.anatomyImage}}"
                  alt="{{product.trademark}} equine anatomy highlighting oxygen-delivery systems"
                  width="704"
                  height="380"
                  loading="lazy"
                />
              </figure>
              <div class="vf-desc__lungs">
                <figure class="vf-desc__lung">
                  <span class="vf-desc__lung-label vf-desc__lung-label--healthy">{{product.descriptionShowcase.lungsHealthy.label}}</span>
                  <img
                    src="{{product.descriptionShowcase.lungsHealthy.image}}"
                    alt="Healthy equine lungs"
                    width="900"
                    height="658"
                    loading="lazy"
                  />
                </figure>
                <figure class="vf-desc__lung">
                  <span class="vf-desc__lung-label vf-desc__lung-label--eiph">{{product.descriptionShowcase.lungsEiph.label}}</span>
                  <img
                    src="{{product.descriptionShowcase.lungsEiph.image}}"
                    alt="Equine lungs with exercise-induced pulmonary hemorrhage"
                    width="900"
                    height="658"
                    loading="lazy"
                  />
                </figure>
              </div>
            </div>

            <div class="vf-desc__detail">
              <div class="vf-desc__block">
                <p class="vf-desc__eyebrow">Product</p>
                <p class="vf-desc__body">{{product.whatItIs.summary}}</p>
              </div>
              <div class="vf-desc__block">
                <p class="vf-desc__eyebrow">Outcomes</p>
                <p class="vf-desc__body">{{product.outcomes.summary}}</p>
                <ul class="vf-desc__list">
                  {{#each product.outcomes.points}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </div>
              <div class="vf-desc__block">
                <p class="vf-desc__eyebrow">Impact</p>
                {{#if product.impact.summary}}
                <p class="vf-desc__body">{{product.impact.summary}}</p>
                {{/if}}
                <ul class="vf-desc__list">
                  {{#each product.impact.points}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </div>
            </div>

            <div class="vf-desc__difference">
              <p class="vf-desc__eyebrow">The Animalife Difference</p>
              <p class="vf-desc__difference-text">{{product.animalifeDifference}}</p>
            </div>
          </div>
        </article>
        {{/if}}

        {{#if product.controlShowcase}}
        <article class="vfen-control mt-10">
          <div class="vfen-control__grid">
            <div class="vfen-control__aside">
              <p class="vfen-control__logo">{{product.name}}<span class="vfen-control__reg">®</span></p>
              <p class="vfen-control__brand">{{product.controlShowcase.brandLine}}</p>
              <p class="vfen-control__tagline">{{product.controlShowcase.tagline}}</p>
              <p class="vfen-control__intro">{{product.controlShowcase.intro}}</p>
              <figure class="vfen-control__product">
                <img
                  src="{{product.controlShowcase.productImage}}"
                  alt="{{product.trademark}} tub"
                  width="480"
                  height="502"
                  loading="lazy"
                />
              </figure>
              <h3 class="vfen-control__heading">{{product.controlShowcase.controlHeading}}</h3>
              <p class="vfen-control__body">{{product.controlShowcase.controlBody}}</p>
              <p class="vfen-control__helps">{{product.controlShowcase.helpsHeading}}</p>
              <ul class="vfen-control__benefits">
                {{#each product.controlShowcase.benefits}}
                <li class="vfen-control__benefit">
                  <span class="vfen-control__benefit-icon">{{{icon this.icon "w-5 h-5"}}}</span>
                  <p class="vfen-control__benefit-text">{{{this.html}}}</p>
                </li>
                {{/each}}
              </ul>
            </div>

            <div class="vfen-control__diagram-wrap">
              <div class="vfen-control__diagram">
                <img
                  class="vfen-control__diagram-img"
                  src="{{product.controlShowcase.diagramImage}}"
                  alt="{{product.trademark}} inflammation and recovery support diagram"
                  width="1100"
                  height="1170"
                  loading="lazy"
                />
                <ul class="vfen-control__callouts">
                  {{#each product.controlShowcase.callouts}}
                  <li class="vfen-control__callout vfen-control__callout--{{this.slot}}">
                    <span class="vfen-control__num">{{this.num}}</span>
                    <div class="vfen-control__callout-copy">
                      <p class="vfen-control__callout-title">{{this.title}}</p>
                      <p class="vfen-control__callout-body">{{this.body}}</p>
                    </div>
                  </li>
                  {{/each}}
                </ul>
              </div>

              <ol class="vfen-control__callout-list">
                {{#each product.controlShowcase.callouts}}
                <li class="vfen-control__callout-list-item">
                  <span class="vfen-control__num">{{this.num}}</span>
                  <div>
                    <p class="vfen-control__callout-title">{{this.title}}</p>
                    <p class="vfen-control__callout-body">{{this.body}}</p>
                  </div>
                </li>
                {{/each}}
              </ol>
            </div>
          </div>
        </article>
        {{/if}}

        {{#if product.kidneyShowcase}}
        <article class="vf-kidney mt-10">
          <div class="vf-kidney__grid">
            <div class="vf-kidney__aside">
              <p class="vf-kidney__logo">{{product.name}}<span class="vf-kidney__reg">®</span></p>
              <p class="vf-kidney__tagline">{{product.kidneyShowcase.tagline}}</p>
              <p class="vf-kidney__intro">{{product.kidneyShowcase.intro}}</p>
              <figure class="vf-kidney__syringe">
                <img
                  src="{{product.kidneyShowcase.syringeImage}}"
                  alt="{{product.trademark}} oral syringe"
                  width="600"
                  height="150"
                  loading="lazy"
                />
              </figure>
              <h3 class="vf-kidney__control-heading">{{product.kidneyShowcase.controlHeading}}</h3>
              <p class="vf-kidney__control-body">{{product.kidneyShowcase.controlBody}}</p>
              <p class="vf-kidney__helps">{{product.kidneyShowcase.helpsHeading}}</p>
              <ul class="vf-kidney__benefits">
                {{#each product.kidneyShowcase.benefits}}
                <li class="vf-kidney__benefit">
                  <img class="vf-kidney__benefit-icon" src="{{this.icon}}" alt="" width="40" height="40" loading="lazy" />
                  <p class="vf-kidney__benefit-text">{{{this.html}}}</p>
                </li>
                {{/each}}
              </ul>
            </div>

            <div class="vf-kidney__diagram-wrap">
              <div class="vf-kidney__diagram">
                <img
                  class="vf-kidney__diagram-img"
                  src="{{product.kidneyShowcase.diagramImage}}"
                  alt="{{product.trademark}} kidney homeostasis diagram"
                  width="1100"
                  height="1010"
                  loading="lazy"
                />
                <ul class="vf-kidney__callouts">
                  {{#each product.kidneyShowcase.callouts}}
                  <li class="vf-kidney__callout vf-kidney__callout--{{this.slot}}">
                    <span class="vf-kidney__num">{{this.num}}</span>
                    <div class="vf-kidney__callout-copy">
                      <p class="vf-kidney__callout-title">{{this.title}}</p>
                      <p class="vf-kidney__callout-body">{{this.body}}</p>
                    </div>
                  </li>
                  {{/each}}
                </ul>
              </div>

              <ol class="vf-kidney__callout-list">
                {{#each product.kidneyShowcase.callouts}}
                <li class="vf-kidney__callout-list-item">
                  <span class="vf-kidney__num">{{this.num}}</span>
                  <div>
                    <p class="vf-kidney__callout-title">{{this.title}}</p>
                    <p class="vf-kidney__callout-body">{{this.body}}</p>
                  </div>
                </li>
                {{/each}}
              </ol>
            </div>
          </div>
        </article>
        {{/if}}

        {{#if product.comparisonShowcase}}
        <article class="vf-compare mt-10{{#ifCond product.slug "vetrofen"}} vf-compare--red{{/ifCond}}">
          {{#ifCond product.slug "vetrofen"}}
          <div class="vf-compare__banner">
            <p class="vf-compare__banner-title">{{product.trademark}}</p>
            <p class="vf-compare__banner-sub">Feel the Difference</p>
          </div>
          {{/ifCond}}
          <div class="vf-compare__grid">
            <div class="vf-compare__aside">
              <h3 class="vf-compare__headline">{{product.comparison.headline}}</h3>
              <p class="vf-compare__subhead">
                <span>{{product.comparisonShowcase.subheadlineLead}}</span>
                <span class="vf-compare__subhead-accent">{{product.comparisonShowcase.subheadlineAccent}}</span>
              </p>
              <p class="vf-compare__body">{{product.comparisonShowcase.body}}</p>
              <figure class="vf-compare__hero">
                <img
                  src="{{product.comparisonShowcase.heroImage}}"
                  alt="Racehorse and jockey in full stride"
                  width="720"
                  height="900"
                  loading="lazy"
                />
              </figure>
              <ul class="vf-compare__features">
                {{#each product.comparisonShowcase.features}}
                <li class="vf-compare__feature">
                  <img class="vf-compare__feature-icon" src="{{this.icon}}" alt="" width="48" height="48" loading="lazy" />
                  <p class="vf-compare__feature-label">{{this.label}}</p>
                </li>
                {{/each}}
              </ul>
            </div>

            <div class="vf-compare__table">
              <div class="vf-compare__heads">
                <div class="vf-compare__head vf-compare__head--our">
                  <p class="vf-compare__head-title">{{product.comparison.ourLabel}}</p>
                  <p class="vf-compare__head-sub">{{product.comparison.ourSubLabel}}</p>
                </div>
                <div class="vf-compare__head-gap" aria-hidden="true"></div>
                <div class="vf-compare__head vf-compare__head--other">
                  <p class="vf-compare__head-title">{{product.comparison.otherLabel}}</p>
                  <p class="vf-compare__head-sub">{{product.comparison.otherSubLabel}}</p>
                </div>
              </div>

              <ul class="vf-compare__rows">
                {{#each product.comparison.rows}}
                {{#with (lookup ../product.comparisonShowcase.rows @index)}}
                <li class="vf-compare__row">
                  <div class="vf-compare__side vf-compare__side--our">
                    <img class="vf-compare__circle" src="{{this.ourImage}}" alt="" width="200" height="200" loading="lazy" />
                    <div class="vf-compare__copy">
                      <p class="vf-compare__title">{{../title}}</p>
                      <p class="vf-compare__text">{{../body}}</p>
                    </div>
                  </div>
                  <span class="vf-compare__vs" aria-hidden="true">vs.</span>
                  <div class="vf-compare__side vf-compare__side--other">
                    <img class="vf-compare__circle" src="{{this.otherImage}}" alt="" width="200" height="200" loading="lazy" />
                    <div class="vf-compare__copy">
                      <p class="vf-compare__title">{{../otherTitle}}</p>
                      <p class="vf-compare__text">{{../otherBody}}</p>
                    </div>
                  </div>
                </li>
                {{/with}}
                {{/each}}
              </ul>

              <p class="vf-compare__disclaimer">{{product.comparisonShowcase.disclaimer}}</p>
            </div>
          </div>
        </article>
        {{/if}}

        {{#unless (eq product.slug "vetrofit")}}
        {{#if product.comparisonPanel}}
        <figure class="product-panel mt-10">
          <img
            src="{{product.comparisonPanel}}"
            alt="{{product.trademark}} compared with other brands"
            width="1024"
            height="682"
            loading="lazy"
            class="product-panel__img"
          />
        </figure>
        {{/if}}
        {{/unless}}
      </div>

      <div data-tab-panel="ingredients" class="hidden py-10">
        {{#if product.primaryIngredientsCallouts}}
        <div class="pi-panel{{#ifCond product.slug "vetrofen"}} pi-panel--cols-5{{/ifCond}}">
          <header class="pi-panel__header">
            <p class="pi-panel__brand">{{product.trademark}}</p>
            <h3 class="pi-panel__title">Primary Ingredients</h3>
            <div class="pi-panel__title-rule" aria-hidden="true"></div>
          </header>

          {{#with (lookup product.ingredientBenefits 0) as |row|}}
          <div class="pi-benefit-table">
            <div class="pi-benefit-table__col">
              <p class="pi-benefit-table__head">Ingredients</p>
              <p class="pi-benefit-table__body">{{row.ingredient}}</p>
            </div>
            <div class="pi-benefit-table__col">
              <p class="pi-benefit-table__head">Ingredient Benefits</p>
              <p class="pi-benefit-table__body">{{row.benefit}}</p>
            </div>
            <div class="pi-benefit-table__col">
              <p class="pi-benefit-table__head">Performance Benefits</p>
              <p class="pi-benefit-table__body">{{row.performance}}</p>
            </div>
            <div class="pi-benefit-table__col">
              <p class="pi-benefit-table__head">Long-Term Benefits</p>
              <p class="pi-benefit-table__body">{{row.wellness}}</p>
            </div>
          </div>
          {{/with}}

          <ul class="pi-panel__grid">
            {{#each product.primaryIngredients}}
            <li class="pi-panel__item">
              <div class="pi-panel__media">
                <img src="{{this.image}}?v=20260814e" alt="{{this.name}}" width="720" height="720" loading="lazy" />
              </div>
              <p class="pi-panel__name">{{this.name}}</p>
              <p class="pi-panel__origin">Origin: {{this.origin}}</p>
            </li>
            {{/each}}
          </ul>

          <div class="pi-panel__callouts">
            {{#each product.primaryIngredientsCallouts}}
            <div class="pi-panel__callout">
              <div class="pi-panel__callout-icon">{{{icon this.icon "w-6 h-6"}}}</div>
              <p class="pi-panel__callout-text">{{this.text}}</p>
            </div>
            {{/each}}
          </div>
        </div>

        {{#if product.physiologyBenefits}}
        <div class="physio-chart{{#ifCond product.physiologyBenefits.variant "vetrofen"}} physio-chart--vetrofen{{/ifCond}}">
          <h3 class="physio-chart__title">{{product.physiologyBenefits.title}}</h3>
          <div class="physio-chart__scroll">
            <table class="physio-chart__table">
              <thead>
                <tr>
                  <th class="physio-chart__th physio-chart__th--system" colspan="2">{{lookup product.physiologyBenefits.columns 0}}</th>
                  <th class="physio-chart__th physio-chart__th--nutrition">{{lookup product.physiologyBenefits.columns 1}}</th>
                  <th class="physio-chart__th physio-chart__th--physiology">{{lookup product.physiologyBenefits.columns 2}}</th>
                  <th class="physio-chart__th physio-chart__th--performance">{{lookup product.physiologyBenefits.columns 3}}</th>
                  <th class="physio-chart__th physio-chart__th--wellness">{{lookup product.physiologyBenefits.columns 4}}</th>
                </tr>
              </thead>
              <tbody>
                {{#each product.physiologyBenefits.rows}}
                <tr>
                  <td class="physio-chart__icon-cell">
                    <span class="physio-chart__icon">{{{icon this.icon "w-7 h-7"}}}</span>
                  </td>
                  <td class="physio-chart__system">{{this.system}}</td>
                  <td class="physio-chart__nutrition">{{this.nutrition}}</td>
                  <td class="physio-chart__list physio-chart__list--physiology">
                    <ul>
                      {{#each this.physiology}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                  <td class="physio-chart__list physio-chart__list--performance">
                    <ul>
                      {{#each this.performance}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                  <td class="physio-chart__list physio-chart__list--wellness">
                    <ul>
                      {{#each this.wellness}}
                      <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{#if product.physiologyBenefits.callouts}}
          <div class="physio-chart__callouts">
            {{#each product.physiologyBenefits.callouts}}
            <div class="physio-chart__callout">
              <div class="physio-chart__callout-icon">{{{icon this.icon "w-6 h-6"}}}</div>
              <p class="physio-chart__callout-text">{{this.text}}</p>
            </div>
            {{/each}}
          </div>
          {{/if}}
          <p class="physio-chart__disclaimer">
            {{{icon "leaf" "w-3.5 h-3.5"}}}
            <span>{{product.physiologyBenefits.disclaimer}}</span>
          </p>
        </div>
        {{/if}}
        {{else}}
        {{#with (lookup product.ingredientBenefits 0) as |row|}}
        <div class="pi-benefit-table">
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Ingredients</p>
            <p class="pi-benefit-table__body">{{row.ingredient}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Ingredient Benefits</p>
            <p class="pi-benefit-table__body">{{row.benefit}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Performance Benefits</p>
            <p class="pi-benefit-table__body">{{row.performance}}</p>
          </div>
          <div class="pi-benefit-table__col">
            <p class="pi-benefit-table__head">Long-Term Benefits</p>
            <p class="pi-benefit-table__body">{{row.wellness}}</p>
          </div>
        </div>
        {{/with}}

        {{#if product.primaryIngredients}}
        <div class="pi-board">
          <p class="pi-board__brand">{{product.trademark}}</p>
          <h3 class="pi-board__title">Primary Ingredients</h3>
          <div class="pi-board__rule" aria-hidden="true"></div>
          <ul class="pi-board__grid">
            {{#each product.primaryIngredients}}
            <li class="pi-board__item">
              <div class="pi-board__media">
                <img src="{{this.image}}" alt="{{this.name}}" width="640" height="640" loading="lazy" />
              </div>
              <p class="pi-board__name">{{this.name}}</p>
              <div class="pi-board__item-rule" aria-hidden="true"></div>
              <p class="pi-board__origin">Origin: {{this.origin}}</p>
            </li>
            {{/each}}
          </ul>
          <p class="pi-board__footer">{{product.primaryIngredientsFooter}}</p>
        </div>
        {{/if}}
        {{/if}}
      </div>

      <div data-tab-panel="feeding" class="hidden max-w-4xl py-10" id="feeding">
        {{#each product.feedingIntro}}
        <p class="mt-2 text-sm leading-relaxed text-al-ink/75 first:mt-0">{{this}}</p>
        {{/each}}

        <div class="mt-8 overflow-x-auto rounded-none border border-al-line">
          <table class="w-full min-w-[500px] border-collapse text-left text-sm">
            <thead>
              <tr class="bg-al-navy text-white">
                {{#each product.feedingColumns}}
                <th class="px-4 py-3 font-semibold">{{this}}</th>
                {{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each product.feedingRows}}
              <tr class="border-t border-al-line odd:bg-white even:bg-al-panel">
                <td class="px-4 py-3 font-semibold text-al-navy">{{this.size}}</td>
                <td class="px-4 py-3 text-al-ink/70">{{this.weight}}</td>
                {{#each ../product.feedingValueKeys}}
                <td class="px-4 py-3 text-al-ink/70">{{pick ../this this}}</td>
                {{/each}}
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="mt-8">
          <p class="text-xs font-semibold uppercase tracking-wide text-al-navy">Additional Information</p>
          <ul class="mt-3 space-y-1.5 text-sm text-al-ink/70">
            {{#each product.feedingNotes}}
            <li class="flex items-start gap-2">{{{icon "check" "w-4 h-4 mt-0.5 text-al-navy/55 shrink-0"}}}{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>

      <div data-tab-panel="faq" class="hidden max-w-3xl py-10">
        <div class="space-y-3">
          {{#each product.faqs}}
          <div data-accordion-item class="card overflow-hidden">
            <button type="button" data-accordion-trigger class="flex w-full items-center justify-between gap-4 p-5 text-left">
              <span class="font-display text-base font-medium text-al-navy">{{this.question}}</span>
              {{{icon "chevron-down" "w-5 h-5 shrink-0 text-al-navy transition-transform" }}}
            </button>
            <div data-accordion-panel class="hidden px-5 pb-5 text-sm leading-relaxed text-al-ink/70">{{this.answer}}</div>
          </div>
          {{/each}}
        </div>
      </div>

      <div data-tab-panel="horseiq" class="hidden max-w-3xl py-10">
        <p class="text-sm leading-relaxed text-al-ink/75">Explore the podcasts, videos, white papers, and infographics behind {{product.trademark}}&mdash;straight from the Animalife science team.</p>
        <a href="/horse-iq" class="btn-outline mt-6">Browse Horse IQ</a>
      </div>
    </div>
  </div>
</section>



