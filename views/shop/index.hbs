{{> page-header eyebrow="Shop Animalife" heading="Root-cause nutrition for every stage of performance." subheading="Three targeted systems. One science-backed philosophy."}}

<section class="panel-grey">
  <div class="section">
    <div class="grid gap-6 md:grid-cols-3">
      {{#each categories}}
      <a href="/shop/category/{{this.slug}}" class="group overflow-hidden rounded-2xl bg-white shadow-sm transition-shadow hover:shadow-lg">
        <div class="relative aspect-[4/3] overflow-hidden bg-al-navy">
          <img src="{{this.image}}" alt="{{this.short}}" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5 text-white">
            <p class="font-display text-2xl font-medium">{{this.short}}</p>
            <p class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/80">{{this.strapline}}</p>
          </div>
        </div>
        <div class="p-5">
          <p class="text-sm text-al-ink/70">{{this.summary}}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-al-orange">Link to Product Information {{{icon "arrow-right" "w-4 h-4"}}}</span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <div class="eyebrow">Product Selection</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Shop All Products</h2>
    <p class="mt-3 text-sm text-al-ink/60">Select <span class="font-semibold text-al-navy">Inflammation &amp; Pain Relief</span> or <span class="font-semibold text-al-navy">Kidney Homeostasis Management</span> above, or browse every formula below.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="flex aspect-[4/5] items-center justify-center bg-al-panel p-8">
          <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-auto object-contain" />
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-lg font-semibold text-al-navy">{{this.trademark}}</p>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-orange">{{this.category}}</p>
          <a href="/shop/product/{{this.slug}}" class="font-display mt-2 text-lg font-medium text-al-navy hover:text-al-orange">{{this.tagline}}</a>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{this.description}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <form action="/cart/add" method="post">
              <input type="hidden" name="slug" value="{{this.slug}}" />
              <input type="hidden" name="qty" value="1" />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button type="submit" class="btn-outline !px-5 !py-2 text-xs">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
