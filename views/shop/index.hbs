<section class="shop-hero" aria-label="Shop Animalife">
  <img
    src="/images/shop/hero-board.jpg?v=20260821a"
    srcset="/images/shop/hero-board.jpg?v=20260821a 1600w, /images/shop/hero-board@2x.jpg?v=20260821a 3200w"
    sizes="100vw"
    alt="Shop Animalife. Root Cause Based Treatments for every stage of performance and wellness. Science-backed nutrition, targeted support, research driven, equine focused. VetroFlex, VetroFen, and VetroFit."
    width="1600"
    height="860"
    class="shop-hero__board"
  />
</section>

<section class="panel-grey" aria-labelledby="shop-by-category-title">
  <div class="section">
    <h2 id="shop-by-category-title" class="font-display text-3xl font-medium text-al-navy sm:text-4xl">Shop By Category</h2>
    <p class="mt-3 text-sm text-al-ink/60">ROOT CAUSE BASED TREATMENTS FOR EVERY STAGE OF PERFORMANCE</p>
    <div class="category-grid mt-12">
      {{#each categories}}
      <a href="/shop/category/{{this.slug}}" class="category-card category-card--{{this.accent}}">
        <figure class="category-card__media">
          <img
            src="{{this.image}}?v=20260821a"
            srcset="{{this.image}}?v=20260821a 1672w, {{this.image2x}}?v=20260821a 3344w"
            sizes="(min-width: 768px) 33vw, 100vw"
            alt="{{this.name}}"
            width="1672"
            height="941"
            loading="lazy"
          />
        </figure>
        <div class="category-card__body-wrap">
          <h3 class="category-card__title">{{this.name}}</h3>
          {{#if this.accentLabel}}
          <p class="category-card__accent">{{this.accentLabel}}</p>
          {{/if}}
          <p class="category-card__summary">{{this.summary}}</p>
          <span class="category-card__cta">
            {{this.cta}}
            {{{icon "arrow-right" "w-4 h-4"}}}
          </span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="eyebrow">Product Selection</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Shop All Products</h2>
    <p class="mt-3 text-sm text-al-ink/60">Browse every formula below, or start with a category above.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card product-card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="product-card__media-link border-b border-al-line bg-white p-8">
          {{> product-media image=this.image alt=this.trademark tagline=this.tagline}}
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <a href="/shop/product/{{this.slug}}" class="font-display text-lg font-semibold text-al-navy hover:text-al-navy/70">{{this.trademark}}</a>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/50">{{this.category}}</p>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{truncate this.description 140}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <form action="/cart/add" method="post">
              <input type="hidden" name="slug" value="{{this.slug}}" />
              <input type="hidden" name="qty" value="1" />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button type="submit" class="btn-outline !px-5 !py-2 text-xs">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
