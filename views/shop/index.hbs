{{> page-header eyebrow="Shop Animalife" heading="Shop By Category" subheading="Root Cause Based Treatments For Every Stage of Performance"}}

<section class="panel-white">
  <div class="section">
    <div class="category-grid">
      {{#each categories}}
      <a href="/shop/category/{{this.slug}}" class="category-card category-card--{{this.accent}}">
        <div class="category-card__stage">
          <div class="category-card__copy">
            <div class="category-card__rule" aria-hidden="true"></div>
            <h2 class="category-card__title">{{this.name}}</h2>
            {{#if this.accentLabel}}
            <p class="category-card__accent">{{this.accentLabel}}</p>
            {{/if}}
            {{#unless (eq this.accentLabel this.strapline)}}
            <p class="category-card__pillars">{{this.strapline}}</p>
            {{/unless}}
            <p class="category-card__body">{{this.summary}}</p>
          </div>
          <div class="category-card__media">
            <img src="{{this.image}}" alt="{{this.name}}" width="1024" height="576" loading="lazy" />
          </div>
        </div>

        <div class="category-card__benefits">
          {{#each this.benefits}}
          <div class="category-card__benefit">
            <div class="category-card__icon">{{{icon this.icon "w-5 h-5"}}}</div>
            <p class="category-card__benefit-title">{{this.title}}</p>
            <p class="category-card__benefit-body">{{this.body}}</p>
          </div>
          {{/each}}
        </div>

        <div class="category-card__footer">
          <p class="category-card__range">{{this.rangeLine}}</p>
          <span class="category-card__cta">
            {{this.cta}}
            {{{icon "arrow-right" "w-4 h-4"}}}
          </span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="eyebrow">Product Selection</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Shop All Products</h2>
    <p class="mt-3 text-sm text-al-ink/60">Browse every formula below, or start with a category above.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="flex aspect-[4/5] items-center justify-center border-b border-al-line bg-white p-8">
          <img src="{{this.image}}" alt="{{this.trademark}}" class="max-h-full w-auto max-w-full object-contain" />
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-lg font-semibold text-al-navy">{{this.trademark}}</p>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/50">{{this.category}}</p>
          <a href="/shop/product/{{this.slug}}" class="font-display mt-2 text-base font-medium text-al-navy hover:text-al-navy/70">{{this.tagline}}</a>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{truncate this.description 140}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <form action="/cart/add" method="post">
              <input type="hidden" name="slug" value="{{this.slug}}" />
              <input type="hidden" name="qty" value="1" />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button type="submit" class="btn-outline !px-5 !py-2 text-xs">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
