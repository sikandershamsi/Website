<section class="shop-hero">
  <img
    src="/images/shop/hero.jpg?v=3"
    alt="VetroFlex, VetroFen, and VetroFit with a horse in golden-hour light"
    class="shop-hero__media"
    width="1024"
    height="550"
  />
  <div class="shop-hero__veil" aria-hidden="true"></div>

  <div class="shop-hero__content">
    <div class="shop-hero__copy">
      <div class="shop-hero__eyebrow-row">
        <span class="shop-hero__rule" aria-hidden="true"></span>
        <p class="shop-hero__eyebrow">Shop Animalife</p>
        <span class="shop-hero__rule" aria-hidden="true"></span>
      </div>
      <h1 class="shop-hero__title">
        <span class="shop-hero__title-line">Root Cause Based</span>
        <span class="shop-hero__title-line">Treatments</span>
      </h1>
      <p class="shop-hero__lede">
        <span class="shop-hero__lede-line">For Every Stage of</span>
        <span class="shop-hero__lede-em">Performance &amp; Wellness</span>
      </p>
      <div class="shop-hero__mark" aria-hidden="true">
        <span class="shop-hero__rule shop-hero__rule--long"></span>
        <span class="shop-hero__mark-icon">{{{icon "gallop" "w-6 h-6"}}}</span>
        <span class="shop-hero__rule shop-hero__rule--long"></span>
      </div>
    </div>

    <ul class="shop-hero__features">
      <li class="shop-hero__feature">
        <div class="shop-hero__feature-icon">{{{icon "leaf" "w-5 h-5"}}}</div>
        <p class="shop-hero__feature-label">Science-Backed Nutrition</p>
      </li>
      <li class="shop-hero__feature">
        <div class="shop-hero__feature-icon">{{{icon "shield-check" "w-5 h-5"}}}</div>
        <p class="shop-hero__feature-label">Targeted Support</p>
      </li>
      <li class="shop-hero__feature">
        <div class="shop-hero__feature-icon">{{{icon "microscope" "w-5 h-5"}}}</div>
        <p class="shop-hero__feature-label">Research Driven</p>
      </li>
      <li class="shop-hero__feature">
        <div class="shop-hero__feature-icon">{{{icon "horse" "w-5 h-5"}}}</div>
        <p class="shop-hero__feature-label">Equine Focused</p>
      </li>
    </ul>
  </div>

  <div class="shop-hero__wave" aria-hidden="true">
    <svg class="shop-hero__wave-svg" viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false">
      <path fill="#1e3f33" d="M0,72 C360,18 720,18 1080,72 C1260,98 1380,110 1440,114 L1440,120 L0,120 Z"></path>
      <path fill="none" stroke="#c4a56a" stroke-width="2" d="M0,72 C360,18 720,18 1080,72 C1260,98 1380,110 1440,114"></path>
    </svg>
  </div>
</section>

<section class="panel-grey" aria-labelledby="shop-by-category-title">
  <div class="section">
    <h2 id="shop-by-category-title" class="font-display text-3xl font-medium text-al-navy sm:text-4xl">Shop By Category</h2>
    <p class="mt-3 text-sm text-al-ink/60">ROOT CAUSE BASED TREATMENTS FOR EVERY STAGE OF PERFORMANCE</p>
    <div class="category-grid mt-12">
      {{#each categories}}
      <a href="/shop/category/{{this.slug}}" class="category-card category-card--{{this.accent}}">
        <figure class="category-card__media">
          <img src="{{this.image}}" alt="{{this.name}}" width="1024" height="576" loading="lazy" />
        </figure>
        <div class="category-card__body-wrap">
          <h3 class="category-card__title">{{this.name}}</h3>
          {{#if this.accentLabel}}
          <p class="category-card__accent">{{this.accentLabel}}</p>
          {{/if}}
          <p class="category-card__summary">{{this.summary}}</p>
          <span class="category-card__cta">
            {{this.cta}}
            {{{icon "arrow-right" "w-4 h-4"}}}
          </span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="eyebrow">Product Selection</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Shop All Products</h2>
    <p class="mt-3 text-sm text-al-ink/60">Browse every formula below, or start with a category above.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card product-card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="product-card__media-link border-b border-al-line bg-white p-8">
          {{> product-media image=this.image alt=this.trademark tagline=this.tagline}}
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <a href="/shop/product/{{this.slug}}" class="font-display text-lg font-semibold text-al-navy hover:text-al-navy/70">{{this.trademark}}</a>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/50">{{this.category}}</p>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{truncate this.description 140}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <form action="/cart/add" method="post">
              <input type="hidden" name="slug" value="{{this.slug}}" />
              <input type="hidden" name="qty" value="1" />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button type="submit" class="btn-outline !px-5 !py-2 text-xs">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
