{{> page-header eyebrow="Shop Animalife" heading="Root-cause nutrition for every stage of performance." subheading="Three targeted systems. One science-backed philosophy."}}

<section class="section">
  <div class="grid gap-6 md:grid-cols-3">
    {{#each categories}}
    <a href="/shop/category/{{this.slug}}" class="card group flex flex-col p-7 transition-shadow hover:shadow-lg">
      <p class="text-xs font-semibold uppercase tracking-wide text-al-orange">{{this.strapline}}</p>
      <p class="font-display mt-3 text-xl font-medium text-al-navy">{{this.short}}</p>
      <p class="mt-3 flex-1 text-sm text-al-ink/65">{{this.summary}}</p>
      <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-al-navy group-hover:text-al-orange">Shop Category {{{icon "arrow-right" "w-4 h-4"}}}</span>
    </a>
    {{/each}}
  </div>
</section>

<section class="bg-al-cream-dark/60">
  <div class="section">
    <div class="eyebrow">Product Selection</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Shop All Products</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {{#each products}}
      <div class="card flex flex-col overflow-hidden">
        <a href="/shop/product/{{this.slug}}" class="flex aspect-[4/5] items-center justify-center bg-al-cream-dark/50 p-8">
          <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-auto object-contain" />
        </a>
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-baseline justify-between gap-2">
            <p class="font-display text-lg font-semibold text-al-navy">{{this.trademark}}</p>
            <p class="text-xs uppercase tracking-wider text-al-ink/45">{{this.size}}</p>
          </div>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-orange">{{this.category}}</p>
          <a href="/shop/product/{{this.slug}}" class="font-display mt-2 text-lg font-medium text-al-navy hover:text-al-orange">{{this.tagline}}</a>
          <p class="mt-3 flex-1 text-sm text-al-ink/65">{{this.description}}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="font-display text-lg font-medium text-al-navy">{{currency this.price}}</span>
            <form action="/cart/add" method="post">
              <input type="hidden" name="slug" value="{{this.slug}}" />
              <input type="hidden" name="qty" value="1" />
              <input type="hidden" name="redirectTo" value="/shop" />
              <button type="submit" class="btn-outline !px-5 !py-2 text-xs">Add to Cart</button>
            </form>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
