<section class="bg-al-navy text-white">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-10">
    {{#if eyebrow}}<div class="eyebrow !text-al-orange-light">{{eyebrow}}</div>{{/if}}
    <h1 class="font-display mt-4 max-w-2xl text-4xl font-medium leading-tight sm:text-5xl">{{heading}}</h1>
    {{#if subheading}}<p class="mt-5 max-w-xl text-sm text-white/70 sm:text-base">{{subheading}}</p>{{/if}}
  </div>
</section>
