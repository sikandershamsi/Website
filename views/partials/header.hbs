<header class="site-header relative sticky top-0 z-40 border-b border-al-line bg-white" data-site-header>
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-6 py-4 sm:px-8 lg:gap-8 lg:px-10">
    {{> brand-logo class="h-14 w-auto shrink-0"}}

    <nav class="site-nav ml-auto hidden lg:block" data-site-nav aria-label="Primary">
      <ul class="flex items-center gap-7 text-[13px] font-semibold tracking-wide uppercase xl:gap-8">
        <li class="site-nav__item" data-nav-item>
          <a href="/the-science" class="site-nav__link {{#ifCond activeNav "science"}}is-active{{/ifCond}}">The Science</a>
          <div class="site-nav__dropdown" data-nav-dropdown>
            <ul class="site-nav__list">
              <li><a href="/the-science/philosophy">Our Philosophy</a></li>
              <li><a href="/the-science/ingredients">Ingredient Library</a></li>
            </ul>
          </div>
        </li>
        <li class="site-nav__item">
          <a href="/shop" class="site-nav__link {{#ifCond activeNav "shop"}}is-active{{/ifCond}}">Shop</a>
        </li>
        <li class="site-nav__item" data-nav-item>
          <a href="/about" class="site-nav__link {{#ifCond activeNav "about"}}is-active{{/ifCond}}">About Us</a>
          <div class="site-nav__dropdown" data-nav-dropdown>
            <ul class="site-nav__list">
              <li><a href="/about">Our Story</a></li>
              <li><a href="/about/difference">The Animalife Difference</a></li>
            </ul>
          </div>
        </li>
        <li class="site-nav__item" data-nav-item>
          <a href="/ambassadors" class="site-nav__link {{#ifCond activeNav "ambassadors"}}is-active{{/ifCond}}">Ambassadors</a>
          <div class="site-nav__dropdown" data-nav-dropdown>
            <ul class="site-nav__list">
              <li><a href="/ambassadors">Meet Our Ambassadors</a></li>
              <li><a href="/ambassadors#become-ambassador">Be An Animalife Ambassador</a></li>
            </ul>
          </div>
        </li>
        <li class="site-nav__item" data-nav-item>
          <a href="/professionals" class="site-nav__link {{#ifCond activeNav "professionals"}}is-active{{/ifCond}}">Professionals</a>
          <div class="site-nav__dropdown" data-nav-dropdown>
            <ul class="site-nav__list">
              <li><a href="/professionals">Professionals Rewards Program</a></li>
            </ul>
          </div>
        </li>
        <li class="site-nav__item" data-nav-item>
          <a href="/racing" class="site-nav__link {{#ifCond activeNav "racing"}}is-active{{/ifCond}}">Racing</a>
          <div class="site-nav__dropdown site-nav__dropdown--wide" data-nav-dropdown>
            <ul class="site-nav__list">
              <li><a href="/racing/industry-reality">Industry Reality</a></li>
              <li><a href="/racing/kidney-homeostasis">Kidney Homeostasis</a></li>
              <li><a href="/racing/kidney-distress">Kidney Distress</a></li>
              <li><a href="/racing/vetrofit">VetroFit</a></li>
              <li><a href="/racing/performance-evaluation">VetroFit® Performance Evaluation Program</a></li>
            </ul>
          </div>
        </li>
        <li class="site-nav__item">
          <a href="/horse-iq" class="site-nav__link {{#ifCond activeNav "horseiq"}}is-active{{/ifCond}}">Horse IQ</a>
        </li>
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-4 text-al-navy">
      <button type="button" data-search-toggle aria-label="Search" class="transition-colors hover:text-al-orange">{{{icon "search" "w-5 h-5"}}}</button>
      <a href="/account" aria-label="Account" class="transition-colors hover:text-al-orange">{{{icon "user" "w-5 h-5"}}}</a>
      <a href="/cart" aria-label="Cart" class="relative transition-colors hover:text-al-orange">
        {{{icon "cart" "w-5 h-5"}}}
        <span data-cart-count class="absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-al-orange text-[10px] font-bold text-white">{{cartCount}}</span>
      </a>
      <button type="button" data-mobile-nav-toggle aria-label="Menu" class="lg:hidden">{{{icon "menu" "w-6 h-6"}}}</button>
    </div>
  </div>

  <div data-search-panel class="hidden border-t border-al-line bg-al-panel px-6 py-4 sm:px-8 lg:px-10">
    <form action="/horse-iq" method="get" class="mx-auto flex max-w-3xl items-center gap-3">
      <input type="text" name="q" placeholder="Search products, ingredients, white papers…" class="w-full rounded-none border border-al-line bg-white px-5 py-3 text-sm focus:border-al-navy focus:outline-none" />
      <button type="submit" class="btn-primary">Search</button>
    </form>
  </div>
</header>
