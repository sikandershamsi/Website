<section class="race-hero">
  <video
    class="race-hero__video"
    autoplay
    muted
    loop
    playsinline
    poster="/images/racing/hero-poster.jpg?v=2"
  >
    <source src="/videos/racing/hero.mp4?v=2" type="video/mp4" />
  </video>
  <div class="race-hero__veil" aria-hidden="true"></div>
  <div class="race-hero__copy">
    <p class="race-hero__eyebrow">Racing</p>
    <h1 class="race-hero__title">Performance Starts<br />With Physiology</h1>
    <p class="race-hero__lede">
      Elite racing pushes a horse&rsquo;s body to its physiological limits. Understanding the industry
      reality&mdash;and the kidney&rsquo;s role as the body&rsquo;s master regulator&mdash;is the foundation for
      helping horses perform, recover, and stay sound for longer careers.
    </p>
  </div>
</section>

<section class="race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">01 <span aria-hidden="true">|</span> The Race Within the Race</h2>
    <p class="race-intro__body">
      Racing places extraordinary demands on the equine athlete. During intense exercise, the horse&rsquo;s demand
      for oxygen and energy can exceed its ability to maintain physiological balance. As the body shifts from
      efficient aerobic metabolism toward less efficient anaerobic energy production, fatigue accelerates,
      performance declines, recovery slows, and physiological stress begins to affect multiple interconnected
      body systems.
    </p>
  </div>
</section>

<section class="race-cascade" id="industry-reality" aria-labelledby="race-cascade-title">
  <div class="race-cascade__inner">
    <h2 id="race-cascade-title" class="sr-only">The Race Within the Race</h2>
    <p class="sr-only">
      The unseen physiological events that affect speed, stamina, recovery, and long-term health.
    </p>

    <figure class="race-cascade__figure">
      <div class="race-cascade__scroller">
        <img
          src="/images/racing/cascade/board.jpg?v=3"
          alt="Infographic of seven race phases from optimal performance through recovery slowing and damage accumulation, with relative performance declining across distance."
          class="race-cascade__board-img"
          width="2048"
          height="1364"
          loading="lazy"
        />
      </div>
    </figure>

    <ol class="sr-only">
      {{#each performanceCascade}}
      <li>
        Phase {{this.phase}}: {{this.name}} ({{this.range}}). {{this.body}} Physiological cascade: {{this.tag}}.
      </li>
      {{/each}}
    </ol>
    <p class="sr-only">Cascade summary: {{#each cascadeSummary}}{{this.label}}{{#unless @last}}; {{/unless}}{{/each}}.</p>
  </div>
</section>

<section class="race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">02 <span aria-hidden="true">|</span> When Performance Declines, the Costs Begin</h2>
    <p class="race-intro__body">
      The physiological cascade doesn&rsquo;t end at the finish line. Its consequences extend far beyond race
      day&mdash;impacting soundness, longevity, veterinary costs, and the financial success of every horse owner
      and trainer.
    </p>
  </div>
</section>

<section class="race-owners" aria-labelledby="race-owners-title">
  <div class="race-owners__media-wrap" aria-hidden="true">
    <img
      src="/images/racing/owners/hero.jpg"
      alt=""
      class="race-owners__media"
      width="1024"
      height="682"
    />
    <div class="race-owners__veil"></div>
  </div>
  <div class="race-owners__copy">
    <p class="race-owners__eyebrow">Owners &amp; Trainers</p>
    <h2 id="race-owners-title" class="race-owners__title">Face</h2>
    <ul class="race-owners__list">
      {{#each ownersTrainersFace}}
      <li class="race-owners__item">
        <span class="race-owners__icon" aria-hidden="true">{{{icon this.icon ""}}}</span>
        <p class="race-owners__text">{{this.title}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-homeo" id="kidney-homeostasis" aria-labelledby="race-homeo-title">
  <div class="race-homeo__inner">
    <h2 id="race-homeo-title" class="sr-only">
      {{kidneyHomeostasisBanner.titleLead}} {{kidneyHomeostasisBanner.titleAccent}}
    </h2>
    <p class="sr-only">{{kidneyHomeostasisBanner.eyebrow}}</p>
    <p class="sr-only">{{kidneyHomeostasisBanner.body}}</p>

    <figure class="race-homeo__figure">
      <div class="race-homeo__scroller">
        <img
          src="/images/racing/homeostasis/board.jpg?v=1"
          alt="Kidney Homeostasis: The Foundation of Performance. A racehorse with a winner’s garland and jockey, with an anatomical kidney overlay and four performance foundations listed."
          class="race-homeo__board-img"
          width="2048"
          height="1092"
          loading="lazy"
        />
      </div>
    </figure>

    <ul class="sr-only">
      {{#each kidneyHomeostasisBanner.features}}
      <li>{{this.title}}</li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-statement">
  <div class="race-statement__inner">
    <h2 class="race-statement__title">
      <span class="race-statement__num">01</span>
      <span class="race-statement__sep" aria-hidden="true">|</span>
      Homeostasis is the balance that allows every performance system in the horse&rsquo;s body to work together as one.
    </h2>
    <div class="race-statement__panel">
      <p class="race-statement__body">
        It is the body&rsquo;s ability to continuously maintain internal physiological balance, ensuring that critical
        systems such as oxygen transport, cardiovascular function, hydration, electrolyte balance, metabolism, and
        recovery work together efficiently&mdash;even under the extreme demands of training and competition.
      </p>
    </div>
  </div>
</section>

<section class="race-regulator" aria-labelledby="race-regulator-title">
  <div class="race-regulator__inner">
    <h2 id="race-regulator-title" class="sr-only">
      {{kidneyMasterRegulator.titleLead}} {{kidneyMasterRegulator.titleAccent}} &mdash;
      {{kidneyMasterRegulator.subtitle}}
    </h2>
    <p class="sr-only">{{kidneyMasterRegulator.body}}</p>

    <figure class="race-regulator__figure">
      <div class="race-regulator__scroller">
        <img
          src="/images/racing/regulator/board.jpg?v=1"
          alt="Infographic of a galloping racehorse with the kidney and circulatory system highlighted, surrounded by the seven core functions the kidney regulates."
          class="race-regulator__board-img"
          width="2048"
          height="1364"
          loading="lazy"
        />
      </div>
    </figure>

    <p class="sr-only">{{kidneyMasterRegulator.legendTitle}} {{kidneyMasterRegulator.legendAccent}}.</p>
    <ol class="sr-only">
      {{#each kidneyMasterRegulator.functions}}
      <li>{{this.title}}: {{this.body}}</li>
      {{/each}}
    </ol>
  </div>
</section>

<section class="race-statement">
  <div class="race-statement__inner">
    <div class="race-statement__panel race-statement__panel--full">
      <h2 class="race-statement__title">
        <span class="race-statement__num">02</span>
        <span class="race-statement__sep" aria-hidden="true">|</span>
        Oxygen Is the Currency of Performance.
      </h2>
      <p class="race-statement__body">
        A racehorse&rsquo;s ability to sustain speed is determined by how efficiently oxygen is delivered to working
        muscles. Healthy kidney homeostasis helps regulate the physiological systems responsible for red blood cell
        production, blood pressure, fluid balance, and circulation&mdash;creating the foundation for efficient oxygen
        transport throughout the body.
      </p>
    </div>
  </div>
</section>

<section class="race-oxygen" aria-labelledby="race-oxygen-title">
  <div class="race-oxygen__inner">
    <p class="sr-only">{{oxygenTransport.eyebrow}}</p>
    <h2 id="race-oxygen-title" class="sr-only">
      {{oxygenTransport.titleStart}} {{oxygenTransport.titleAccent}}
    </h2>
    <p class="sr-only">{{oxygenTransport.body}}</p>
    <p class="sr-only">
      {{oxygenTransport.brand}} &mdash; {{oxygenTransport.tagline}} {{oxygenTransport.taglineAccent}}
    </p>

    <figure class="race-oxygen__figure">
      <div class="race-oxygen__scroller">
        <img
          src="/images/racing/oxygen/board.jpg?v=1"
          alt="Infographic showing the journey of oxygen from inhalation to energy production, the kidney systems that support oxygen delivery, and the performance benefits of optimized oxygen delivery."
          class="race-oxygen__board-img"
          width="2048"
          height="1364"
          loading="lazy"
        />
      </div>
    </figure>

    <p class="sr-only">{{oxygenTransport.journeyTitle}}</p>
    <ol class="sr-only">
      {{#each oxygenTransport.journey}}
      <li>{{this.step}}. {{this.title}}: {{this.body}}</li>
      {{/each}}
    </ol>

    <p class="sr-only">{{oxygenTransport.systemsTitle}}</p>
    <ul class="sr-only">
      {{#each oxygenTransport.systems}}
      <li>{{this.title}}: {{this.body}}</li>
      {{/each}}
    </ul>

    <p class="sr-only">{{oxygenTransport.benefitsTitle}}</p>
    <ul class="sr-only">
      {{#each oxygenTransport.benefits}}
      <li>{{this.title}}: {{this.body}}</li>
      {{/each}}
    </ul>
    <p class="sr-only">{{oxygenTransport.peak}}</p>
  </div>
</section>

<section class="race-distress" id="kidney-distress" aria-labelledby="race-distress-title">
  <div class="race-distress__inner">
    <h2 id="race-distress-title" class="sr-only">
      {{kidneyDistressBanner.titleLead}} {{kidneyDistressBanner.titleAccent}}
    </h2>
    <p class="sr-only">{{kidneyDistressBanner.subtitle}}</p>
    <p class="sr-only">{{kidneyDistressBanner.body}}</p>

    <figure class="race-distress__figure">
      <div class="race-distress__scroller">
        <img
          src="/images/racing/distress/board.jpg?v=1"
          alt="Infographic of a racehorse under racing stress with the kidney and circulatory system highlighted, listing the major stressors on the kidney and the effects of kidney distress."
          class="race-distress__board-img"
          width="2048"
          height="1364"
          loading="lazy"
        />
      </div>
    </figure>

    <p class="sr-only">{{kidneyDistressBanner.stressorsTitle}}</p>
    <ul class="sr-only">
      {{#each kidneyDistressBanner.stressors}}
      <li>{{this.title}}</li>
      {{/each}}
    </ul>

    <ul class="sr-only">
      {{#each kidneyDistressBanner.callouts}}
      <li>{{this.title}}: {{this.body}}</li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">02 <span aria-hidden="true">|</span> The Kidney: Where Performance Is Won or Lost</h2>
    <p class="race-intro__body">
      The fatigue you see on the track begins long before it becomes visible. As the kidney struggles to maintain
      physiological homeostasis under extreme athletic demands, oxygen delivery, recovery, and performance begin to
      decline.
    </p>
  </div>
</section>

<section class="race-compare" aria-label="Kidney homeostasis comparison">
  <div class="race-compare__inner">
    <article class="race-compare__panel race-compare__panel--normal">
      <header class="race-compare__head">
        <h2 class="race-compare__label">{{homeostasisComparison.normal.label}}</h2>
      </header>
      <p class="race-compare__tagline">{{homeostasisComparison.normal.tagline}}</p>
      <div class="race-compare__visual">
        <img
          src="{{homeostasisComparison.normal.image}}"
          alt="Healthy kidney in a normal state of homeostasis"
          class="race-compare__kidney"
          width="410"
          height="369"
        />
      </div>
      <ul class="race-compare__points">
        {{#each homeostasisComparison.normal.points}}
        <li class="race-compare__point">
          <span class="race-compare__mark" aria-hidden="true">{{{icon "check" "w-4 h-4"}}}</span>
          <div>
            <p class="race-compare__point-title">{{this.title}}</p>
            <p class="race-compare__point-body">{{this.body}}</p>
          </div>
        </li>
        {{/each}}
      </ul>
      <div class="race-compare__result">
        <div class="race-compare__result-icon" aria-hidden="true">{{{icon "shield-check" "w-7 h-7"}}}</div>
        <div>
          <p class="race-compare__result-title">{{homeostasisComparison.normal.resultTitle}}</p>
          <ul class="race-compare__result-list">
            {{#each homeostasisComparison.normal.result}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
    </article>

    <article class="race-compare__panel race-compare__panel--stress">
      <header class="race-compare__head">
        <h2 class="race-compare__label">{{homeostasisComparison.stress.label}}</h2>
      </header>
      <p class="race-compare__tagline">{{homeostasisComparison.stress.tagline}}</p>
      <div class="race-compare__visual">
        <img
          src="{{homeostasisComparison.stress.image}}"
          alt="Kidney under extreme training and competition stress"
          class="race-compare__kidney"
          width="410"
          height="369"
        />
      </div>
      <ul class="race-compare__points">
        {{#each homeostasisComparison.stress.points}}
        <li class="race-compare__point">
          <span class="race-compare__mark" aria-hidden="true">{{{icon "close" "w-4 h-4"}}}</span>
          <div>
            <p class="race-compare__point-title">{{this.title}}</p>
            <p class="race-compare__point-body">{{this.body}}</p>
          </div>
        </li>
        {{/each}}
      </ul>
      <div class="race-compare__result">
        <div class="race-compare__result-icon" aria-hidden="true">{{{icon "alert" "w-7 h-7"}}}</div>
        <div>
          <p class="race-compare__result-title">{{homeostasisComparison.stress.resultTitle}}</p>
          <ul class="race-compare__result-list">
            {{#each homeostasisComparison.stress.result}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="race-vetrofit" id="vetrofit" aria-labelledby="race-vetrofit-title">
  <div class="race-vetrofit__inner">
    <p class="sr-only">{{vetrofitRacingBanner.brand}}</p>
    <h2 id="race-vetrofit-title" class="sr-only">
      {{vetrofitRacingBanner.productLead}}{{vetrofitRacingBanner.productAccent}}
    </h2>
    <p class="sr-only">{{vetrofitRacingBanner.tagline}}</p>
    <p class="sr-only">
      Developed for elite performance horses, VetroFit&reg; is a fast-acting proprietary formulation designed to be
      administered just 2&ndash;4 hours before competition.
    </p>
    <p class="sr-only">
      Its highly bioavailable blend of vitamins, minerals, trace elements, amino acids, and antioxidants provides
      targeted nutritional support for healthy kidney function, helping maintain the physiological balance required
      for peak performance and efficient recovery.
    </p>

    <figure class="race-vetrofit__figure">
      <div class="race-vetrofit__scroller">
        <img
          src="/images/racing/vetrofit/board.jpg?v=1"
          alt="Animalife VetroFit — fast-acting, targeted, results. A galloping racehorse beside a VetroFit syringe, highlighting administration 2 to 4 hours before competition."
          class="race-vetrofit__board-img"
          width="2048"
          height="1364"
          loading="lazy"
        />
      </div>
    </figure>

    <p class="sr-only">
      {{vetrofitRacingBanner.timingValue}} {{vetrofitRacingBanner.timingUnit}}
      {{vetrofitRacingBanner.timingNote}}
    </p>
    <ul class="sr-only">
      {{#each vetrofitRacingBanner.features}}
      <li>{{this.title}}</li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title race-intro__title--plain">VetroFit</h2>
    <p class="race-intro__body">
      Developed specifically for the demands of the equine athlete,
      <strong>VetroFit&reg;</strong> is a proprietary nutritional formulation designed to support healthy kidney
      homeostasis&mdash;the physiological foundation for efficient oxygen transport, faster recovery, sustained
      performance, and long-term wellness.
    </p>
  </div>
</section>

<section class="panel-grey">
  <div class="section">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <div class="eyebrow justify-center text-black">Testimonials</div>
      <h2 class="font-display mt-4 text-3xl font-medium text-black sm:text-4xl lg:text-[2.75rem]">Trusted by horsemen who expect results.</h2>
    </div>
    <div class="mt-10 overflow-hidden" data-testimonial-slider data-auto-slider>
      <div class="slider-track gap-0" data-testimonial-track>
        {{#each testimonials}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-testimonial-slide>
          <div class="card h-full p-6">
            <div class="flex gap-0.5 text-black">
              {{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-black">{{this.author}}</p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    <div class="mt-6 flex justify-center gap-2" data-testimonial-dots></div>
  </div>
</section>

<section class="race-science" aria-labelledby="race-science-title">
  <div class="race-science__inner">
    <h2 id="race-science-title" class="sr-only">
      {{scienceBehindVetrofit.titleLead}} {{scienceBehindVetrofit.titleAccent}}
    </h2>
    <p class="sr-only">{{scienceBehindVetrofit.tagline}}</p>
    <p class="sr-only">{{scienceBehindVetrofit.body}}</p>

    <figure class="race-science__figure">
      <div class="race-science__scroller">
        <img
          src="/images/racing/science/board.jpg?v=1"
          alt="The Science Behind VetroFit — nature, research, results. Six formulation principles and a table of physiological support and performance benefits across seven body systems."
          class="race-science__board-img"
          width="2048"
          height="3075"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <ul class="sr-only">
      {{#each scienceBehindVetrofit.pillars}}
      <li>{{this.title}}: {{this.text}}</li>
      {{/each}}
    </ul>

    {{#if physiologyBenefits}}
    <table class="sr-only">
      <caption>{{physiologyBenefits.title}}</caption>
      <thead>
        <tr>
          {{#each physiologyBenefits.columns}}
          <th scope="col">{{this}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each physiologyBenefits.rows}}
        <tr>
          <th scope="row">{{this.system}}</th>
          <td>{{this.nutrition}}</td>
          <td>{{#each this.physiology}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</td>
          <td>{{#each this.performance}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</td>
          <td>{{#each this.wellness}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <p class="sr-only">{{physiologyBenefits.disclaimer}}</p>
    {{/if}}
  </div>
</section>

<section class="race-intro race-intro--muted">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">{{physiologyToFormulation.title}}</h2>
    <p class="race-intro__body">{{physiologyToFormulation.body}}</p>
  </div>
</section>

{{#if vetrofitPrimary.primaryIngredients}}
<section class="primary-ingredients" aria-labelledby="race-primary-ingredients-heading">
  <div class="primary-ingredients__panel">
    <p class="primary-ingredients__brand">{{vetrofitPrimary.trademark}}</p>
    <h2 id="race-primary-ingredients-heading" class="primary-ingredients__title">Primary Ingredients</h2>
    <div class="primary-ingredients__title-rule" aria-hidden="true"></div>
    <ul class="primary-ingredients__grid">
      {{#each vetrofitPrimary.primaryIngredients}}
      <li class="primary-ingredients__item">
        <div class="primary-ingredients__media">
          <img src="{{this.image}}" alt="{{this.name}}" width="640" height="640" loading="lazy" />
        </div>
        <p class="primary-ingredients__name">{{this.name}}</p>
        <div class="primary-ingredients__rule" aria-hidden="true"></div>
        <p class="primary-ingredients__origin">{{this.origin}}</p>
      </li>
      {{/each}}
    </ul>
    {{#if vetrofitPrimary.primaryIngredientsFooter}}
    <p class="primary-ingredients__footer">{{vetrofitPrimary.primaryIngredientsFooter}}</p>
    {{/if}}
  </div>
</section>
{{/if}}

<section class="race-why" aria-labelledby="race-why-title">
  <div class="race-why__media-wrap" aria-hidden="true">
    <img
      src="{{brandsVsAnimalife.image}}"
      alt=""
      class="race-why__media"
      width="1024"
      height="512"
      loading="lazy"
      decoding="async"
    />
    <div class="race-why__veil"></div>
  </div>

  <div class="race-why__inner">
    <div class="race-why__copy">
      <h2 id="race-why-title" class="race-why__before">{{brandsVsAnimalife.before}}</h2>
      <div class="race-why__vs" aria-hidden="true">
        <span class="race-why__vs-line"></span>
        <span class="race-why__vs-label">VS</span>
        <span class="race-why__vs-line"></span>
      </div>
      <p class="race-why__after">{{brandsVsAnimalife.after}}</p>
    </div>

    <ul class="race-why__features">
      {{#each brandsVsAnimalife.features}}
      <li class="race-why__feature">
        <span class="race-why__feature-icon" aria-hidden="true">{{{icon this.icon "w-5 h-5"}}}</span>
        <p class="race-why__feature-text">{{this.title}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-eval" id="performance-evaluation" aria-labelledby="race-eval-title">
  <div class="race-eval__media-wrap" aria-hidden="true">
    <img
      src="{{performanceEvaluationBanner.image}}"
      alt=""
      class="race-eval__media"
      width="1024"
      height="492"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="race-eval__inner">
    <div class="race-eval__main">
      <p class="race-eval__eyebrow">
        <span class="race-eval__eyebrow-line" aria-hidden="true"></span>
        <span>{{performanceEvaluationBanner.eyebrow}}</span>
        <span class="race-eval__eyebrow-line" aria-hidden="true"></span>
      </p>
      <h2 id="race-eval-title" class="race-eval__title">{{performanceEvaluationBanner.title}}</h2>
      <p class="race-eval__subtitle">{{performanceEvaluationBanner.subtitle}}</p>
      <p class="race-eval__body">{{performanceEvaluationBanner.body}}</p>

      <ul class="race-eval__benefits">
        {{#each performanceEvaluationBanner.benefits}}
        <li class="race-eval__benefit">
          <span class="race-eval__benefit-icon" aria-hidden="true">{{{icon this.icon "w-6 h-6"}}}</span>
          <p class="race-eval__benefit-text">{{this.title}}</p>
        </li>
        {{/each}}
      </ul>
    </div>

    <div class="race-eval__aside" aria-hidden="true">
      <span class="race-eval__aside-icon">{{{icon "gallop" "w-5 h-5"}}}</span>
      <p class="race-eval__aside-line">{{performanceEvaluationBanner.aside.line1}}</p>
      <p class="race-eval__aside-line">{{performanceEvaluationBanner.aside.line2}}</p>
      <p class="race-eval__aside-accent">{{performanceEvaluationBanner.aside.line3}}</p>
    </div>
  </div>

  <a href="{{performanceEvaluationBanner.cta.href}}" class="race-eval__cta">
    <div class="race-eval__cta-open">
      <span class="race-eval__cta-icon" aria-hidden="true">{{{icon "file-text" "w-5 h-5"}}}</span>
      <div>
        <p class="race-eval__cta-lead">{{performanceEvaluationBanner.cta.lead}}</p>
        <p class="race-eval__cta-sub">{{performanceEvaluationBanner.cta.sub}}</p>
