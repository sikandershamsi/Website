    <div class="physio-chart physio-chart--race">
      <h3 class="physio-chart__title">{{physiologyBenefits.title}}</h3>
      <div class="physio-chart__scroll">
        <table class="physio-chart__table">
          <thead>
            <tr>
              <th class="physio-chart__th physio-chart__th--system" colspan="2">{{lookup physiologyBenefits.columns 0}}</th>
              <th class="physio-chart__th physio-chart__th--nutrition">{{lookup physiologyBenefits.columns 1}}</th>
              <th class="physio-chart__th physio-chart__th--physiology">{{lookup physiologyBenefits.columns 2}}</th>
              <th class="physio-chart__th physio-chart__th--performance">{{lookup physiologyBenefits.columns 3}}</th>
              <th class="physio-chart__th physio-chart__th--wellness">{{lookup physiologyBenefits.columns 4}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each physiologyBenefits.rows}}
            <tr>
              <td class="physio-chart__icon-cell">
                <span class="physio-chart__icon">{{{icon this.icon "w-7 h-7"}}}</span>
              </td>
              <td class="physio-chart__system">{{this.system}}</td>
              <td class="physio-chart__nutrition">{{this.nutrition}}</td>
              <td class="physio-chart__list physio-chart__list--physiology">
                <ul>
                  {{#each this.physiology}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </td>
              <td class="physio-chart__list physio-chart__list--performance">
                <ul>
                  {{#each this.performance}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </td>
              <td class="physio-chart__list physio-chart__list--wellness">
                <ul>
                  {{#each this.wellness}}
                  <li>{{this}}</li>
                  {{/each}}
                </ul>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <p class="physio-chart__disclaimer">
        {{{icon "leaf" "w-3.5 h-3.5"}}}
        <span>{{physiologyBenefits.disclaimer}}</span>
      </p>
    </div>
  </div>
  {{/if}}
</section>

