<section class="race-hero" aria-label="Racing">
  <video
    class="race-hero__video"
    autoplay
    muted
    loop
    playsinline
    poster="/images/racing/hero-poster.jpg?v=20260821e"
  >
    <source src="/videos/racing/hero.mp4?v=20260821e" type="video/mp4" />
  </video>
</section>

<section class="panel-white race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">01 <span aria-hidden="true">|</span> The Race Within the Race</h2>
    <p class="race-intro__body">
      Racing places extraordinary demands on the equine athlete. During intense exercise, the horse&rsquo;s demand
      for oxygen and energy can exceed its ability to maintain physiological balance. As the body shifts from
      efficient aerobic metabolism toward less efficient anaerobic energy production, fatigue accelerates,
      performance declines, recovery slows, and physiological stress begins to affect multiple interconnected
      body systems.
    </p>
  </div>
</section>

<section class="panel-grey race-cascade" id="industry-reality" aria-labelledby="race-cascade-title">
  <div class="race-cascade__inner">
    <header class="race-cascade__header">
      <h2 id="race-cascade-title" class="race-cascade__title">The Race Within the Race</h2>
      <p class="race-cascade__subtitle">
        The unseen physiological events that affect speed, stamina, recovery, and long-term health.
      </p>
    </header>

    <ul class="race-cascade__mobile">
      {{#each performanceCascade}}
      <li class="race-cascade__mobile-card" style="--phase-color: {{this.color}}; --phase-soft: {{this.soft}}">
        <div class="race-cascade__mobile-head">
          <span class="race-cascade__mobile-num">{{this.phase}}</span>
          <div class="race-cascade__mobile-meta">
            <h3 class="race-cascade__mobile-name">{{this.name}}</h3>
            <p class="race-cascade__mobile-range">{{this.range}}</p>
          </div>
          <div class="race-cascade__mobile-icon" aria-hidden="true">{{{icon this.icon "w-5 h-5"}}}</div>
        </div>
        <div class="race-cascade__mobile-media">
          <img src="{{this.image}}" alt="" class="race-cascade__mobile-img" loading="lazy" width="220" height="140" />
        </div>
        <p class="race-cascade__mobile-body">{{this.body}}</p>
        <p class="race-cascade__mobile-tag">{{this.tag}}</p>
      </li>
      {{/each}}
    </ul>

    <div class="race-cascade__mobile-foot">
      <div class="race-cascade__graph race-cascade__graph--mobile">
        <p class="race-cascade__graph-label">Performance Level (Relative)</p>
        {{> cascade-plot gradientId="cascadeLineMobile"}}
      </div>
    </div>

    <div class="race-cascade__scroller">
      <div class="race-cascade__board">
        <div class="race-cascade__rail-cell race-cascade__rail-cell--phase">
          <span class="race-cascade__rail-tab">Phase</span>
          <span class="race-cascade__rail-label">
            Race Progress
            <span class="race-cascade__rail-note">(Approx.)</span>
          </span>
        </div>
        {{#each performanceCascade}}
        <div class="race-cascade__phase-head" style="--phase-color: {{this.color}}">
          <span class="race-cascade__phase-num">{{this.phase}}</span>
          <h3 class="race-cascade__phase-name">{{this.name}}</h3>
          <p class="race-cascade__phase-range">{{this.range}}</p>
          <div class="race-cascade__phase-media">
            <img src="{{this.image}}?v=20260815a" alt="" class="race-cascade__phase-img" loading="lazy" width="254" height="234" />
          </div>
        </div>
        {{/each}}

        <div class="race-cascade__rail-cell">
          <span class="race-cascade__rail-label">What&rsquo;s Happening</span>
        </div>
        {{#each performanceCascade}}
        <div class="race-cascade__happening" style="--phase-soft: {{this.soft}}">
          <p class="race-cascade__happening-body">{{this.body}}</p>
        </div>
        {{/each}}

        <div class="race-cascade__rail-cell">
          <span class="race-cascade__rail-label">Physiological Cascade</span>
        </div>
        {{#each performanceCascade}}
        <div class="race-cascade__physio" style="--phase-color: {{this.color}}">
          <span class="race-cascade__physio-icon" aria-hidden="true">{{{icon this.icon "w-9 h-9"}}}</span>
          <p class="race-cascade__physio-tag">{{this.tag}}</p>
          {{#unless @last}}
          <span class="race-cascade__physio-arrow" aria-hidden="true">{{{icon "arrow-right" "w-5 h-5"}}}</span>
          {{/unless}}
        </div>
        {{/each}}

        <div class="race-cascade__rail-cell race-cascade__rail-cell--last">
          <span class="race-cascade__rail-label">
            Performance Level
            <span class="race-cascade__rail-note">(Relative)</span>
          </span>
        </div>
        <div class="race-cascade__graph">
          {{> cascade-plot gradientId="cascadeLine"}}
        </div>
      </div>
    </div>

    <div class="race-cascade__summary">
      <div class="race-cascade__summary-head">
        <span class="race-cascade__summary-icon" aria-hidden="true">{{{icon "alert-solid" "w-8 h-8"}}}</span>
        <p class="race-cascade__summary-title">The Cascade in Summary</p>
      </div>
      <ol class="race-cascade__summary-list">
        {{#each cascadeSummary}}
        <li class="race-cascade__summary-item" style="--sum-color: {{this.color}}">
          <span class="race-cascade__summary-text">{{this.label}}</span>
          {{#unless @last}}
          <span class="race-cascade__summary-arrow" aria-hidden="true">{{{icon "arrow-right" "w-4 h-4"}}}</span>
          {{/unless}}
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>

<section class="panel-white race-intro">
  <div class="race-intro__inner">
    <h2 class="race-intro__title">02 <span aria-hidden="true">|</span> When Performance Declines, the Costs Begin</h2>
    <p class="race-intro__body">
      The physiological cascade doesn&rsquo;t end at the finish line. Its consequences extend far beyond race
      day&mdash;impacting soundness, longevity, veterinary costs, and the financial success of every horse owner
      and trainer.
    </p>
  </div>
</section>

<section class="panel-grey race-owners" aria-labelledby="race-owners-title">
  <div class="race-owners__media-wrap" aria-hidden="true">
    <img
      src="/images/racing/owners/hero.jpg"
      alt=""
      class="race-owners__media"
      width="1024"
      height="682"
    />
    <div class="race-owners__veil"></div>
  </div>
  <div class="race-owners__copy">
    <p class="race-owners__eyebrow">Owners &amp; Trainers</p>
    <h2 id="race-owners-title" class="race-owners__title">Face</h2>
    <ul class="race-owners__list">
      {{#each ownersTrainersFace}}
      <li class="race-owners__item">
        <span class="race-owners__icon" aria-hidden="true">{{{icon this.icon ""}}}</span>
        <p class="race-owners__text">{{this.title}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="race-homeo race-homeo--board" id="kidney-homeostasis" aria-label="Kidney Homeostasis">
  <img
    src="/images/racing/homeostasis/banner-board.jpg?v=20260822a"
    srcset="/images/racing/homeostasis/banner-board.jpg?v=20260822a 1717w, /images/racing/homeostasis/banner-board@2x.jpg?v=20260822a 3434w"
    sizes="100vw"
    alt="Kidney Homeostasis. The foundation of performance. The kidney continually monitors and regulates the body's essential systems—maintaining the physiological balance required for peak performance, efficient recovery, and long-term athletic health. Regulates 7 vital systems. Maintains physiological balance. Supports performance and recovery. Foundation of long-term athletic health."
    width="1717"
    height="916"
    class="race-homeo__board"
  />
</section>

<section class="panel-white race-statement" id="homeostasis-balance" aria-labelledby="race-statement-01-title">
  <div class="race-statement__inner">
    <div class="race-statement__panel race-statement__panel--full">
      <h2 id="race-statement-01-title" class="race-statement__title">
        <span class="race-statement__num">01</span>
        <span class="race-statement__sep" aria-hidden="true">|</span>
        Homeostasis is the balance that allows every performance system in the horse&rsquo;s body to work together as one.
      </h2>
      <p class="race-statement__body">
        It is the body&rsquo;s ability to continuously maintain internal physiological balance, ensuring that critical
        systems such as oxygen transport, cardiovascular function, hydration, electrolyte balance, metabolism, and
        recovery work together efficiently&mdash;even under the extreme demands of training and competition.
      </p>
    </div>
  </div>
</section>

<section class="race-regulator race-regulator--board" id="kidney-master-regulator" aria-label="Kidney Homeostasis: The Horse's Master Regulator">
  <img
    src="/images/racing/regulator/master-board.jpg?v=20260822a"
    srcset="/images/racing/regulator/master-board.jpg?v=20260822a 1536w, /images/racing/regulator/master-board@2x.jpg?v=20260822a 3072w"
    sizes="100vw"
    alt="Kidney Homeostasis: The Horse's Master Regulator. The kidney continuously monitors, adjusts, and regulates essential functions to maintain balance in the body. When the kidney is supported, the whole horse performs, recovers, and thrives. Seven core functions: blood pressure regulation, red blood cell regulation, fluid balance, electrolyte balance, acid-base balance, oxygen transport support, and waste clearance and detoxification."
    width="1536"
    height="1024"
    class="race-regulator__board-img"
  />
</section>

<section class="panel-grey race-statement">
  <div class="race-statement__inner">
    <div class="race-statement__panel race-statement__panel--full">
      <h2 class="race-statement__title">
        <span class="race-statement__num">02</span>
        <span class="race-statement__sep" aria-hidden="true">|</span>
        Oxygen Is the Currency of Performance.
      </h2>
      <p class="race-statement__body">
        A racehorse&rsquo;s ability to sustain speed is determined by how efficiently oxygen is delivered to working
        muscles. Healthy kidney homeostasis helps regulate the physiological systems responsible for red blood cell
        production, blood pressure, fluid balance, and circulation&mdash;creating the foundation for efficient oxygen
        transport throughout the body.
      </p>
    </div>
  </div>
</section>

<section class="race-oxygen race-oxygen--board" id="oxygen-transport" aria-label="The Physiology of Oxygen Transport">
  <img
    src="/images/racing/oxygen/transport-board.jpg?v=20260822b"
    srcset="/images/racing/oxygen/transport-board.jpg?v=20260822b 1505w, /images/racing/oxygen/transport-board@2x.jpg?v=20260822b 3010w"
    sizes="100vw"
    alt="The Physiology of Oxygen Transport. Oxygen is the currency of performance. VetroFit supports physiology, not symptoms. Journey of oxygen from inhalation to energy production. Kidney homeostasis supports blood pressure regulation, red blood cell activity, fluid balance, and electrolyte balance. When oxygen delivery is optimized, performance is maximized: sustained speed, delayed fatigue, faster recovery, and long-term resilience."
    width="1505"
    height="1021"
    class="race-oxygen__board"
  />
</section>

<section class="race-distress race-distress--board" id="kidney-distress" aria-label="Kidney Distress">
  <img
    src="/images/racing/distress/distress-board.jpg?v=20260822a"
    srcset="/images/racing/distress/distress-board.jpg?v=20260822a 1536w, /images/racing/distress/distress-board@2x.jpg?v=20260822a 3072w"
    sizes="100vw"
    alt="Kidney Distress. Intense exercise places extreme demand on the kidney's ability to maintain homeostasis. Major stressors include high intensity exercise, heat and humidity, dehydration, metabolic demand, and electrolyte losses. Effects include waste accumulation, fluid and electrolyte imbalance, reduced oxygen transport, and early fatigue. Kidney distress equals compromised performance."
    width="1536"
    height="1024"
    class="race-distress__board-img"
  />
</section>

<section class="panel-white race-intro race-intro--compact">
  <div class="race-intro__inner">
    <h2 class="race-intro__title race-intro__title--plain">The Kidney: Where Performance Is Won or Lost</h2>
    <p class="race-intro__body">
      The fatigue you see on the track begins long before it becomes visible. As the kidney struggles to maintain
      physiological homeostasis under extreme athletic demands, oxygen delivery, recovery, and performance begin to
      decline.
    </p>
  </div>
</section>

<section class="race-compare race-compare--board" id="kidney-comparison" aria-label="Kidney homeostasis comparison">
  <img
    src="/images/racing/compare/compare-board.jpg?v=20260822a"
    srcset="/images/racing/compare/compare-board.jpg?v=20260822a 1506w, /images/racing/compare/compare-board@2x.jpg?v=20260822a 3012w"
    sizes="100vw"
    alt="Kidney homeostasis comparison. Left: normal state of homeostasis—well-nourished, hydrated, balanced, resilient—with optimal blood flow, efficient filtration, balanced hydration and electrolytes, strong antioxidant defense, acid-base balance, and overall resilience resulting in optimal performance. Right: extreme stress from intense training or competition—physiological stress, dehydration, inflammation, imbalance—with reduced blood flow, compromised filtration, electrolyte and fluid imbalance, reduced EPO production, oxidative stress and inflammation, acid-base disruption, and lower resilience resulting in reduced performance and recovery."
    width="1506"
    height="947"
    class="race-compare__board-img"
  />
</section>

<section class="race-vetrofit race-vetrofit--board" id="vetrofit" aria-label="VetroFit">
