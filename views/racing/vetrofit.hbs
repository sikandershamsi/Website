<section class="panel-grey">
  <div class="section max-w-3xl text-center">
    <h2 class="font-display text-3xl font-medium text-al-navy sm:text-4xl">From Physiology to Formulation</h2>
    <p class="mt-6 text-sm leading-relaxed text-al-ink/75">Every ingredient in VetroFit&reg; is selected for a defined physiological purpose. Together, they form a highly bioavailable nutritional system that supports healthy kidney homeostasis&mdash;the foundation for efficient oxygen transport, cardiovascular performance, metabolic balance, hydration, and recovery.</p>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <div class="mx-auto max-w-4xl rounded-none border border-al-line bg-al-navy p-8 text-center text-white sm:p-12">
      <div class="eyebrow !text-al-navy/55 mx-auto justify-center">Now Enrolling</div>
      <h2 class="font-display mt-4 text-2xl font-medium sm:text-3xl">VetroFit&reg; Performance Evaluation Program</h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-white/75">Selected trainers and owners receive complimentary VetroFit&reg; product in exchange for structured, real-world feedback&mdash;helping us advance the science of equine performance and recovery.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/racing/performance-evaluation" class="btn-primary">Learn More &amp; Apply</a>
      </div>
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="eyebrow">Testimonials</div>
        <h2 class="font-display mt-4 text-3xl font-medium text-al-navy">North America Product Trials</h2>
      </div>
      <div class="flex gap-2">
        <button type="button" data-testimonial-prev class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
        <button type="button" data-testimonial-next class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
      </div>
    </div>
    <div class="mt-8 overflow-hidden" data-testimonial-slider>
      <div class="slider-track" data-testimonial-track>
        {{#each testimonials}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-testimonial-slide>
          <div class="card h-full p-6">
            <p class="text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy">{{this.author}}</p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>
