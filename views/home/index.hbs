<!-- HERO -->
<section class="relative isolate overflow-hidden bg-al-navy text-white">
  <div class="relative h-[60vh] min-h-[440px] sm:h-[68vh] lg:h-[78vh]">
    <video data-hero-slide autoplay muted loop playsinline class="absolute inset-0 h-full w-full object-cover opacity-100 transition-opacity duration-1000">
      <source src="/videos/home/eventer.mp4" type="video/mp4" />
    </video>
    <video data-hero-slide muted loop playsinline class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000">
      <source src="/videos/home/jumper.mp4" type="video/mp4" />
    </video>
    <video data-hero-slide muted loop playsinline class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000">
      <source src="/videos/home/racehorse.mp4" type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-al-navy/80 via-al-navy/45 to-al-navy/20"></div>
    <div class="relative z-10 flex h-full flex-col justify-center px-6 sm:px-8 lg:px-10">
      <div class="mx-auto w-full max-w-7xl">
        <p class="text-[11px] font-semibold uppercase leading-relaxed tracking-[0.22em] text-al-orange sm:text-xs">
          Long Term Equine Performance<br />
          Starts Here
        </p>
        <h1 class="font-display mt-5 w-3/4 text-[clamp(2.75rem,8vw,7.5rem)] font-bold leading-[0.95] tracking-tight text-white">
          Feel the Difference
        </h1>
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 bg-al-orange"></div>
</section>

<!-- HORSE TRUTHS: auto slide bar, 2 at a time -->
<section class="panel-white section">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="eyebrow">Horse Truths</div>
      <h2 class="font-display mt-4 max-w-2xl text-3xl font-medium text-al-navy sm:text-4xl">Seven truths behind every Animalife formulation.</h2>
    </div>
    <div class="flex gap-2">
      <button type="button" data-truth-prev class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line text-al-navy hover:border-al-navy hover:text-al-navy" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
      <button type="button" data-truth-next class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line text-al-navy hover:border-al-navy hover:text-al-navy" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
    </div>
  </div>
  <div class="mt-10 overflow-hidden" data-truth-slider data-auto-slider>
    <div class="slider-track" data-truth-track>
      {{#each horseTruths}}
      <div class="w-full shrink-0 px-1 md:w-1/2 md:px-3" data-truth-slide>
        <div class="h-full border-b border-al-line pb-8 md:border-b-0 md:border-r md:pr-8">
          <span class="font-display text-3xl font-medium text-al-navy/25">{{#if (gt this.n 9)}}{{this.n}}{{else}}0{{this.n}}{{/if}}</span>
          <p class="font-display mt-3 text-lg font-medium text-al-navy">{{this.title}}</p>
          <p class="mt-2 text-sm leading-relaxed text-al-ink/70">{{this.body}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  <div class="mt-6 flex justify-center gap-2" data-truth-dots></div>
</section>

<!-- OUR MISSION — matches reference: copy | ingredients photo | process -->
<section class="panel-white">
  <div class="section">
    <div class="mission-panel">
      <div class="mission-panel__copy">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-al-navy/70">Inspired by Nature. Proven by Science.</p>
        <div class="mt-4 h-px w-12 bg-al-orange" aria-hidden="true"></div>
        <h2 class="font-display mt-5 text-3xl font-semibold leading-[1.12] text-al-navy sm:text-4xl lg:text-[2.65rem]">
          Powerful Ingredients.<br />Purposeful Nutrition.
        </h2>
        <div class="mt-5 h-px w-12 bg-al-orange" aria-hidden="true"></div>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-al-ink/75">We combine nature's most powerful compounds with advanced nutritional science to create solutions that work with your animal's body&mdash;not against it.</p>
      </div>

      <div class="mission-panel__media">
        <img
          src="/images/home/ingredients-photo.jpg"
          alt="Botanical herbs, mortar and pestle, and laboratory flask"
          class="h-full w-full object-cover object-center"
        />
      </div>

      <div class="mission-panel__process">
        <p class="text-center text-[11px] font-semibold uppercase tracking-[0.16em] text-al-navy/70">Designed to Help Animals</p>
        <div class="mt-6 flex flex-wrap items-start justify-center gap-x-2 gap-y-4 sm:gap-3">
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-al-navy/30 text-al-navy">{{{icon "leaf" "w-5 h-5"}}}</div>
            <p class="mt-2 text-[10px] font-bold uppercase tracking-wide text-al-navy">Heal</p>
          </div>
          <span class="mt-3.5 text-al-navy/35">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-al-navy/30 text-al-navy">{{{icon "horse" "w-5 h-5"}}}</div>
            <p class="mt-2 text-[10px] font-bold uppercase tracking-wide text-al-navy">Perform</p>
          </div>
          <span class="mt-3.5 text-al-navy/35">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-al-navy/30 text-al-navy">{{{icon "clock" "w-5 h-5"}}}</div>
            <p class="mt-2 text-[10px] font-bold uppercase tracking-wide text-al-navy">Recover</p>
          </div>
          <span class="mt-3.5 text-al-navy/35">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-al-navy/30 text-al-navy">{{{icon "heart" "w-5 h-5"}}}</div>
            <p class="mt-2 text-[10px] font-bold uppercase tracking-wide text-al-navy">Thrive</p>
          </div>
        </div>
        <div class="mt-8 border border-al-orange px-4 py-3 text-center text-[10px] font-semibold uppercase tracking-[0.12em] text-al-navy sm:text-[11px]">
          Longer Health. Better Performance. A Better Life.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- OUR STANDARDS -->
<section class="panel-white">
  <div class="section text-center">
    <h2 class="font-display text-4xl font-medium text-al-navy sm:text-5xl">Our Standards</h2>
    <div class="mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-5 sm:gap-8">
      {{#each standards}}
      <div class="flex flex-col items-center">
        <div class="flex h-14 w-14 items-center justify-center text-al-navy">{{{icon this.icon "w-10 h-10"}}}</div>
        <p class="mt-5 text-sm font-semibold leading-snug text-al-navy">
          {{this.line1}}<br />{{this.line2}}
        </p>
      </div>
      {{/each}}
    </div>
    <a href="/about/difference" class="mt-14 inline-block text-xs font-bold uppercase tracking-[0.16em] text-al-navy border-b-2 border-al-orange pb-1 hover:text-al-orange">Learn More</a>
  </div>
</section>

<!-- FEATURED PRODUCTS + benefits table -->
<section class="panel-grey">
  <div class="section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="eyebrow">Featured Products</div>
        <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Natural &ndash; Safe &ndash; FEI Clean Sport Compliant</h2>
      </div>
      <div class="flex items-center gap-4">
        <a href="/shop" class="btn-outline">Shop All Products</a>
        <div class="flex gap-2">
          <button type="button" data-products-prev class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line bg-white text-al-navy hover:border-al-navy hover:text-al-navy" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
          <button type="button" data-products-next class="flex h-10 w-10 items-center justify-center rounded-none border border-al-line bg-white text-al-navy hover:border-al-navy hover:text-al-navy" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
        </div>
      </div>
    </div>
    <div class="mt-12 overflow-hidden" data-auto-slider>
      <div class="slider-track" data-products-track>
        {{#each products}}
        <div class="w-full shrink-0 px-2 md:w-1/2 lg:w-1/4" data-products-slide>
          <a href="/shop/product/{{this.slug}}" class="card group flex h-full flex-col items-center overflow-hidden p-6 text-center transition-colors hover:bg-al-panel">
            <div class="flex aspect-[4/5] w-full items-center justify-center">
              <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-auto object-contain" />
            </div>
            <div class="flex flex-1 flex-col items-center pt-2">
              <div class="flex justify-center gap-0.5 text-al-navy">
                {{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}
              </div>
              <p class="font-display mt-3 text-lg font-semibold text-al-navy">{{this.trademark}}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/55">{{this.category}}</p>
              <p class="font-display mt-2 text-lg font-medium text-al-navy">{{this.tagline}}</p>
              <span class="font-display mt-4 text-lg font-medium text-al-navy">{{currency this.price}}</span>
            </div>
          </a>
        </div>
        {{/each}}
      </div>
    </div>
    <div class="mt-6 flex justify-center gap-2" data-products-dots></div>

    <div class="mt-14">
      <h3 class="font-display text-2xl font-medium text-al-navy">Ingredients &amp; Benefits</h3>
      <div class="mt-6 overflow-x-auto rounded-none border border-al-line bg-white">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-al-navy-light text-white">
              <th class="px-5 py-4 font-semibold">Product</th>
              <th class="px-5 py-4 font-semibold">Ingredients</th>
              <th class="px-5 py-4 font-semibold">Ingredient Benefits</th>
              <th class="px-5 py-4 font-semibold">Performance Benefits</th>
              <th class="px-5 py-4 font-semibold">Long-Term Wellness</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
            {{#with (lookup this.ingredientBenefits 0) as |row|}}
            <tr class="border-t border-al-line align-top odd:bg-white even:bg-al-panel">
              <td class="px-5 py-5 font-display font-medium text-al-navy">{{../trademark}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.ingredient}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.benefit}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.performance}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.wellness}}</td>
            </tr>
            {{/with}}
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- INSPIRED BY NATURE — soft white fade into horse (matches reference) -->
