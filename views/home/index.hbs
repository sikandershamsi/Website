<!-- HERO -->
<section class="relative isolate overflow-hidden bg-al-navy text-white">
  <div class="relative h-[calc(100svh-6.75rem)] min-h-[560px]">
    <video data-hero-slide autoplay muted playsinline class="absolute inset-0 h-full w-full object-cover object-center opacity-100 transition-opacity duration-1000">
      <source src="/videos/home/jumper.mp4?v=20260821a" type="video/mp4" />
    </video>
    <video data-hero-slide muted playsinline class="absolute inset-0 h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000">
      <source src="/videos/home/racing.mp4?v=20260821a" type="video/mp4" />
    </video>
    <video data-hero-slide muted playsinline class="absolute inset-0 h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000">
      <source src="/videos/home/barrel.mp4?v=20260821a" type="video/mp4" />
    </video>
    <video data-hero-slide muted playsinline class="absolute inset-0 h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000">
      <source src="/videos/home/eventer.mp4?v=20260821a" type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-al-navy/80 via-al-navy/45 to-al-navy/20"></div>
    <div class="relative z-10 flex h-full flex-col justify-center px-6 sm:px-8 lg:px-10">
      <div class="w-full">
        <p class="text-[11px] font-semibold uppercase leading-relaxed tracking-[0.22em] text-white sm:text-xs">
          Long Term Equine Performance<br />
          Starts Here
        </p>
        <h1 class="mt-5 whitespace-nowrap text-[clamp(2.5rem,9.2vw,7.25rem)] font-bold leading-none tracking-tight text-white" style="font-family: Calibri, Carlito, 'Segoe UI', sans-serif;">
          Feel the Difference
        </h1>
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 bg-al-orange"></div>
</section>

<!-- HORSE TRUTHS: auto slide bar, 2 at a time -->
<section class="panel-white flex min-h-[calc(100svh-6.75rem)] w-full flex-col justify-center px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  <div class="mx-auto flex w-full max-w-none flex-col items-center text-center">
    <div class="eyebrow justify-center text-al-navy">Horse Truths</div>
    <h2 class="font-display mt-5 max-w-5xl text-[clamp(2.5rem,5.5vw,4.25rem)] font-medium leading-[1.1] text-black">
      Seven truths behind every Animalife formulation.
    </h2>
  </div>
  <div class="mt-14 w-full overflow-hidden" data-truth-slider data-auto-slider>
    <div class="slider-track" data-truth-track>
      {{#each horseTruths}}
      <div class="w-full shrink-0 px-1 md:w-1/2 md:px-6 lg:px-10" data-truth-slide>
        <div class="h-full border-b border-al-line pb-8 text-left md:border-b-0 md:border-r md:pr-10">
          <span class="font-display text-4xl font-medium text-al-navy/25 sm:text-5xl">{{#if (gt this.n 9)}}{{this.n}}{{else}}0{{this.n}}{{/if}}</span>
          <p class="font-display mt-4 text-xl font-medium text-black sm:text-2xl">{{this.title}}</p>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-al-ink/70 sm:text-base">{{this.body}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  <div class="mt-8 flex justify-center gap-2 md:-translate-x-6 lg:-translate-x-10" data-truth-dots></div>
</section>

<!-- INSPIRED BY NATURE. PROVEN BY SCIENCE — copy | still-life | process + ingredient strip -->
<section class="mission-section" id="mission">
  <div class="section">
    <div class="mission-panel">
      <div class="mission-panel__copy">
        <p class="mission-panel__eyebrow">Inspired by Nature. Proven by Science.</p>
        <div class="mission-panel__rule" aria-hidden="true"></div>
        <h2 class="mission-panel__title">
          Powerful Ingredients.<br />Purposeful Nutrition.
        </h2>
        <div class="mission-panel__rule" aria-hidden="true"></div>
        <p class="mission-panel__body">We combine nature&rsquo;s most powerful compounds with advanced nutritional science to create solutions that work with your animal&rsquo;s biology&mdash;not against it.</p>
      </div>

      <div class="mission-panel__media">
        <img
          src="/images/home/ingredients-photo.jpg?v=20260814h"
          alt="Botanical herbs, mortar and pestle, powders, and laboratory flask"
          width="1188"
          height="912"
          loading="lazy"
        />
      </div>

      <div class="mission-panel__process">
        <p class="mission-panel__process-label">Designed to Help Animals</p>
        <div class="mission-panel__steps">
          <div class="mission-panel__step">
            <div class="mission-panel__icon">{{{icon "leaf" "w-5 h-5"}}}</div>
            <p class="mission-panel__step-label">Heal</p>
          </div>
          <span class="mission-panel__arrow" aria-hidden="true">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="mission-panel__step">
            <div class="mission-panel__icon">{{{icon "horse" "w-5 h-5"}}}</div>
            <p class="mission-panel__step-label">Perform</p>
          </div>
          <span class="mission-panel__arrow" aria-hidden="true">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="mission-panel__step">
            <div class="mission-panel__icon">{{{icon "clock" "w-5 h-5"}}}</div>
            <p class="mission-panel__step-label">Recover</p>
          </div>
          <span class="mission-panel__arrow" aria-hidden="true">{{{icon "arrow-right" "w-3.5 h-3.5"}}}</span>
          <div class="mission-panel__step">
            <div class="mission-panel__icon">{{{icon "heart" "w-5 h-5"}}}</div>
            <p class="mission-panel__step-label">Thrive</p>
          </div>
        </div>
        <div class="mission-panel__banner">
          Longer Health. Better Performance. A Better Life.
        </div>
      </div>
    </div>

    <div class="mission-ingredients">
      {{#each featuredIngredients}}
      <div class="mission-ingredient">
        <div class="mission-ingredient__media">
          <img src="{{this.image}}?v=20260814n" alt="{{this.name}}" width="720" height="720" loading="lazy" />
        </div>
        <p class="mission-ingredient__name">{{this.name}}</p>
        <p class="mission-ingredient__origin">{{{icon "map-pin" "w-3 h-3 inline-block align-[-1px]"}}} Origin: {{this.origin}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- OUR STANDARDS -->
<section class="panel-white border-t border-al-line">
  <div class="section text-center">
    <h2 class="font-display text-4xl font-medium text-al-navy sm:text-5xl">Our Standards</h2>
    <div class="mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-5 sm:gap-8">
      {{#each standards}}
      <div class="flex flex-col items-center">
        <div class="flex h-14 w-14 items-center justify-center text-al-navy">{{{icon this.icon "w-10 h-10"}}}</div>
        <p class="mt-5 text-sm font-semibold leading-snug text-al-navy">
          {{this.line1}}<br />{{this.line2}}
        </p>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS + benefits table -->
<section class="panel-grey">
  <div class="section">
    <div>
      <div class="eyebrow">Featured Products</div>
      <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Natural &ndash; Safe &ndash; FEI Clean Sport Compliant</h2>
    </div>
    <div class="mt-12 overflow-hidden" data-auto-slider>
      <div class="slider-track" data-products-track>
        {{#each featuredProducts}}
        <div class="w-full shrink-0 px-2 sm:w-1/2 lg:w-1/4" data-products-slide>
          <a href="/shop/product/{{this.slug}}" class="card product-card group flex h-full flex-col items-center overflow-hidden p-6 text-center">
            {{> product-media image=this.image alt=this.trademark tagline=this.tagline}}
            <div class="flex flex-1 flex-col items-center pt-2">
              <div class="flex justify-center gap-0.5 text-al-navy">
                {{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}
              </div>
              <p class="font-display mt-3 text-lg font-semibold text-al-navy">{{this.trademark}}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-navy/55">{{this.category}}</p>
              <span class="font-display mt-4 text-lg font-medium text-al-navy">{{currency this.price}}</span>
            </div>
          </a>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="mt-14">
      <h3 class="font-display text-2xl font-medium text-al-navy">Ingredients &amp; Benefits</h3>
      <div class="mt-6 overflow-x-auto rounded-none border border-al-line bg-white">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-al-navy-light text-white">
              <th class="px-5 py-4 font-semibold">Product</th>
              <th class="px-5 py-4 font-semibold">Ingredients</th>
              <th class="px-5 py-4 font-semibold">Ingredient Benefits</th>
              <th class="px-5 py-4 font-semibold">Performance Benefits</th>
              <th class="px-5 py-4 font-semibold">Long-Term Wellness</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
            {{#with (lookup this.ingredientBenefits 0) as |row|}}
            <tr class="border-t border-al-line align-top odd:bg-white even:bg-al-panel">
              <td class="px-5 py-5 font-display font-medium text-al-navy">{{../trademark}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.ingredient}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.benefit}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.performance}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.wellness}}</td>
            </tr>
            {{/with}}
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- INSPIRED BY NATURE — soft white fade into horse (matches reference) -->
