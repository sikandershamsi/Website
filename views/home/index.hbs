<!-- TESTIMONIALS slider 2 at a time -->
<section class="panel-grey border-t border-al-line">
  <div class="section text-center">
    <h2 class="font-display text-4xl font-medium text-al-navy sm:text-5xl">Testimonials</h2>
    <p class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl lg:text-[2.75rem]">Trusted by riders who expect results.</p>
    <div class="mt-14 overflow-hidden" data-testimonial-slider data-auto-slider>
      <div class="slider-track gap-0" data-testimonial-track>
        {{#each testimonials}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-testimonial-slide>
          <div class="card h-full p-6 text-left">
            <div class="flex gap-0.5 text-al-navy">
              {{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}{{{icon "star-solid" "w-4 h-4"}}}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy">{{this.author}} <span class="text-al-ink/40">&middot; {{this.product}}</span></p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    <div class="mt-6 flex justify-center gap-2" data-testimonial-dots></div>
  </div>
</section>

