  <div class="section !py-10 lg:!py-14">
    <div class="inspired-blend">
      <div class="inspired-blend__media-wrap">
        <img
          src="/images/home/inspired-nature-horse.jpg"
          alt="White horse in a sunlit wildflower meadow"
