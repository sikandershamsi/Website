    <div class="feel-difference">
      <div class="pt-8 text-center">
        <img src="/images/brand/animalife-logo.webp" alt="Animalife USA" class="mx-auto h-10 w-auto brightness-0 invert" />
      </div>
      <div class="feel-difference__panels">
        <div class="feel-difference__panel">
          <img src="/images/ambassadors/disciplines/jumping.jpg" alt="Show jumping" />
        </div>
        <div class="feel-difference__panel">
          <img src="/images/ambassadors/disciplines/western.jpg" alt="Western reining" />
        </div>
        <div class="feel-difference__panel">
          <img src="/images/ambassadors/disciplines/dressage.jpg" alt="Dressage" />
        </div>
