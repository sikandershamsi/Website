<!-- HERO -->
<section class="relative overflow-hidden bg-al-navy text-white">
  <div class="pointer-events-none absolute -right-24 top-0 h-full w-[60%] text-white/5">
    {{> horse-mark class="h-full w-full"}}
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-al-orange via-al-orange-light to-al-orange"></div>
  <div class="relative z-10 mx-auto flex min-h-[58vh] max-w-7xl flex-col justify-center px-6 py-20 sm:min-h-[62vh] sm:px-8 lg:px-10">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-al-orange-light">Long Term Equine Performance Starts Here</p>
    <h1 class="font-display mt-5 max-w-2xl text-5xl font-medium leading-[1.05] sm:text-6xl lg:text-7xl">Feel the Difference</h1>
  </div>
</section>

<!-- HORSE TRUTHS: sliding bar, 2 at a time -->
<section class="panel-white section">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="eyebrow">Horse Truths</div>
      <h2 class="font-display mt-4 max-w-2xl text-3xl font-medium text-al-navy sm:text-4xl">Seven truths behind every Animalife formulation.</h2>
    </div>
    <div class="flex gap-2">
      <button type="button" data-truth-prev class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
      <button type="button" data-truth-next class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
    </div>
  </div>
  <div class="mt-10 overflow-hidden" data-truth-slider data-auto-slider>
    <div class="slider-track" data-truth-track>
      {{#each horseTruths}}
      <div class="w-full shrink-0 px-1 md:w-1/2 md:px-3" data-truth-slide>
        <div class="h-full border-b border-al-line pb-8 md:border-b-0 md:border-r md:pr-8">
          <span class="font-display text-3xl font-medium text-al-orange/40">{{#if (gt this.n 9)}}{{this.n}}{{else}}0{{this.n}}{{/if}}</span>
          <p class="font-display mt-3 text-lg font-medium text-al-navy">{{this.title}}</p>
          <p class="mt-2 text-sm leading-relaxed text-al-ink/70">{{this.body}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  <div class="mt-6 flex justify-center gap-2" data-truth-dots></div>
</section>

<!-- MISSION + INGREDIENTS combined panel -->
<section class="panel-grey">
  <div class="section grid items-start gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
    <div class="max-w-xl">
      <div class="eyebrow">Inspired by Nature. Proven by Science.</div>
      <h2 class="font-display mt-5 text-4xl font-medium leading-tight text-al-navy sm:text-5xl">Powerful Ingredients. Purposeful Nutrition.</h2>
      <p class="mt-6 text-sm leading-relaxed text-al-ink/75">We combine nature's most powerful compounds with advanced nutritional science to create solutions that work with your animal's body&mdash;not against it.</p>
      <div class="mt-8 flex items-center gap-3 sm:gap-5">
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-al-line text-al-navy">{{{icon "leaf" "w-5 h-5"}}}</div>
          <p class="mt-2 text-[10px] font-semibold uppercase tracking-wide text-al-navy">Heal</p>
        </div>
        <span class="text-al-ink/30">{{{icon "arrow-right" "w-4 h-4"}}}</span>
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-al-line text-al-navy">{{{icon "horse" "w-5 h-5"}}}</div>
          <p class="mt-2 text-[10px] font-semibold uppercase tracking-wide text-al-navy">Perform</p>
        </div>
        <span class="text-al-ink/30">{{{icon "arrow-right" "w-4 h-4"}}}</span>
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-al-line text-al-navy">{{{icon "clock" "w-5 h-5"}}}</div>
          <p class="mt-2 text-[10px] font-semibold uppercase tracking-wide text-al-navy">Recover</p>
        </div>
        <span class="text-al-ink/30">{{{icon "arrow-right" "w-4 h-4"}}}</span>
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-al-line text-al-navy">{{{icon "heart" "w-5 h-5"}}}</div>
          <p class="mt-2 text-[10px] font-semibold uppercase tracking-wide text-al-navy">Thrive</p>
        </div>
      </div>
      <div class="mt-8 rounded-full border border-al-orange/40 px-5 py-2.5 text-center text-xs font-semibold uppercase tracking-wide text-al-navy">Longer Health. Better Performance. A Better Life.</div>
    </div>

    <div class="overflow-hidden rounded-[1.25rem] border border-al-line bg-white shadow-sm">
      <img
        src="/images/home/ingredients-photo.jpg"
        alt="Natural botanical ingredients used in Animalife formulations"
        class="w-full object-contain"
      />
      <div class="grid grid-cols-3 gap-x-3 gap-y-6 border-t border-al-line px-5 py-6 sm:gap-y-7 sm:px-6 sm:py-7">
        {{#each featuredIngredients}}
        <div class="text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-al-panel text-al-navy">{{{icon this.icon "w-5 h-5"}}}</div>
          <p class="mt-2.5 text-[11px] font-semibold leading-snug text-al-navy sm:text-xs">{{this.name}}</p>
          <p class="mt-0.5 text-[10px] leading-snug text-al-ink/45">{{this.origin}}</p>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- OUR STANDARDS -->
<section class="panel-white">
  <div class="section text-center">
    <h2 class="font-display text-3xl font-medium text-al-navy sm:text-4xl">Our Standards</h2>
    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-10 sm:grid-cols-5">
      {{#each standards}}
      <div>
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-al-panel text-al-navy">{{{icon this.icon "w-6 h-6"}}}</div>
        <p class="mt-3 text-sm font-semibold text-al-navy">{{this.title}}</p>
      </div>
      {{/each}}
    </div>
    <a href="/about/difference" class="mt-10 inline-block text-sm font-semibold uppercase tracking-wide text-al-orange underline underline-offset-4">Learn More</a>
  </div>
</section>

<!-- FEATURED PRODUCTS + benefits table -->
<section class="panel-grey">
  <div class="section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="eyebrow">Featured Products</div>
        <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Natural &ndash; Safe &ndash; FEI Clean Sport Compliant</h2>
      </div>
      <div class="flex items-center gap-4">
        <a href="/shop" class="btn-outline">Shop All Products</a>
        <div class="flex gap-2">
          <button type="button" data-products-prev class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line bg-white text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
          <button type="button" data-products-next class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line bg-white text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
        </div>
      </div>
    </div>
    <div class="mt-12 overflow-hidden" data-auto-slider>
      <div class="slider-track" data-products-track>
        {{#each products}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-products-slide>
          <a href="/shop/product/{{this.slug}}" class="card group flex h-full flex-col items-center overflow-hidden p-6 text-center transition-shadow hover:shadow-lg">
            <div class="flex aspect-[4/5] w-full items-center justify-center">
              <img src="{{this.image}}" alt="{{this.trademark}}" class="h-full w-auto object-contain" />
            </div>
            <div class="flex flex-1 flex-col items-center pt-2">
              <p class="font-display text-lg font-semibold text-al-navy">{{this.trademark}}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-al-orange">{{this.category}}</p>
              <p class="font-display mt-2 text-lg font-medium text-al-navy">{{this.tagline}}</p>
              <div class="mt-3 flex justify-center gap-0.5 text-al-ink">
                {{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}
              </div>
              <span class="font-display mt-4 text-lg font-medium text-al-navy">{{currency this.price}}</span>
            </div>
          </a>
        </div>
        {{/each}}
      </div>
    </div>
    <div class="mt-6 flex justify-center gap-2" data-products-dots></div>

    <div class="mt-14">
      <h3 class="font-display text-2xl font-medium text-al-navy">Ingredients &amp; Benefits</h3>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-al-line bg-white">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-al-navy-light text-white">
              <th class="px-5 py-4 font-semibold">Product</th>
              <th class="px-5 py-4 font-semibold">Ingredients</th>
              <th class="px-5 py-4 font-semibold">Ingredient Benefits</th>
              <th class="px-5 py-4 font-semibold">Performance Benefits</th>
              <th class="px-5 py-4 font-semibold">Long-Term Wellness</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
            {{#with (lookup this.ingredientBenefits 0) as |row|}}
            <tr class="border-t border-al-line align-top odd:bg-white even:bg-al-panel">
              <td class="px-5 py-5 font-display font-medium text-al-navy">{{../trademark}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.ingredient}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.benefit}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.performance}}</td>
              <td class="px-5 py-5 text-al-ink/70">{{row.wellness}}</td>
            </tr>
            {{/with}}
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- INSPIRED BY NATURE — soft-blended text + photo -->
<section class="panel-grey">
  <div class="section">
    <div class="inspired-blend">
      <img
        src="/images/home/inspired-nature-horse.jpg"
        alt="White horse in a sunlit wildflower meadow"
        class="inspired-blend__media"
      />
      <div class="inspired-blend__veil" aria-hidden="true"></div>
      <div class="inspired-blend__copy">
        <div class="eyebrow">Inspired by Nature</div>
        <h2 class="font-display mt-5 text-4xl font-medium leading-tight text-al-navy sm:text-5xl">Inspired by nature.</h2>
        <div class="mt-5 h-px w-10 bg-al-orange" aria-hidden="true"></div>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-al-ink/80">Inspired by our founder's enduring passion for horses and a simple belief that nature often holds the answers modern medicine overlooks, Animalife was founded to explore the extraordinary <span class="font-semibold text-al-orange">healing potential of botanicals</span>.</p>
        <div class="mt-5 h-px w-10 bg-al-orange" aria-hidden="true"></div>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-al-ink/80">By combining nature's most powerful ingredients with advanced nutritional science, we create innovative formulations that address the root causes of disease and dysfunction&mdash;empowering horses to perform with <span class="font-semibold text-al-navy">greater strength</span>, recover <span class="font-semibold text-al-navy">more naturally</span>, and enjoy <span class="font-semibold text-al-navy">longer, healthier lives</span>.</p>
      </div>
    </div>
  </div>
</section>

<!-- CLEAN SPORT COMPLIANT -->
<section class="panel-white">
  <div class="section">
    <div class="rounded-[1.75rem] bg-al-navy px-8 py-14 text-center text-white sm:px-14">
      <img src="/images/badges/clean-sport-plus.png" alt="CleanSport+ Tested badge" class="mx-auto h-20 w-auto" />
      <div class="eyebrow mt-6 justify-center !text-al-orange-light">FEI Clean Sport Compliant</div>
      <h2 class="font-display mt-4 text-3xl font-medium sm:text-4xl">Natural. Safe. Competition Compliant.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-white/75">Every Animalife formulation is screened for Naturally Occurring Prohibited Substances (NOPS) and Herbal, Spice &amp; Plant Substance (HSPS) contamination through our CleanSport+ Programme&mdash;giving owners, trainers, and riders complete confidence on competition day.</p>
      <a href="/about/difference" class="btn-outline-light mt-8">Learn About CleanSport+</a>
    </div>
  </div>
</section>

<!-- TESTIMONIALS slider 2 at a time -->
<section class="panel-grey">
  <div class="section">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="eyebrow">Testimonials</div>
        <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">Trusted by riders who expect results.</h2>
      </div>
      <div class="flex gap-2">
        <button type="button" data-testimonial-prev class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line bg-white text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Previous">{{{icon "arrow-left" "w-4 h-4"}}}</button>
        <button type="button" data-testimonial-next class="flex h-10 w-10 items-center justify-center rounded-full border border-al-line bg-white text-al-navy hover:border-al-orange hover:text-al-orange" aria-label="Next">{{{icon "arrow-right" "w-4 h-4"}}}</button>
      </div>
    </div>
    <div class="mt-10 overflow-hidden" data-testimonial-slider data-auto-slider>
      <div class="slider-track gap-0" data-testimonial-track>
        {{#each testimonials}}
        <div class="w-full shrink-0 px-2 md:w-1/2" data-testimonial-slide>
          <div class="card h-full p-6">
            <div class="flex gap-0.5 text-al-orange">
              {{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}{{{icon "star" "w-4 h-4"}}}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-al-ink/75">&ldquo;{{this.quote}}&rdquo;</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy">{{this.author}} <span class="text-al-ink/40">&middot; {{this.product}}</span></p>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

