{{> page-header eyebrow="Powerful Ingredients" heading="Ingredient Library" subheading="Inspired by nature. Proven by science. Every ingredient is chosen for its purity, consistency, and scientific relevance."}}
{{> science-subnav}}

<section class="section">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#each ingredientLibrary}}
    <div class="card p-6">
      <div class="flex items-start justify-between gap-3">
        <p class="font-display text-lg font-medium text-al-navy">{{this.name}}</p>
        <span class="tag-pill shrink-0">{{this.origin}}</span>
      </div>
      <p class="mt-3 text-sm text-al-ink/70">{{this.note}}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {{#each this.products}}
        <span class="rounded-full bg-al-orange/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-al-orange">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</section>
