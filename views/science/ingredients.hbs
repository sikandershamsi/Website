<section class="panel-white">
  <div class="section">
    <div class="inspired-blend about-hero-blend">
      <div class="inspired-blend__media-wrap">
        <img
          src="/images/science/rooted-in-nature.jpg"
          alt="Botanical leaves and river stones on a lab surface"
          class="inspired-blend__media"
        />
        <div class="inspired-blend__veil" aria-hidden="true"></div>
      </div>
      <div class="inspired-blend__copy">
        <div class="eyebrow">Powerful Ingredients</div>
        <h1 class="font-display mt-4 text-4xl font-medium text-al-navy sm:text-5xl">Science Rooted <span class="text-al-navy/55">in Nature.</span></h1>
        <p class="mt-5 text-sm leading-relaxed text-al-ink/75">Every ingredient is selected to serve a specific purpose&mdash;working together to support the healing process at the cellular level to ensure optimized performance and long-term wellness.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#each ingredientLibrary}}
    <div class="card p-6">
      <div class="flex items-start justify-between gap-3">
        <p class="font-display text-lg font-medium text-al-navy">{{this.name}}</p>
        <span class="tag-pill shrink-0">{{this.origin}}</span>
      </div>
      <p class="mt-3 text-sm text-al-ink/70">{{this.note}}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {{#each this.products}}
        <span class="rounded-none bg-al-navy/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-al-navy/55">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
</section>
