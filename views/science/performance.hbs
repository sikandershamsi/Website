<section class="science-hero" aria-label="The Science Behind Performance">
  <img
    src="/images/science/hero-performance-board.jpg?v=20260821a"
    srcset="/images/science/hero-performance-board.jpg?v=20260821a 1752w, /images/science/hero-performance-board@2x.jpg?v=20260821a 3504w"
    sizes="100vw"
    alt="The Science Behind Performance. Nature. Research. Results. We combine the wisdom of nature with advanced nutritional science to create targeted formulations that deliver real, measurable results."
    width="1752"
    height="897"
    class="science-hero__board"
  />
</section>

<section class="panel-grey">
  <div class="section text-center">
    <h2 class="font-display text-3xl font-medium text-al-navy sm:text-4xl lg:text-[2.75rem]">Our Philosophy</h2>
    <div class="mx-auto mt-5 h-0.5 w-12 bg-al-orange" aria-hidden="true"></div>
    <p class="font-display mt-8 text-2xl font-medium leading-snug text-al-navy sm:text-[1.75rem] sm:leading-snug">
      Most equine supplements begin with ingredients.<br class="hidden sm:inline" />
      Animalife<sup>&reg;</sup> begins with physiology.
    </p>
    <p class="mt-8 text-sm leading-relaxed text-al-ink/75 sm:text-[15px]">
      Before selecting a single ingredient, we identify the biological system we want to support and understand how that system influences performance, recovery, and long-term health. Every formulation is then built from the ground up using scientifically selected nutrients that work synergistically to support the body's natural regulatory processes.
    </p>
  </div>
</section>

<section class="panel-white border-t border-al-line">
  <div class="targeted-support">
    <img
      src="/images/science/targeted-support-board.jpg?v=20260821a"
      srcset="/images/science/targeted-support-board.jpg?v=20260821a 1536w, /images/science/targeted-support-board@2x.jpg?v=20260821a 3072w"
      sizes="100vw"
      alt="Targeted Support. Targeted support for the systems that power performance, recovery, and long-term health. Our science-backed solutions work in harmony with your horse's body to support what matters most. VetroFlex cartilage and connective tissue. VetroFen inflammation and pain relief. VetroFit kidney homeostasis management."
      width="1536"
      height="1024"
      class="targeted-support__board"
    />
    <nav class="targeted-support__hotspots" aria-label="Targeted support products">
      {{#each targetedSupportProducts}}
      <a href="{{this.href}}" class="targeted-support__hotspot" aria-label="{{this.name}} — {{this.focus}}"></a>
      {{/each}}
    </nav>
  </div>
</section>

<section class="panel-white">
  <div class="section">
    <h2 class="font-display text-3xl font-medium text-al-navy sm:text-4xl">Product Science Comparison</h2>
    <p class="mt-4 max-w-3xl text-sm text-al-ink/70">Every Animalife formula combines premium natural ingredients with science-backed nutritional research to deliver measurable physiological benefits.</p>
    <div class="mt-10 overflow-x-auto rounded-none border border-al-line">
      <table class="w-full min-w-[960px] border-collapse text-left text-sm">
        <thead>
          <tr class="bg-al-navy text-white">
            <th class="px-5 py-4 font-semibold">Product Name</th>
            <th class="px-5 py-4 font-semibold">Ingredients</th>
            <th class="px-5 py-4 font-semibold">Ingredient Benefits</th>
            <th class="px-5 py-4 font-semibold">Performance Benefits</th>
            <th class="px-5 py-4 font-semibold">Long-Term Health &amp; Wellness</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          {{#with (lookup this.ingredientBenefits 0) as |row|}}
          <tr class="border-t border-al-line align-top odd:bg-white even:bg-al-panel">
            <td class="px-5 py-5">
              <div class="mb-3 flex h-28 w-28 items-center justify-center rounded-none border border-al-line bg-white p-3">
                <img src="{{../image}}" alt="{{../trademark}}" class="max-h-full max-w-full object-contain" />
              </div>
              <a href="/shop/product/{{../slug}}" class="font-display font-medium text-al-navy hover:text-al-navy">{{../trademark}}</a>
              <p class="mt-1 text-[11px] font-sans font-normal uppercase tracking-wide text-al-ink/50">{{../category}}</p>
            </td>
            <td class="px-5 py-5 text-al-ink/70">{{row.ingredient}}</td>
            <td class="px-5 py-5 text-al-ink/70">{{row.benefit}}</td>
            <td class="px-5 py-5 text-al-ink/70">{{row.performance}}</td>
            <td class="px-5 py-5 text-al-ink/70">{{row.wellness}}</td>
          </tr>
          {{/with}}
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="rooted-nature" aria-label="Science Rooted In Nature">
  <img
    src="/images/science/rooted-in-nature-board.jpg?v=20260821b"
    srcset="/images/science/rooted-in-nature-board.jpg?v=20260821b 1749w, /images/science/rooted-in-nature-board@2x.jpg?v=20260821b 3498w"
    sizes="100vw"
    alt="Science Rooted In Nature. Every ingredient is selected to serve a specific purpose—working together to support the healing process at the cellular level to ensure optimized performance and long-term wellness."
    width="1749"
    height="856"
    class="rooted-nature__board"
  />
</section>

{{#if vetrofenPrimary.primaryIngredients}}
<section class="primary-ingredients" aria-labelledby="primary-ingredients-heading">
  <div class="primary-ingredients__panel">
    <p class="primary-ingredients__brand">{{vetrofenPrimary.trademark}}</p>
    <h2 id="primary-ingredients-heading" class="primary-ingredients__title">Primary Ingredients</h2>
    <div class="primary-ingredients__title-rule" aria-hidden="true"></div>
    <ul class="primary-ingredients__grid">
      {{#each vetrofenPrimary.primaryIngredients}}
      <li class="primary-ingredients__item">
        <div class="primary-ingredients__media">
          <img src="{{this.image}}?v=20260814b" alt="{{this.name}}" width="640" height="640" loading="lazy" />
        </div>
        <p class="primary-ingredients__name">{{this.name}}</p>
        <div class="primary-ingredients__rule" aria-hidden="true"></div>
        <p class="primary-ingredients__origin">{{this.origin}}</p>
      </li>
      {{/each}}
    </ul>
    {{#if vetrofenPrimary.primaryIngredientsFooter}}
    <p class="primary-ingredients__footer">{{vetrofenPrimary.primaryIngredientsFooter}}</p>
    {{/if}}
  </div>
</section>
{{/if}}
