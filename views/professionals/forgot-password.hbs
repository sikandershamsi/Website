{{> page-header eyebrow="Professionals" heading="Forgot Password" subheading="We'll email you a link to reset it."}}

<section class="section flex justify-center">
  <div class="card w-full max-w-md p-8">
    {{#if submitted}}
    <p class="text-center text-sm text-al-ink/70">If that email belongs to an approved affiliate account, a reset link is on its way. It expires in 1 hour.</p>
    <a href="/professionals/login" class="btn-outline mt-6 block text-center">Back to Login</a>
    {{else}}
    <form action="/professionals/forgot-password" method="post" class="space-y-5">
      <div>
        <label class="field-label" for="email">Email Address</label>
        <input id="email" name="email" type="email" required class="input-field" />
      </div>
      <button type="submit" class="btn-primary w-full">Send Reset Link</button>
    </form>
    {{/if}}
  </div>
</section>
