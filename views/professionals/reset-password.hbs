{{> page-header eyebrow="Professionals" heading="Reset Password"}}

<section class="section flex justify-center">
  <div class="card w-full max-w-md p-8">
    {{#if success}}
    <p class="text-center text-sm text-al-ink/70">Your password has been updated.</p>
    <a href="/professionals/login" class="btn-primary mt-6 block text-center">Log In</a>
    {{else}}
    {{#if notice}}
    <div class="mb-6 rounded-none bg-al-navy/10 p-4 text-sm text-al-navy">{{notice}} <a href="/professionals/forgot-password" class="font-semibold underline">Request a new link</a>.</div>
    {{/if}}
    {{#if token}}
    <form action="/professionals/reset-password" method="post" class="space-y-5">
      <input type="hidden" name="token" value="{{token}}" />
      <div>
        <label class="field-label" for="newPassword">New Password</label>
        <input id="newPassword" name="newPassword" type="password" minlength="8" required class="input-field" />
      </div>
      <button type="submit" class="btn-primary w-full">Set New Password</button>
    </form>
    {{else}}
    <p class="text-center text-sm text-al-ink/70">This reset link is missing its token. <a href="/professionals/forgot-password" class="font-semibold text-al-navy underline">Request a new one</a>.</p>
    {{/if}}
    {{/if}}
  </div>
</section>
