<section class="pro-hero pro-hero--board" aria-label="Affiliate Rewards Program">
  <img
    src="/images/professionals/hero-board.jpg?v=20260903a"
    sizes="100vw"
    alt="Affiliate Rewards Program. Partner with Purpose. Rewarding Results. Join a trusted network of equine professionals and earn generous rewards while making a real difference in horses' lives. For trainers, veterinarians, equine therapists, nutritionists, and equestrian influencers and content creators."
    width="2000"
    height="870"
    class="pro-hero__board"
  />
</section>

<section class="panel-white">
  <div class="section text-center">
    {{> section-head eyebrow="The Highest Paying Affiliate Program in the Industry" heading="We Believe Partners Should Be Rewarded Like Partners."}}
    <p class="font-display mt-2 text-4xl font-semibold text-al-navy/55">Animalife pays up to 30%</p>
    <div class="mx-auto mt-8 grid max-w-5xl gap-6 text-left sm:grid-cols-2">
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Direct Referral Commission</p>
        <p class="mt-2 text-sm text-al-ink/70">Earn commissions every time a customer purchases through your referral link.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Recurring Customer Revenue</p>
        <p class="mt-2 text-sm text-al-ink/70">As customers continue purchasing products, your commissions continue to grow.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Complimentary Products</p>
        <p class="mt-2 text-sm text-al-ink/70">Receive products for personal use, demonstrations, client education, and promotional activities.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Exclusive Promotions</p>
        <p class="mt-2 text-sm text-al-ink/70">Access special affiliate-only campaigns and incentives throughout the year.</p>
      </div>
    </div>
  </div>
</section>

<section class="panel-grey" id="calculator">
  <div class="section">
    {{> section-head eyebrow="Affiliate Earnings Calculator" heading="See what your network could be worth."}}
    <div data-affiliate-calculator class="mt-10 grid gap-10 rounded-none border border-al-line bg-white p-8 lg:grid-cols-2">
      <div class="space-y-7">
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>How many horses do you influence?</span><span data-calc-horses-val>250</span></div>
          <input data-calc-horses type="range" min="10" max="1000" step="10" value="250" class="mt-3 w-full accent-al-orange" />
        </div>
        <div>
          <label class="field-label">Average annual supplement spend (per horse)</label>
          <input data-calc-spend type="number" value="500" min="0" step="50" class="input-field" />
        </div>
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>Expected conversion</span><span data-calc-conversion-val>10%</span></div>
          <input data-calc-conversion type="range" min="1" max="100" step="1" value="10" class="mt-3 w-full accent-al-orange" />
        </div>
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>Average commission</span><span data-calc-commission-val>20%</span></div>
          <input data-calc-commission type="range" min="5" max="40" step="1" value="20" class="mt-3 w-full accent-al-orange" />
        </div>
      </div>
      <div class="flex flex-col items-center justify-center rounded-none border-t-4 border-al-orange bg-al-orange/8 p-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-orange">Estimated Annual Earnings</p>
        <p data-calc-output class="font-display mt-4 text-5xl font-semibold text-al-orange">$25,000</p>
        <p class="mt-4 text-xs text-al-ink/55">Illustrative estimate only. Actual results vary by referral activity and commission tier.</p>
        <a href="/professionals/apply" data-calc-apply-link class="btn mt-8 bg-al-orange text-white hover:bg-al-orange/90">Become an Affiliate</a>
      </div>
    </div>

    <div class="mt-12 mx-auto max-w-3xl text-center">
      <h3 class="section-heading section-heading--sm">Annual Joint Supplement Spending</h3>
      <p class="mt-5 text-sm leading-relaxed text-al-ink/75 sm:text-base">Competitive horse owners spend an average of $1,500 to $3,500 annually per horse on comprehensive joint care and performance supplement programs.</p>
      <p class="mt-4 text-sm leading-relaxed text-al-ink/75 sm:text-base">For elite equine athletes requiring multi-targeted, premium specialty formulations, costs can exceed $5,000 annually.</p>
    </div>
  </div>
</section>

<section class="panel-white border-t border-al-line">
  <div class="section text-center">
    <p class="mx-auto max-w-2xl text-sm text-al-ink/70">Join a growing network of equine professionals who are helping horses perform better, recover faster, and enjoy longer, healthier careers.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/professionals/apply" class="btn-primary">Apply Now</a>
      <a href="mailto:partnerships@animalifeusa.com" class="btn-outline">Schedule a Discovery Call</a>
    </div>
  </div>
</section>
