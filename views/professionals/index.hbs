<section class="pro-hero">
  <div class="pro-hero__banner">
    <img
      src="/images/affiliates/hero-horse-clean.jpg"
      alt="Chestnut horse portrait"
      class="pro-hero__media"
    />
    <div class="pro-hero__veil" aria-hidden="true"></div>
    <div class="pro-hero__copy">
      <span class="pro-hero__rule" aria-hidden="true"></span>
      <p class="pro-hero__eyebrow">Affiliate Rewards Program</p>
      <span class="pro-hero__rule" aria-hidden="true"></span>
      <h1 class="pro-hero__title">Partner with Purpose.<br />Rewarding Results.</h1>
      <p class="pro-hero__lede">
        <span class="pro-hero__em">Join</span> a trusted network of equine professionals and earn
        <span class="pro-hero__em">generous rewards</span> while making a
        <span class="pro-hero__em">real difference</span> in horses&rsquo; lives.
      </p>
    </div>
  </div>

  <div class="pro-hero__roles">
    {{#each affiliateAudiences}}
    <article class="pro-hero__role">
      <div class="pro-hero__role-media">
        <img src="{{this.image}}" alt="{{this.title}}" class="pro-hero__role-img" />
      </div>
      <div class="pro-hero__role-meta">
        <div class="pro-hero__role-icon">{{{icon this.icon "w-7 h-7"}}}</div>
        <h2 class="pro-hero__role-title">{{this.title}}</h2>
        <p class="pro-hero__role-body">{{this.body}}</p>
      </div>
    </article>
    {{/each}}
  </div>
</section>

<section class="panel-white">
  <div class="section text-center">
    <div class="eyebrow mx-auto justify-center">The Highest Paying Affiliate Program in the Industry</div>
    <h2 class="font-display mt-4 text-3xl font-medium text-al-navy sm:text-4xl">We Believe Partners Should Be Rewarded Like Partners.</h2>
    <p class="font-display mt-3 text-5xl font-semibold text-al-navy/55">Animalife pays up to 40%</p>
    <div class="mt-12 grid gap-6 text-left sm:grid-cols-2">
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Direct Referral Commission</p>
        <p class="mt-2 text-sm text-al-ink/70">Earn commissions every time a customer purchases through your referral link.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Recurring Customer Revenue</p>
        <p class="mt-2 text-sm text-al-ink/70">As customers continue purchasing products, your commissions continue to grow.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Complimentary Products</p>
        <p class="mt-2 text-sm text-al-ink/70">Receive products for personal use, demonstrations, client education, and promotional activities.</p>
      </div>
      <div class="card p-6">
        <p class="font-display text-base font-medium text-al-navy">Exclusive Promotions</p>
        <p class="mt-2 text-sm text-al-ink/70">Access special affiliate-only campaigns and incentives throughout the year.</p>
      </div>
    </div>
  </div>
</section>

<section class="panel-grey" id="calculator">
  <div class="section">
    <div class="eyebrow">Affiliate Earnings Calculator</div>
    <h2 class="font-display mt-4 max-w-2xl text-3xl font-medium text-al-navy sm:text-4xl">See what your network could be worth.</h2>
    <div data-affiliate-calculator class="mt-10 grid gap-10 rounded-none border border-al-line bg-white p-8 lg:grid-cols-2">
      <div class="space-y-7">
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>How many horses do you influence?</span><span data-calc-horses-val>250</span></div>
          <input data-calc-horses type="range" min="10" max="1000" step="10" value="250" class="mt-3 w-full accent-al-navy" />
        </div>
        <div>
          <label class="field-label">Average annual supplement spend (per horse)</label>
          <input data-calc-spend type="number" value="500" min="0" step="50" class="input-field" />
        </div>
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>Expected conversion</span><span data-calc-conversion-val>10%</span></div>
          <input data-calc-conversion type="range" min="1" max="100" step="1" value="10" class="mt-3 w-full accent-al-navy" />
        </div>
        <div>
          <div class="flex justify-between text-sm font-semibold text-al-navy"><span>Average commission</span><span data-calc-commission-val>20%</span></div>
          <input data-calc-commission type="range" min="5" max="40" step="1" value="20" class="mt-3 w-full accent-al-navy" />
        </div>
      </div>
      <div class="flex flex-col items-center justify-center rounded-none bg-al-panel-alt p-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-navy/55">Estimated Annual Earnings</p>
        <p data-calc-output class="font-display mt-4 text-5xl font-semibold text-al-navy">$25,000</p>
        <p class="mt-4 text-xs text-al-ink/55">Illustrative estimate only. Actual results vary by referral activity and commission tier.</p>
        <a href="/professionals/apply" class="btn-primary mt-8">Become an Affiliate</a>
      </div>
    </div>
  </div>
</section>

<section class="panel-white">
  <div class="section text-center">
    <p class="font-display text-3xl font-medium text-al-navy sm:text-4xl">Ready to Feel the Difference?</p>
    <p class="mx-auto mt-5 max-w-2xl text-sm text-al-ink/70">Join a growing network of equine professionals who are helping horses perform better, recover faster, and enjoy longer, healthier careers.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/professionals/apply" class="btn-primary">Apply Now</a>
      <a href="mailto:partnerships@animalifeusa.com" class="btn-outline">Schedule a Discovery Call</a>
    </div>
  </div>
</section>
