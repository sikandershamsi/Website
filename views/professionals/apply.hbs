{{> page-header eyebrow="Animalife Affiliate Partner Program" heading="Application Form" subheading="Thank you for your interest in becoming an Animalife Affiliate Partner. A member of our team will review your submission and contact you within 5–10 business days."}}

<section class="section max-w-3xl">
  {{#if submitted}}
  <div class="card flex flex-col items-center px-8 py-16 text-center">
    <div class="flex h-16 w-16 items-center justify-center rounded-full bg-al-orange/10 text-al-orange">{{{icon "check" "w-8 h-8"}}}</div>
    <p class="font-display mt-6 text-2xl font-medium text-al-navy">Thank you, {{submittedName}}!</p>
    <p class="mt-3 max-w-md text-sm text-al-ink/65">Your Affiliate Partner application has been submitted. Our Affiliate Partnership Team will review it and reach out within 5&ndash;10 business days.</p>
    <div class="mt-8 grid gap-2 text-left text-sm text-al-ink/70">
      <span class="flex items-center gap-2">{{{icon "check" "w-4 h-4 text-al-orange"}}}Application Review</span>
      <span class="flex items-center gap-2">{{{icon "check" "w-4 h-4 text-al-orange"}}}Introductory Discovery Call</span>
      <span class="flex items-center gap-2">{{{icon "check" "w-4 h-4 text-al-orange"}}}Product &amp; Program Overview</span>
      <span class="flex items-center gap-2">{{{icon "check" "w-4 h-4 text-al-orange"}}}Affiliate Agreement Execution</span>
      <span class="flex items-center gap-2">{{{icon "check" "w-4 h-4 text-al-orange"}}}Affiliate Portal Access &amp; Onboarding</span>
    </div>
    <a href="/professionals" class="btn-outline mt-8">Back to Affiliate Program</a>
  </div>
  {{else}}
  <form action="/professionals/apply" method="post" class="space-y-12">

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Applicant Information</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="field-label" for="fullName">Full Name</label><input id="fullName" name="fullName" required class="input-field" /></div>
        <div><label class="field-label" for="businessName">Business Name (if applicable)</label><input id="businessName" name="businessName" class="input-field" /></div>
        <div><label class="field-label" for="title">Title / Position</label><input id="title" name="title" class="input-field" /></div>
        <div><label class="field-label" for="email">Email Address</label><input id="email" name="email" type="email" required class="input-field" /></div>
        <div><label class="field-label" for="phone">Mobile Phone</label><input id="phone" name="phone" type="tel" class="input-field" /></div>
        <div><label class="field-label" for="website">Website</label><input id="website" name="website" class="input-field" /></div>
        <div><label class="field-label" for="facebook">Facebook Page</label><input id="facebook" name="facebook" class="input-field" /></div>
        <div><label class="field-label" for="instagram">Instagram Account</label><input id="instagram" name="instagram" class="input-field" /></div>
        <div><label class="field-label" for="youtube">YouTube Channel</label><input id="youtube" name="youtube" class="input-field" /></div>
        <div class="sm:col-span-2"><label class="field-label" for="businessAddress">Business Address</label><input id="businessAddress" name="businessAddress" class="input-field" /></div>
        <div><label class="field-label" for="city">City</label><input id="city" name="city" class="input-field" /></div>
        <div><label class="field-label" for="state">State / Province</label><input id="state" name="state" class="input-field" /></div>
        <div><label class="field-label" for="zip">Zip / Postal Code</label><input id="zip" name="zip" class="input-field" /></div>
        <div><label class="field-label" for="country">Country</label><input id="country" name="country" value="United States" class="input-field" /></div>
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Professional Background</h2>
      <p class="mt-1 text-sm text-al-ink/60">Please select the category that best describes your primary profession.</p>
      <select name="profession" required class="input-field mt-4 sm:max-w-sm">
        <option value="trainer">Trainer</option>
        <option value="veterinarian">Veterinarian</option>
        <option value="equine-therapist">Equine Therapist</option>
        <option value="breeder">Breeder</option>
        <option value="professional-rider">Professional Rider</option>
        <option value="amateur-rider">Amateur Rider</option>
        <option value="tack-store-owner">Tack Store Owner</option>
        <option value="equine-influencer">Equine Influencer</option>
        <option value="farm-owner-manager">Farm Owner / Manager</option>
        <option value="equine-nutritionist">Equine Nutritionist</option>
        <option value="equine-health-professional">Equine Health Professional</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Experience</h2>
      <p class="mt-1 text-sm text-al-ink/60">How many years have you been involved in the equine industry?</p>
      <select name="experience" required class="input-field mt-4 sm:max-w-sm">
        <option value="under-2">Less than 2 years</option>
        <option value="2-5">2–5 years</option>
        <option value="6-10">6–10 years</option>
        <option value="11-20">11–20 years</option>
        <option value="20-plus">More than 20 years</option>
      </select>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Business Reach</h2>
      <p class="mt-1 text-sm text-al-ink/60">Approximately how many horse owners, riders, clients, or followers do you regularly influence?</p>
      <select name="reach" required class="input-field mt-4 sm:max-w-sm">
        <option value="under-25">Less than 25</option>
        <option value="25-50">25–50</option>
        <option value="51-100">51–100</option>
        <option value="101-250">101–250</option>
        <option value="251-500">251–500</option>
        <option value="500-1000">500–1,000</option>
        <option value="over-1000">More than 1,000</option>
      </select>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Client Profile</h2>
      <p class="mt-1 text-sm text-al-ink/60">Which disciplines best describe your audience? (select all that apply)</p>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {{#each (array "Hunter/Jumper" "Dressage" "Eventing" "Thoroughbred Racing" "Quarter Horse Racing" "Western Performance" "Barrel Racing" "Reining" "Breeding Operations" "Pleasure Horses" "Veterinary Practice" "Therapy/Rehabilitation" "Multi-Discipline")}}
        <label class="flex items-center gap-2 text-sm text-al-ink/75"><input type="checkbox" name="disciplines" value="{{this}}" class="accent-al-orange" />{{this}}</label>
        {{/each}}
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Current Product Recommendations</h2>
      <p class="mt-1 text-sm text-al-ink/60">Do you currently recommend equine supplements or nutraceutical products?</p>
      <div class="mt-3 flex gap-6 text-sm text-al-ink/75">
        <label class="flex items-center gap-2"><input type="radio" name="currentlyRecommends" value="yes" required class="accent-al-orange" />Yes</label>
        <label class="flex items-center gap-2"><input type="radio" name="currentlyRecommends" value="no" class="accent-al-orange" />No</label>
      </div>
      <div class="mt-4">
        <label class="field-label" for="currentBrands">If yes, please list the brands or products you currently recommend</label>
        <input id="currentBrands" name="currentBrands" class="input-field" />
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Why Animalife?</h2>
      <p class="mt-1 text-sm text-al-ink/60">What interests you most about the Affiliate Partner Program?</p>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
        {{#each (array "Industry-Leading Commissions" "Free Product Opportunities" "Innovative Products" "Additional Revenue Stream" "Supporting Horse Health & Performance" "Professional Development" "Long-Term Partnership Opportunity")}}
        <label class="flex items-center gap-2 text-sm text-al-ink/75"><input type="checkbox" name="whyAnimalife" value="{{this}}" class="accent-al-orange" />{{this}}</label>
        {{/each}}
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Product Interest</h2>
      <p class="mt-1 text-sm text-al-ink/60">Which Animalife products are you most interested in representing?</p>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
        {{#each (array "VetroFit™ – Performance & Oxygen Transport" "VetroFen™ – Inflammation & Comfort Support" "VetroFlex™ – Joint & Cartilage Support" "All Animalife Products")}}
        <label class="flex items-center gap-2 text-sm text-al-ink/75"><input type="checkbox" name="productInterest" value="{{this}}" class="accent-al-orange" />{{this}}</label>
        {{/each}}
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Marketing &amp; Promotion</h2>
      <p class="mt-1 text-sm text-al-ink/60">How do you intend to promote Animalife products?</p>
      <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
        {{#each (array "Direct Client Recommendations" "Social Media" "Email Marketing" "Clinics & Educational Events" "Veterinary Consultations" "Training Programs" "Retail Store Sales" "Podcast / Media Content" "Website or Blog")}}
        <label class="flex items-center gap-2 text-sm text-al-ink/75"><input type="checkbox" name="promotion" value="{{this}}" class="accent-al-orange" />{{this}}</label>
        {{/each}}
      </div>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Sales Goals</h2>
      <p class="mt-1 text-sm text-al-ink/60">How many new Animalife customers do you believe you could introduce during your first 12 months?</p>
      <select name="salesGoal" required class="input-field mt-4 sm:max-w-sm">
        <option value="1-10">1–10</option>
        <option value="11-25">11–25</option>
        <option value="26-50">26–50</option>
        <option value="51-100">51–100</option>
        <option value="101-250">101–250</option>
        <option value="250-plus">250+</option>
      </select>
    </div>

    <div>
      <h2 class="font-display text-xl font-medium text-al-navy">Personal Statement</h2>
      <p class="mt-1 text-sm text-al-ink/60">Please tell us why you would like to become an Animalife Affiliate Partner and how you believe Animalife products could benefit your clients, followers, or customers.</p>
      <textarea name="personalStatement" rows="5" required class="input-field mt-4"></textarea>
    </div>

    <div class="card p-6">
      <h2 class="font-display text-lg font-medium text-al-navy">Agreement</h2>
      <p class="mt-2 text-sm text-al-ink/65">By submitting, I certify that the information provided is accurate and complete to the best of my knowledge. I understand that submission does not guarantee acceptance into the Animalife Affiliate Partner Program, and if accepted, I agree to represent the Animalife brand professionally and ethically.</p>
      <label class="mt-4 flex items-center gap-2 text-sm font-semibold text-al-navy"><input type="checkbox" name="agree" required class="accent-al-orange" />I agree to the terms above</label>
    </div>

    <button type="submit" class="btn-primary w-full sm:w-auto">Submit Application</button>
  </form>
  {{/if}}
</section>
