{{> page-header eyebrow="Affiliate Portal" heading="Account Settings"}}

<section class="section grid gap-8 lg:grid-cols-[240px_1fr]">
  {{> affiliate-portal-sidebar}}

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="card p-6">
      <p class="font-display text-base font-medium text-al-navy">Payout Email</p>
      <p class="mt-1 text-sm text-al-ink/60">Where should we send your commission payouts?</p>
      <form action="/professionals/portal/settings/payout-email" method="post" class="mt-5 space-y-3">
        <input name="payoutEmail" type="email" value="{{affiliate.payoutEmail}}" placeholder="you@example.com" required class="input-field" />
        <button type="submit" class="btn-primary">Save Payout Email</button>
      </form>
    </div>

    <div class="card p-6">
      <p class="font-display text-base font-medium text-al-navy">Stripe Payouts</p>
      {{#unless stripeConfigured}}
      <p class="mt-1 text-sm text-al-ink/60">Automated payouts aren't available on this environment yet.</p>
      {{else}}
      {{#unless affiliate.stripeConnectAccountId}}
      <p class="mt-1 text-sm text-al-ink/60">Connect a Stripe account to get paid automatically instead of waiting on a manual payout.</p>
      <a href="/professionals/portal/connect/start" class="btn-primary mt-5 inline-block">Connect with Stripe</a>
      {{else}}
      {{#if connectStatus.payoutsEnabled}}
      <p class="mt-2 text-sm text-green-700">Connected &middot; ready to receive payouts.</p>
      {{else}}
      <p class="mt-2 text-sm text-yellow-700">Onboarding started but not finished yet.</p>
      <a href="/professionals/portal/connect/start" class="btn-outline mt-5 inline-block">Finish Onboarding</a>
      {{/if}}
      {{/unless}}
      {{/unless}}
    </div>

    <div class="card p-6">
      <p class="font-display text-base font-medium text-al-navy">Change Password</p>
      {{#if passwordUpdated}}
      <div class="mt-4 rounded-none bg-green-50 p-4 text-sm text-green-700">Password updated.</div>
      {{/if}}
      {{#if notice}}
      <div class="mt-4 rounded-none bg-red-50 p-4 text-sm text-red-700">{{notice}}</div>
      {{/if}}
      <form action="/professionals/portal/settings/password" method="post" class="mt-5 space-y-3">
        <div>
          <label class="field-label" for="currentPassword">Current Password</label>
          <input id="currentPassword" name="currentPassword" type="password" required class="input-field" />
        </div>
        <div>
          <label class="field-label" for="newPassword">New Password</label>
          <input id="newPassword" name="newPassword" type="password" minlength="8" required class="input-field" />
        </div>
        <button type="submit" class="btn-primary">Update Password</button>
      </form>
    </div>

    <div class="card p-6 sm:col-span-2">
      <p class="font-display text-base font-medium text-al-navy">Email Notifications</p>
      <form action="/professionals/portal/settings/email-preferences" method="post" class="mt-4 space-y-3">
        <label class="flex items-center gap-2 text-sm text-al-ink/75">
          <input type="checkbox" name="emailOnNewReferral" value="true" {{#if affiliate.emailOnNewReferral}}checked{{/if}} class="accent-al-navy" />
          Email me when I earn a new commission
        </label>
        <label class="flex items-center gap-2 text-sm text-al-ink/75">
          <input type="checkbox" name="emailOnPayout" value="true" {{#if affiliate.emailOnPayout}}checked{{/if}} class="accent-al-navy" />
          Email me when I get paid
        </label>
        <button type="submit" class="btn-outline">Save Preferences</button>
      </form>
    </div>
  </div>
</section>
