{{> page-header eyebrow="Affiliate Portal" heading="Marketing Resources" subheading="Everything you need to promote Animalife to your network."}}

<section class="section grid gap-8 lg:grid-cols-[240px_1fr]">
  {{> affiliate-portal-sidebar}}

  <div>
    <div class="card p-6">
      <p class="field-label">Your Personalized Shop Link</p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
        <input type="text" readonly value="{{shopLink}}" onclick="this.select()" class="input-field flex-1 text-sm" />
        <button type="button" onclick="navigator.clipboard.writeText('{{shopLink}}'); this.textContent='Copied!'" class="btn-outline !px-4 text-sm whitespace-nowrap">Copy Link</button>
      </div>
      <p class="mt-3 text-xs text-al-ink/55">Use this instead of your homepage link when promoting a specific product category &mdash; referrals are still credited to you.</p>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-lg font-medium text-al-navy">Campaign Links</h2>
      <p class="mt-1 max-w-2xl text-sm text-al-ink/60">Create a separate link for each place you promote &mdash; Instagram bio, email list, a specific product page &mdash; so you can see which one is actually driving referrals. All of them credit you the same as your main link.</p>

      <form action="/professionals/portal/links" method="post" class="card mt-4 flex flex-col gap-3 p-6 sm:flex-row sm:items-end">
        <div class="flex-1">
          <label class="field-label" for="linkName">Link Name</label>
          <input id="linkName" name="name" required placeholder="e.g. Instagram Bio" class="input-field" />
        </div>
        <div class="flex-1">
          <label class="field-label" for="destinationPath">Destination (optional)</label>
          <input id="destinationPath" name="destinationPath" placeholder="/shop/product/vetrofen" class="input-field" />
        </div>
        <button type="submit" class="btn-primary whitespace-nowrap">Create Link</button>
      </form>

      {{#if links.length}}
      <div class="card mt-4 divide-y divide-al-line overflow-hidden">
        {{#each links}}
        <div class="flex flex-wrap items-center justify-between gap-3 p-5">
          <div class="min-w-0 flex-1">
            <p class="font-display text-sm font-medium text-al-navy">{{this.name}} <span class="ml-2 text-xs font-normal text-al-ink/45">{{this.clickCount}} clicks</span></p>
            <p class="mt-1 truncate font-mono text-xs text-al-ink/55">{{this.fullUrl}}</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" onclick="navigator.clipboard.writeText('{{this.fullUrl}}'); this.textContent='Copied!'" class="btn-outline !px-3 !py-1.5 text-xs whitespace-nowrap">Copy</button>
            <form action="/professionals/portal/links/{{this._id}}/delete" method="post">
              <button type="submit" class="text-xs font-semibold uppercase tracking-wide text-red-600 hover:underline">Delete</button>
            </form>
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>

    <div class="mt-10">
      <h2 class="font-display text-lg font-medium text-al-navy">Logo Assets</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="card p-6">
          <img src="/images/brand/animalife-logo.png" alt="Animalife USA logo" class="h-12" />
          <a href="/images/brand/animalife-logo.png" download class="mt-4 block text-xs font-semibold uppercase tracking-wide text-al-navy hover:underline">Download (dark)</a>
        </div>
        <div class="card bg-al-navy p-6">
          <img src="/images/brand/animalife-logo-light.png" alt="Animalife USA logo, light" class="h-12" />
          <a href="/images/brand/animalife-logo-light.png" download class="mt-4 block text-xs font-semibold uppercase tracking-wide text-white hover:underline">Download (light)</a>
        </div>
      </div>
    </div>

    {{#if images.length}}
    <div class="mt-10">
      <h2 class="font-display text-lg font-medium text-al-navy">Product Images</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {{#each images}}
        <div class="card p-6 text-center">
          <img src="{{this.content}}" alt="{{this.title}}" class="mx-auto h-32 object-contain" />
          <p class="font-display mt-3 text-sm font-medium text-al-navy">{{this.title}}</p>
          <a href="{{this.content}}" download class="mt-1 block text-xs font-semibold uppercase tracking-wide text-al-navy/60 hover:underline">Download</a>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if copyBlocks.length}}
    <div class="mt-10">
      <h2 class="font-display text-lg font-medium text-al-navy">Sample Messaging</h2>
      <div class="mt-4 space-y-4">
        {{#each copyBlocks}}
        <div class="card p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">{{this.title}}</p>
          <p class="mt-2 text-sm text-al-ink/80">{{this.content}}</p>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>
</section>
