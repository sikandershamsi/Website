<h1 class="font-display text-2xl font-medium text-al-navy">Welcome back, {{affiliate.fullName}}</h1>
<p class="mt-1 text-sm text-al-ink/60">Here's how your referrals are performing.</p>

<div class="mt-6 rounded-none border border-al-line bg-white p-6">
  <p class="field-label">Your Referral Link</p>
  <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
    <input type="text" readonly value="{{referralLink}}" onclick="this.select()" class="input-field flex-1 text-sm" />
    <button type="button" onclick="navigator.clipboard.writeText('{{referralLink}}'); this.textContent='Copied!'" class="btn-outline !px-4 text-sm whitespace-nowrap">Copy Link</button>
  </div>
  <p class="mt-3 text-xs text-al-ink/55">Share this link &mdash; any purchase made after a visitor clicks it is automatically credited to you at your current commission rate of <span class="font-semibold text-al-navy">{{pct affiliate.commissionRate}}</span>.</p>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
  <div class="rounded-none border border-al-line bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Lifetime Commission</p>
    <p class="font-display mt-2 text-2xl font-medium text-al-navy">{{currency totals.lifetime}}</p>
  </div>
  <div class="rounded-none border border-al-line bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Pending Payout</p>
    <p class="font-display mt-2 text-2xl font-medium text-al-navy">{{currency totals.pending}}</p>
  </div>
  <div class="rounded-none border border-al-line bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Already Paid</p>
    <p class="font-display mt-2 text-2xl font-medium text-al-navy">{{currency totals.paid}}</p>
  </div>
  <div class="rounded-none border border-al-line bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Link Clicks</p>
    <p class="font-display mt-2 text-2xl font-medium text-al-navy">{{clickCount}}</p>
  </div>
  <div class="rounded-none border border-al-line bg-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Conversion Rate</p>
    <p class="font-display mt-2 text-2xl font-medium text-al-navy">{{#if conversionRate}}{{round conversionRate}}%{{else}}&mdash;{{/if}}</p>
  </div>
</div>

<div class="mt-8">
  <h2 class="font-display text-lg font-medium text-al-navy">Referred Orders</h2>
  <div class="mt-4 overflow-hidden rounded-none border border-al-line bg-white">
    {{#if orders.length}}
    <table class="w-full text-left text-sm">
      <thead class="bg-al-panel text-xs font-semibold uppercase tracking-wide text-al-ink/60">
        <tr>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Products</th>
          <th class="px-4 py-3">Order Total</th>
          <th class="px-4 py-3">Your Commission</th>
          <th class="px-4 py-3">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-al-line">
        {{#each orders}}
        <tr>
          <td class="px-4 py-3 font-semibold text-al-navy">{{this.orderNumber}}</td>
          <td class="px-4 py-3 text-al-ink/70">
            {{#each this.lines}}
            <div>{{this.name}} &times;{{this.qty}}{{#if this.isSubscription}} <span class="text-xs text-al-ink/45">(subscription)</span>{{/if}}</div>
            {{/each}}
          </td>
          <td class="px-4 py-3">{{currency this.subtotal}}</td>
          <td class="px-4 py-3">{{currency this.commissionAmount}}</td>
          <td class="px-4 py-3">
            {{#if (eq this.commissionStatus "paid")}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-green-100 text-green-700">Paid</span>
            {{else}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-al-panel text-al-ink/60">Pending</span>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="p-6 text-sm text-al-ink/60">No referred orders yet &mdash; share your link above to start earning.</p>
    {{/if}}
  </div>
</div>
