{{> page-header eyebrow="Affiliate Portal" heading=(or affiliate.fullName "Welcome Back") subheading="Here's how your referrals are performing."}}

<section class="section grid gap-8 lg:grid-cols-[240px_1fr]">
  {{> affiliate-portal-sidebar}}

  <div>
    <div class="card p-6">
      <p class="field-label">Your Referral Link</p>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
        <input type="text" id="referral-link-input" readonly value="{{referralLink}}" onclick="this.select()" class="input-field flex-1 text-sm" />
        <button type="button" data-copy-target="#referral-link-input" class="btn-outline copy-btn !px-4 text-sm whitespace-nowrap">Copy Link</button>
      </div>
      <p class="mt-3 text-xs text-al-ink/55">Share this link &mdash; any purchase made after a visitor clicks it is automatically credited to you at your current commission rate of <span class="font-semibold text-al-navy">{{pct affiliate.commissionRate}}</span>.</p>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {{#if affiliate.tieringEnabled}}
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Performance Tier</p>
        <p class="font-display mt-2 text-lg font-medium text-al-navy">{{currentTier.label}} &middot; {{pct currentTier.rate}}</p>
        {{#if upcomingTier}}<p class="mt-1 text-xs text-al-ink/55">{{currency upcomingTier.minLifetimeSales}} in lifetime sales unlocks {{upcomingTier.label}} ({{pct upcomingTier.rate}})</p>{{/if}}
      </div>
      {{/if}}
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Payout Progress</p>
        <p class="font-display mt-2 text-lg font-medium text-al-navy">{{currency totals.pending}} / {{currency minPayoutThreshold}}</p>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-none bg-al-panel">
          <div class="progress-fill h-full bg-al-navy" style="--target-width:{{thresholdProgressPct}}%"></div>
        </div>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Lifetime Commission</p>
        <p class="font-display mt-2 text-2xl font-medium text-al-navy" data-countup="{{totals.lifetime}}" data-countup-prefix="$" data-countup-decimals="2">$0.00</p>
      </div>
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Pending Payout</p>
        <p class="font-display mt-2 text-2xl font-medium text-al-navy" data-countup="{{totals.pending}}" data-countup-prefix="$" data-countup-decimals="2">$0.00</p>
      </div>
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Already Paid</p>
        <p class="font-display mt-2 text-2xl font-medium text-al-navy" data-countup="{{totals.paid}}" data-countup-prefix="$" data-countup-decimals="2">$0.00</p>
      </div>
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Link Clicks</p>
        <p class="font-display mt-2 text-2xl font-medium text-al-navy" data-countup="{{clickCount}}">0</p>
      </div>
      <div class="card p-5" data-reveal data-reveal-group="stats">
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Conversion Rate</p>
        {{#if conversionRate}}
        <p class="font-display mt-2 text-2xl font-medium text-al-navy" data-countup="{{round conversionRate}}" data-countup-suffix="%">0%</p>
        {{else}}
        <p class="font-display mt-2 text-2xl font-medium text-al-navy">&mdash;</p>
        {{/if}}
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <form method="get" class="flex items-center gap-2">
        <label class="text-xs font-semibold uppercase tracking-wide text-al-ink/50" for="days">Window</label>
        <select id="days" name="days" onchange="this.form.submit()" class="input-field !w-auto text-sm">
          <option value="30" {{#if (eq days 30)}}selected{{/if}}>Last 30 days</option>
          <option value="90" {{#if (eq days 90)}}selected{{/if}}>Last 90 days</option>
          <option value="180" {{#if (eq days 180)}}selected{{/if}}>Last 180 days</option>
          <option value="365" {{#if (eq days 365)}}selected{{/if}}>Last 12 months</option>
        </select>
      </form>
      <a href="/professionals/portal/statement.csv" class="text-xs font-semibold uppercase tracking-wide text-al-navy hover:underline">Download Statement &darr;</a>
    </div>

    <div class="mt-4 grid gap-6 lg:grid-cols-2">
      <div class="card p-6" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Commission Earned</p>
        <div class="mt-4" style="height:220px;"><canvas id="earningsChart"></canvas></div>
      </div>
      <div class="card p-6" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-wide text-al-ink/50">Clicks &amp; Conversion</p>
        <div class="mt-4" style="height:220px;"><canvas id="clicksChart"></canvas></div>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-lg font-medium text-al-navy">Referred Orders</h2>
      {{#if orders.length}}
      <div class="card mt-4 divide-y divide-al-line overflow-hidden">
        {{#each orders}}
        <div class="p-6" data-reveal data-reveal-group="orders">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="font-display text-base font-medium text-al-navy">Order #{{this.orderNumber}}</p>
            {{#if (eq this.commissionStatus "paid")}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-green-100 text-green-700">Paid</span>
            {{/if}}
            {{#if (eq this.commissionStatus "pending")}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-al-panel text-al-ink/60">Pending</span>
            {{/if}}
            {{#if (eq this.commissionStatus "rejected")}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-700">Not Eligible</span>
            {{/if}}
            {{#if (eq this.commissionStatus "reversed")}}
            <span class="inline-block rounded-none px-4 py-1.5 text-xs font-semibold uppercase tracking-wider bg-red-100 text-red-700">Reversed</span>
            {{/if}}
          </div>
          <div class="mt-4 space-y-2">
            {{#each this.lines}}
            <div class="flex justify-between text-sm text-al-ink/70">
              <span>{{this.name}} &times; {{this.qty}}{{#if this.isSubscription}} <span class="text-al-ink/45">(subscription)</span>{{/if}}</span>
              <span class="font-semibold text-al-navy">{{currency this.price}}</span>
            </div>
            {{/each}}
          </div>
          <div class="mt-3 flex justify-between border-t border-al-line pt-3 text-sm">
            <span class="font-semibold text-al-navy">Order Total: {{currency this.subtotal}}</span>
            <span class="font-semibold text-al-navy">Your Commission: {{currency this.commissionAmount}}</span>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="card mt-4 flex flex-col items-center px-8 py-16 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-none bg-al-navy/5 text-al-navy">{{{icon "check" "w-6 h-6"}}}</div>
        <p class="mt-5 max-w-sm text-sm text-al-ink/65">No referred orders yet &mdash; share your link above to start earning.</p>
      </div>
      {{/if}}
    </div>
  </div>
</section>

<script src="/js/vendor/chart.umd.min.js"></script> <!-- Chart.js 4.5.1, vendored from npm -->
<script>
  (function () {
    var commissionTrend = {{{json commissionTrend}}};
    var clickTrend = {{{json clickTrend}}};
    var navy = '#1a2b4c';
    var orange = '#e2711d';

    new Chart(document.getElementById('earningsChart'), {
      type: 'line',
      data: {
        labels: commissionTrend.map(function (r) { return r.date; }),
        datasets: [
          { label: 'Paid', data: commissionTrend.map(function (r) { return r.paid; }), borderColor: navy, backgroundColor: navy + '22', fill: true, tension: .3, pointRadius: 0 },
          { label: 'Pending', data: commissionTrend.map(function (r) { return r.pending; }), borderColor: orange, backgroundColor: orange + '22', fill: true, tension: .3, pointRadius: 0 }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } },
        scales: { y: { ticks: { callback: function (v) { return '$' + v; } } } }
      }
    });

    var clickByDate = {};
    clickTrend.forEach(function (r) { clickByDate[r.date] = r.clicks; });
    var labels = Object.keys(clickByDate).sort();
    new Chart(document.getElementById('clicksChart'), {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{ label: 'Clicks', data: labels.map(function (d) { return clickByDate[d]; }), backgroundColor: navy }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
  })();
</script>
