{{> page-header eyebrow="Professionals" heading="Affiliate Login" subheading="Access your dashboard to track referrals, orders, commissions, and payouts."}}

<section class="section flex justify-center">
  <div class="card w-full max-w-md p-8">
    {{#if notice}}
    <div class="mb-6 rounded-xl bg-al-orange/10 p-4 text-sm text-al-navy">{{notice}}</div>
    {{/if}}
    <form action="/professionals/login" method="post" class="space-y-5">
      <div>
        <label class="field-label" for="email">Email Address</label>
        <input id="email" name="email" type="email" required class="input-field" />
      </div>
      <div>
        <label class="field-label" for="password">Password</label>
        <input id="password" name="password" type="password" required class="input-field" />
      </div>
      <button type="submit" class="btn-primary w-full">Log In</button>
    </form>
    <p class="mt-6 text-center text-sm text-al-ink/60">Not an affiliate yet? <a href="/professionals/apply" class="font-semibold text-al-orange">Apply today</a></p>
  </div>
</section>
