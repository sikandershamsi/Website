{{> page-header eyebrow="My Account" heading=heading}}

<section class="section grid gap-8 lg:grid-cols-[240px_1fr]">
  {{> account-sidebar}}

  <div class="card flex flex-col items-center justify-center px-8 py-16 text-center">
    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-al-navy/5 text-al-navy">{{{icon "check" "w-6 h-6"}}}</div>
