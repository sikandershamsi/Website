<section class="hiq-hero">
  <img
    src="/images/horse-iq/hero.jpg?v=2"
    alt=""
    class="hiq-hero__media"
    width="2048"
    height="1024"
  />
  <div class="hiq-hero__veil" aria-hidden="true"></div>

  <div class="hiq-hero__content">
    <div class="hiq-hero__copy">
      <div class="hiq-hero__eyebrow-row">
        <span class="hiq-hero__rule" aria-hidden="true"></span>
        <p class="hiq-hero__eyebrow">Horse IQ</p>
      </div>
      <h1 class="hiq-hero__title">Knowledge that helps horses perform, recover, and thrive.</h1>
      <p class="hiq-hero__lede">
        Podcasts, videos, white papers, and infographics from the Animalife science team.
      </p>
    </div>

    <ul class="hiq-hero__features">
      <li class="hiq-hero__feature">
        <div class="hiq-hero__feature-icon">{{{icon "leaf" "w-5 h-5"}}}</div>
        <p class="hiq-hero__feature-label">Science-Backed Nutrition</p>
      </li>
      <li class="hiq-hero__feature">
        <div class="hiq-hero__feature-icon">{{{icon "shield-check" "w-5 h-5"}}}</div>
        <p class="hiq-hero__feature-label">Targeted Support</p>
      </li>
      <li class="hiq-hero__feature">
        <div class="hiq-hero__feature-icon">{{{icon "microscope" "w-5 h-5"}}}</div>
        <p class="hiq-hero__feature-label">Research Driven</p>
      </li>
      <li class="hiq-hero__feature">
        <div class="hiq-hero__feature-icon">{{{icon "horse" "w-5 h-5"}}}</div>
        <p class="hiq-hero__feature-label">Equine Focused</p>
      </li>
    </ul>
  </div>

  <div class="hiq-hero__wave" aria-hidden="true">
    <svg class="hiq-hero__wave-svg" viewBox="0 0 1440 120" preserveAspectRatio="none" focusable="false">
      <path fill="#1e3f33" d="M0,72 C360,18 720,18 1080,72 C1260,98 1380,110 1440,114 L1440,120 L0,120 Z"></path>
      <path fill="none" stroke="#c4a56a" stroke-width="2" d="M0,72 C360,18 720,18 1080,72 C1260,98 1380,110 1440,114"></path>
    </svg>
  </div>
</section>

<section class="section">
  {{#if query}}
  <p class="mb-6 text-sm text-al-ink/60">Showing results for &ldquo;{{query}}&rdquo; &mdash; <a href="/horse-iq" class="font-semibold text-al-navy/55">clear search</a></p>
  {{/if}}

  <div data-iq-filter class="flex flex-wrap gap-3">
    <button type="button" data-iq-filter-btn="all" class="filter-btn is-active">All</button>
    <button type="button" data-iq-filter-btn="podcast" class="filter-btn">Podcasts</button>
    <button type="button" data-iq-filter-btn="video" class="filter-btn">Videos</button>
    <button type="button" data-iq-filter-btn="white-paper" class="filter-btn">White Papers</button>
    <button type="button" data-iq-filter-btn="infographic" class="filter-btn">Infographics</button>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#each items}}
    <div data-iq-card="{{this.type}}" class="card p-6">
      <div class="flex h-11 w-11 items-center justify-center rounded-none bg-al-navy/10 text-al-navy/55">
        {{#ifCond this.type "podcast"}}{{{icon "mic" "w-5 h-5"}}}{{/ifCond}}
        {{#ifCond this.type "video"}}{{{icon "play" "w-5 h-5"}}}{{/ifCond}}
        {{#ifCond this.type "white-paper"}}{{{icon "file-text" "w-5 h-5"}}}{{/ifCond}}
        {{#ifCond this.type "infographic"}}{{{icon "image" "w-5 h-5"}}}{{/ifCond}}
      </div>
      <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-al-navy/55">{{this.meta}}</p>
      <p class="font-display mt-2 text-lg font-medium text-al-navy">{{this.title}}</p>
      <p class="mt-2 text-sm text-al-ink/65">{{this.description}}</p>
    </div>
    {{/each}}

    {{#if (eq items.length 0)}}
    <p class="text-sm text-al-ink/60">No results found. Try a different search term.</p>
    {{/if}}
  </div>
</section>
