{{> page-header eyebrow="Your Cart" heading="Cart"}}

<section class="section">
  {{#if isEmpty}}
  <div class="card flex flex-col items-center px-8 py-20 text-center">
    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-al-navy/5 text-al-navy">{{{icon "cart" "w-6 h-6"}}}</div>
    <p class="mt-5 text-sm text-al-ink/65">Your cart is empty.</p>
    <a href="/shop" class="btn-primary mt-6">Shop All Products</a>
  </div>
  {{else}}
  <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
    <div class="card divide-y divide-al-line overflow-hidden">
      {{#each lines}}
      <div class="flex flex-wrap items-center gap-4 p-6">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-al-cream-dark/50">
          <img src="{{this.image}}" alt="{{this.name}}" class="h-full w-full object-contain p-1" />
        </div>
        <div class="min-w-[160px] flex-1">
          <p class="font-display text-base font-medium text-al-navy">{{this.name}}</p>
          <p class="text-xs uppercase tracking-wide text-al-ink/50">{{this.size}}</p>
        </div>
        <form action="/cart/update" method="post" class="flex items-center gap-2">
          <input type="hidden" name="slug" value="{{this.slug}}" />
          <input type="number" name="qty" value="{{this.qty}}" min="0" class="input-field w-20 text-center" />
          <button type="submit" class="btn-outline !px-4 !py-2 text-xs">Update</button>
        </form>
        <p class="w-24 text-right font-display text-base font-medium text-al-navy">{{currency this.price}}</p>
        <form action="/cart/remove/{{this.slug}}" method="post">
          <button type="submit" aria-label="Remove" class="text-al-ink/40 hover:text-al-orange">{{{icon "close" "w-4 h-4"}}}</button>
        </form>
      </div>
      {{/each}}
    </div>

    <div class="card h-max p-6">
      <p class="font-display text-lg font-medium text-al-navy">Order Summary</p>
      <div class="mt-4 flex items-center justify-between text-sm text-al-ink/70">
        <span>Subtotal</span>
        <span class="font-display text-base font-medium text-al-navy">{{currency subtotal}}</span>
      </div>
      <p class="mt-1 text-xs text-al-ink/50">Shipping and taxes calculated at checkout.</p>
      <a href="/checkout" class="btn-primary mt-6 w-full">Proceed to Checkout</a>
      <a href="/shop" class="mt-3 block text-center text-xs font-semibold uppercase tracking-wide text-al-navy hover:text-al-orange">Continue Shopping</a>
    </div>
  </div>
  {{/if}}
</section>
