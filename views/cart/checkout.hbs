{{> page-header eyebrow="Checkout" heading="Checkout"}}

<section class="section">
  {{#if isEmpty}}
  <div class="card flex flex-col items-center px-8 py-20 text-center">
    <p class="text-sm text-al-ink/65">Your cart is empty.</p>
    <a href="/shop" class="btn-primary mt-6">Shop All Products</a>
  </div>
  {{else}}
  {{#if cancelled}}
  <div class="mb-8 rounded-none border border-al-line bg-al-panel p-4 text-sm text-al-ink/75">
    Checkout was cancelled &mdash; your cart is unchanged.
  </div>
  {{/if}}
  {{#if multipleSubscriptionsError}}
  <div class="mb-8 rounded-none border border-al-orange/40 bg-al-orange/10 p-4 text-sm text-al-ink/80">
    Only one subscription product can be checked out at a time. Please remove one before continuing, or check it out separately.
  </div>
  {{/if}}
  {{#unless paymentsConfigured}}
  <div class="mb-8 rounded-none border border-al-orange/40 bg-al-orange/10 p-4 text-sm text-al-ink/80">
    <span class="font-semibold">Online payment is coming soon.</span> We're finishing setup on our secure checkout &mdash; you won't be able to complete payment here just yet. Check back shortly, or contact us to place your order directly.
  </div>
  {{/unless}}
  <div class="grid gap-10 lg:grid-cols-[1fr_360px]">
    <div class="space-y-5">
      <h2 class="font-display text-lg font-medium text-al-navy">Review Your Order</h2>
      {{#each lines}}
      <div class="flex items-center gap-4 border-b border-al-line pb-5">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-none bg-al-panel">
          <img src="{{this.image}}" alt="{{this.name}}" class="h-full w-full object-contain p-1" />
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-display text-sm font-medium text-al-navy">{{this.name}}</p>
          <p class="text-xs text-al-ink/55">
            {{#if this.isSubscription}}Subscribe monthly{{else}}One-time purchase{{/if}} &times; {{this.qty}}
          </p>
        </div>
        <p class="text-sm font-semibold text-al-navy">{{currency this.price}}</p>
      </div>
      {{/each}}

      <div class="rounded-none border border-dashed border-al-line bg-al-cream-dark/30 p-5 text-sm text-al-ink/65">
        Payment and shipping details are collected securely on Stripe's checkout page &mdash; card details never touch our servers.
      </div>

      {{#if paymentsConfigured}}
      <form action="/checkout/start" method="post">
        <button type="submit" class="btn-primary w-full sm:w-auto">Continue to Payment</button>
      </form>
      {{else}}
      <button type="button" disabled class="btn-primary w-full cursor-not-allowed opacity-50 sm:w-auto">Payment Coming Soon</button>
      {{/if}}
    </div>

    <div class="card h-max p-6">
      <p class="font-display text-lg font-medium text-al-navy">Order Summary</p>
      <div class="mt-4 space-y-3">
        {{#each lines}}
        <div class="flex justify-between text-sm text-al-ink/70">
          <span>{{this.name}} &times; {{this.qty}}</span>
          <span class="font-semibold text-al-navy">{{currency this.price}}</span>
        </div>
        {{/each}}
      </div>
      <div class="mt-4 flex items-center justify-between border-t border-al-line pt-4 text-sm text-al-ink/70">
        <span>Subtotal</span>
        <span class="font-display text-base font-medium text-al-navy">{{currency subtotal}}</span>
      </div>
      <p class="mt-2 text-xs text-al-ink/50">Shipping and taxes calculated at the next step.</p>
    </div>
  </div>
  {{/if}}
</section>
